}

// One card of the 收藏推荐 masonry. `aspect` is the decoded cover's height over
// its width (0.5625 is 16:9). It is published for diagnostics only: the slot
// geometry is fixed (16:9 + 60px), so the skeleton and the real card cannot
// disagree and the grid never reflows.
export struct MasonryCard {
    bvid: string,
    title: string,
    owner: string,
    duration: string,
    cover: image,
    aspect: float,
}

export struct PlayerFavRow {
