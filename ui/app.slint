}

// One 楼中楼 row. Slint rejects a struct that references its own model type
// recursively ("Unknown type 'CommentRow'" inside its own definition), so the
// reply shape is its own flat struct rather than `[CommentRow]` nested in
// `CommentRow`; the fields the row renders are identical.
export struct CommentReply {
    rpid: int,
    uname: string,
    message: string,
    like_text: string,
    time_text: string,
    initial: string,
    has_avatar: bool,
    avatar: image,
}

// One comment thread in the player's 评论区 (left sidebar). `replies` carries
// the 楼中楼 rows while `expanded` is true. `initial` is the avatar placeholder
// glyph Rust derives from the user name, so a row never waits on its picture to
// read.
//
// `expanded` is published by Rust (the source of truth), so the chip reads
// ▸ N 条回复 while closed and ▾ 收起回复 while open, and stays right across a
// republish. `rpid` is Rust-internal (it drives avatar patches and the head
// check); the UI identifies a row by its INDEX and never sends this id back -
// see the `comment_toggle` / `comment_replies` contract below.
export struct CommentRow {
    rpid: int,
    uname: string,
    message: string,
    like_text: string,
    time_text: string,
    replies_text: string,
    initial: string,
    has_avatar: bool,
    avatar: image,
    expanded: bool,
    // 1-based page the 查看更多回复 link asks for (0 when there is none).
    next_pn: int,
    has_more: bool,
    replies: [CommentReply],
}

export component MiniPlayerWindow inherits Window {
    default-font-family: "Chill Round Gothic";
    default-font-size: 14px;
    // Frameless (WS_CAPTION cleared / WS_THICKFRAME kept) enforced from Rust.
    // 0px disables Slint's modal border resize; `ResizeFrame` does the rim.
    no-frame: true;
    resize-border-width: 0px;
    // `preferred-*` rather than `width`/`height`: an explicit size is compiled
    // into a fixed-width constant that keeps reporting 320x200 after a native
    // resize, so the app-driven rim could never actually grow the picture.
    preferred-width: 320px;
    preferred-height: 200px;
    min-width: 320px;
    min-height: 200px;
    max-width: 100000px;
    max-height: 100000px;
    background: AppTheme.player-bg;

    in property <image> frame;
    in-out property <string> video_title: "小窗";
    in-out property <bool> playing: true;

    // ---- backdrop (same contract as the other two windows) ------------------
    // The generated wallpaper TILE; the layer below repeats it under the whole
    // client area, anchored to the window's screen position.
    in property <image> wallpaper;
    in property <bool> wallpaper_valid: false;

    callback mini_toggle_pause();
    callback mini_close();
    callback mini_minimize();
    callback window_drag_start();
    callback window_drag_move();
    callback window_drag_end();
    callback resize_start(int);
    callback resize_move();
    callback resize_end();

    title: root.video_title;
    icon: @image-url("../assets/icons/o11a1.png");

    if wallpaper_valid : WallpaperLayer {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: root.wallpaper;
    }
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: AppTheme.player-glass;
    }

    Rectangle {
        background: #00000000;

        Image {
            source: root.frame;
            width: 100%;
            height: 100%;
            image-fit: contain;
        }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 30px;
        background: AppTheme.video-overlay-bg;

        // Frameless drag region; leaves 60px for the min/close buttons.
        TouchArea {
            x: 0;
            y: 0;
            width: max(0px, parent.width - 60px);
            height: parent.height;

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    if (event.button != PointerEventButton.left) {
                        return EventResult.reject;
                    }
                    root.window_drag_start();
                    EventResult.accept
                } else if (event.kind == PointerEventKind.move) {
                    root.window_drag_move();
                    EventResult.accept
                } else {
                    root.window_drag_end();
                    EventResult.accept
                }
            }
        }

        Text {
            x: 8px;
            y: 0;
            width: max(0px, parent.width - 68px);
            height: parent.height;
            text: root.video_title;
            color: AppTheme.player-text;
            font-size: 12px;
            vertical-alignment: center;
        }

        Rectangle {
            x: parent.width - 60px;
            y: 0;
            width: 30px;
            height: parent.height;
            background: mini_min_area.has-hover ? AppTheme.card-hover : #00000000;
            // Drawn mark, not the "—" glyph: the em dash is missing from the
            // bundled UI font and rendered as an invisible tofu box.
            Rectangle {
                x: (parent.width - 10px) / 2;
                y: (parent.height - 1.5px) / 2;
                width: 10px;
                height: 1.5px;
                background: AppTheme.player-fg-strong;
            }
            mini_min_area := TouchArea { clicked => { root.mini_minimize(); } }
        }

        Rectangle {
            x: parent.width - 30px;
            y: 0;
            width: 30px;
            height: parent.height;
            background: mini_x_area.has-hover ? AppTheme.danger : #00000000;
            // Drawn cross, not the "✕" glyph (see WinControl).
            Path {
                x: (parent.width - 10px) / 2;
                y: (parent.height - 10px) / 2;
                width: 10px;
                height: 10px;
                viewbox-width: 12;
                viewbox-height: 12;
                commands: "M 0.75 0.75 L 11.25 11.25 M 11.25 0.75 L 0.75 11.25";
                fill: #00000000;
                stroke: AppTheme.player-fg-strong;
                stroke-width: 1.5px;
                stroke-line-cap: round;
            }
            mini_x_area := TouchArea { clicked => { root.mini_close(); } }
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - 34px;
        width: parent.width;
        height: 34px;
        background: AppTheme.player-bar;

        Rectangle {
            x: 8px;
            y: (parent.height - 26px) / 2;
            width: 64px;
            height: 26px;
            border-radius: 5px;
            background: mini_play.has-hover ? AppTheme.accent-hover : AppTheme.accent;
            Text {
                text: root.playing ? "暂停" : "播放";
                color: AppTheme.accent-fg;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            mini_play := TouchArea { clicked => { root.mini_toggle_pause(); } }
        }

        Rectangle {
            x: parent.width - 8px - 56px;
            y: (parent.height - 26px) / 2;
            width: 56px;
            height: 26px;
            border-radius: 5px;
            background: mini_close_btn.has-hover ? AppTheme.player-btn-hover : AppTheme.player-btn;
            Text {
                text: "关闭";
                color: AppTheme.player-text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            mini_close_btn := TouchArea { clicked => { root.mini_close(); } }
        }
    }

    // App-driven resize rim (see ResizeFrame): last, so the outer 8px wins
    // over the title strip and the two bottom buttons, and nothing further in.
    ResizeFrame {
        resize-start(edge) => { root.resize_start(edge); }
        resize-move => { root.resize_move(); }
        resize-end => { root.resize_end(); }
    }
}

// ---------------------------------------------------------------------------
// Player chrome primitives.
//
// The player is a dark, theme-invariant surface (AppTheme.player-* / video-*),
// so none of this follows the light/dark switch - a video player's chrome is
// dark in both schemes.
//
// Every mark is a drawn shape, never a font glyph: the Unicode box marks
// (- / square / x) are not in the bundled UI font and rendered as invisible
// tofu - exactly the bug the WinControl comment above documents for the main
// window's caption buttons. The geometry here mirrors WinControl, scaled by a
// single `mark-size` knob so the same component serves the player title bar,
// the mini window and the login cluster.
// ---------------------------------------------------------------------------
// PanelHit: the click target used inside 侧栏 panels. It is a plain TouchArea
// plus the panel's own right-click dismiss, so a right-click anywhere a panel
// reacts to (headers, rows, chips, empty scroll space) closes that panel.
// `dismiss()` is a no-op unless the instance wires it, so the primitive can be
// reused anywhere without side effects.
//
// A TouchArea grabs every press, so a right button would otherwise be swallowed
// by whichever row happens to be under the pointer - that is why the handler
// lives on the row primitive instead of on the panel background alone. Wheel
// events are accepted (and ignored) here: a panel owns its scrolling and must
// never leak a wheel into the video's volume handler underneath.
// ---------------------------------------------------------------------------
component PanelHit inherits TouchArea {
    callback dismiss();
    // Rows inside a scroll container (the comment ListView) must hand the wheel
    // to the scroller; the panel rows that float over the picture keep eating it
    // so a wheel there never changes the volume. Default: eat (old behaviour).
    in property <bool> pass-scroll: false;

    pointer-event(event) => {
        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
            self.dismiss();
            return EventResult.accept;
        }
        EventResult.reject
    }

    scroll-event(event) => { root.pass_scroll ? EventResult.reject : EventResult.accept }
}

// ---------------------------------------------------------------------------
component MarkButton inherits Rectangle {
    in property <int> kind: 0; // 0 minimise, 1 maximise, 2 close
    in property <bool> restore: false; // maximise shows the restore mark
    in property <color> mark: AppTheme.text;
    // Resting fill; transparent by default so the panel/list close buttons stay
    // bare. The player's floating top-right cluster passes video-overlay-bg.
    in property <color> base: #00000000;
    in property <color> hover-bg: AppTheme.card-hover;
    in property <color> close-hover-bg: AppTheme.win-close;
    in property <length> mark-size: 12px;
    in property <length> corner: 5px;
    in property <bool> interactive: true;
    callback clicked();

    border-radius: root.corner;
    background: area.has-hover
        ? (root.kind == 2 ? root.close-hover-bg : root.hover-bg)
        : root.base;
    animate background { duration: 120ms; easing: ease-out; }

    // Close hovers to white on the red fill; every other mark keeps its colour.
    property <color> ink: (root.kind == 2 && area.has-hover) ? #ffffff : root.mark;

    // minimise: one bar
    if root.kind == 0 : Rectangle {
        x: (parent.width - (root.mark-size - 1px)) / 2;
        y: (parent.height - 1.5px) / 2;
        width: root.mark-size - 1px;
        height: 1.5px;
        background: root.ink;
    }

    // maximise: square outline
    if root.kind == 1 && !root.restore : Rectangle {
        x: (parent.width - (root.mark-size - 2px)) / 2;
        y: (parent.height - (root.mark-size - 2px)) / 2;
        width: root.mark-size - 2px;
        height: root.mark-size - 2px;
        background: #00000000;
        border-width: 1.5px;
        border-color: root.ink;
    }

    // restore (maximised): the classic two-square mark
    if root.kind == 1 && root.restore : Path {
        x: (parent.width - root.mark-size) / 2;
        y: (parent.height - root.mark-size) / 2;
        width: root.mark-size;
        height: root.mark-size;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 0.75 3.5 L 8.5 3.5 L 8.5 11.25 L 0.75 11.25 Z M 3.5 0.75 L 11.25 0.75 L 11.25 8.5";
        fill: #00000000;
        stroke: root.ink;
        stroke-width: 1.5px;
    }

    // close: two crossed lines
    if root.kind == 2 : Path {
        x: (parent.width - root.mark-size) / 2;
        y: (parent.height - root.mark-size) / 2;
        width: root.mark-size;
        height: root.mark-size;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 0.75 0.75 L 11.25 11.25 M 11.25 0.75 L 0.75 11.25";
        fill: #00000000;
        stroke: root.ink;
        stroke-width: 1.5px;
        stroke-line-cap: round;
    }

    area := TouchArea {
        enabled: root.interactive;
        clicked => { root.clicked(); }
    }
}

// A labelled player-chrome button (title bar and primary control bar). The
// colours are parameters because the same shape serves the title bar (over the
// dark bar, video-overlay fills) and the control bar (player-btn fills).
component PlayerBtn inherits Rectangle {
    in property <string> text: "";
    in property <color> base: AppTheme.player-btn;
    in property <color> hover: AppTheme.player-btn-hover;
    in property <color> active-bg: AppTheme.accent;
    in property <color> text-color: AppTheme.player-text;
    in property <bool> active: false;
    in property <bool> interactive: true;
    in property <length> corner: 5px;
    callback clicked();

    height: 26px;
    border-radius: root.corner;
    background: root.active ? root.active-bg : (area.has-hover ? root.hover : root.base);
    animate background { duration: 120ms; easing: ease-out; }

    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: root.text-color;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    area := TouchArea {
        enabled: root.interactive;
        clicked => { root.clicked(); }
    }
}

// 二级 panel: one section heading.
component PanelSection inherits Rectangle {
    in property <string> text: "";

    height: 32px;

    Rectangle {
        y: 6px;
        width: 100%;
        height: 1px;
        background: AppTheme.player-menu-border;
        opacity: 0.55;
    }

    Text {
        x: 10px;
        y: 7px;
        width: max(0px, parent.width - 20px);
        height: parent.height - 7px;
        text: root.text;
        color: AppTheme.player-text-dim;
        font-size: 11px;
        font-weight: 700;
        vertical-alignment: center;
    }
}

// 二级 panel: one row - label left, current value right, and a drawn chevron
// when the row expands into a sub-list (the chevron turns down while expanded).
component PanelRow inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <bool> expandable: false;
    in property <bool> expanded: false;
    in property <bool> accent: false;
    in property <bool> danger: false;
    callback clicked();
    // Right-click on the row: the host panel closes itself. No-op by default.
    callback dismiss();

    height: 40px;
    border-radius: 6px;
    background: area.has-hover ? AppTheme.player-menu-hover : #00000000;
    animate background { duration: 120ms; easing: ease-out; }

    Text {
        x: 10px;
        width: max(0px, parent.width - 20px - 88px - (root.expandable ? 16px : 0px));
        height: parent.height;
        text: root.label;
        color: root.danger ? AppTheme.player-danger-text : AppTheme.player-text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - 10px - 88px - (root.expandable ? 16px : 0px);
        width: 88px;
        height: parent.height;
        text: root.value;
        color: root.danger
            ? AppTheme.player-danger-text
            : (root.accent ? AppTheme.player-fg-strong : AppTheme.player-text-dim);
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    // Chevron: a right-pointing stroke that rotates down while expanded.
    Path {
        x: parent.width - 18px;
        y: (parent.height - 10px) / 2;
        width: 8px;
        height: 10px;
        viewbox-width: 8;
        viewbox-height: 10;
        commands: "M 2 1.5 L 5.5 5 L 2 8.5";
        fill: #00000000;
        stroke: AppTheme.player-text-dim;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        visible: root.expandable;
        transform-rotation: root.expanded ? 90deg : 0deg;
        transform-origin: { x: 4px, y: 5px };
        animate transform-rotation { duration: 160ms; easing: ease-out; }
    }

    area := PanelHit {
        // The row lives inside the right strip's ScrollView: hand a rejected
        // wheel to the scroller instead of eating it (the old accept made every
        // settings row a wheel dead zone).
        pass-scroll: true;
        clicked => { root.clicked(); }
        dismiss => { root.dismiss(); }
    }
}

// 二级 panel: a 0..1 slider. The track grows on hover and the thumb fades in;
// `live` fires while dragging, `commit` on release (the moment the Rust side
// wants to persist a setting).
component PanelSlider inherits Rectangle {
    in property <float> value: 0;
    in property <color> fill: AppTheme.accent;
    // Gates the internal TouchArea (the 一级 bar's volume slider fades with the
    // rest of the chrome in fullscreen; the 二级 panel sliders stay live).
    in property <bool> interactive: true;
    callback live(float);
    callback commit(float);
    // Right-click on the slider: the host panel closes. No-op by default.
    callback dismiss();
    // Mirrors the area's hover so a host popover can keep itself open while the
    // pointer is on the slider (a sibling TouchArea stops seeing hover once the
    // slider's own area owns it).
    out property <bool> hot: area.has-hover;

    height: 26px;
    background: #00000000;

    track := Rectangle {
        x: 4px;
        width: max(0px, parent.width - 8px);
        height: area.has-hover || area.pressed ? 6px : 4px;
        y: (parent.height - self.height) / 2;
        border-radius: self.height / 2;
        background: AppTheme.player-track;
        animate height { duration: 120ms; easing: ease-out; }
    }

    Rectangle {
        x: track.x;
        y: track.y;
        height: track.height;
        border-radius: track.border-radius;
        background: root.fill;
        width: track.width * clamp(root.value, 0, 1);
    }

    Rectangle {
        x: track.x + track.width * clamp(root.value, 0, 1) - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 11px;
        height: 11px;
        border-radius: 5.5px;
        background: AppTheme.player-knob;
        opacity: area.has-hover || area.pressed ? 1 : 0;
        animate opacity { duration: 120ms; easing: ease-out; }
    }

    area := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.interactive;
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.dismiss();
                return EventResult.accept;
            }
            // Move events carry `button: Other` (only the press/release name a
            // button), so the old left-only gate rejected EVERY drag move and
            // turned this slider into click-to-jump. Moves are gated by
            // `self.pressed` in their own branch instead.
            if (event.kind != PointerEventKind.move && event.button != PointerEventButton.left) {
                return EventResult.reject;
            }
            if (event.kind == PointerEventKind.down) {
                root.live(clamp((self.mouse-x - 4px) / max(1px, self.width - 8px), 0, 1));
                EventResult.accept
            } else if (event.kind == PointerEventKind.move) {
                if (self.pressed) {
                    root.live(clamp((self.mouse-x - 4px) / max(1px, self.width - 8px), 0, 1));
                }
                EventResult.accept
            } else if (event.kind == PointerEventKind.up) {
                root.commit(clamp((self.mouse-x - 4px) / max(1px, self.width - 8px), 0, 1));
                EventResult.accept
            } else {
                EventResult.accept
            }
        }
    }
}

// 药丸控制表  one drawn icon button (音量 / 弹幕 / 评论 / 性能 / 设置). The
// bundled font carries no emoji, so each mark is a Path or a pair of Rectangles,
// exactly like the ▭ and speech-bubble marks the old pill used. `kind` picks the
// mark; `active` is a state (panel open, danmaku off, muted), not a hover.
component PillIcon inherits Rectangle {
    // 0 音量 · 1 已静音 · 2 弹幕开 · 3 弹幕关 · 4 评论 · 5 性能 · 6 设置
    in property <int> kind: 4;
    in property <bool> active: false;
    in property <bool> interactive: true;
    // Optical nudge for a mark whose STROKE bbox is not centred in its 16px
    // viewbox (the speaker: body 2.4..8.4, waves to 14.9). Only the volume
    // mark uses it; every other glyph is already symmetric.
    in property <length> mark-dx: 0px;
    // Mirrors the button's own hover so the pill (which owns the popover
    // timers) can see it: an inserted child area cannot be referenced from the
    // instantiating component, a mirrored property can.
    out property <bool> hot: area.has-hover;
    callback clicked();

    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: root.active
        ? AppTheme.player-selected
        : (area.has-hover ? AppTheme.player-btn-hover : AppTheme.player-btn);
    animate background { duration: 120ms; easing: ease-out; }

    property <color> ink: root.active ? AppTheme.player-fg-strong : AppTheme.player-text;

    // ---- 音量: speaker body, plus two arcs (or a cross when muted) ----
    if root.kind == 0 || root.kind == 1 : Path {
        x: (parent.width - 16px) / 2 + root.mark-dx;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 2.4 6.2 L 5.2 6.2 L 8.4 3.2 L 8.4 12.8 L 5.2 9.8 L 2.4 9.8 Z";
        fill: #00000000;
        stroke: root.ink;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    if root.kind == 0 : Path {
        x: (parent.width - 16px) / 2 + root.mark-dx;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 10.4 5.9 C 11.6 6.8 11.6 9.2 10.4 10.1 M 12.6 3.6 C 14.9 5.4 14.9 10.6 12.6 12.4";
        fill: #00000000;
        stroke: root.ink;
        stroke-width: 1.4px;
        stroke-line-cap: round;
    }
    if root.kind == 1 : Path {
        x: (parent.width - 16px) / 2 + root.mark-dx;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 10.6 6 L 14 9.4 M 14 6 L 10.6 9.4";
        fill: #00000000;
        stroke: root.ink;
        stroke-width: 1.4px;
        stroke-line-cap: round;
    }

    // ---- 弹幕: three travelling dashes; the slash marks the off state ----
    if root.kind == 2 || root.kind == 3 : Path {
        x: (parent.width - 16px) / 2;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 2 4.4 L 10.6 4.4 M 5.4 8 L 14 8 M 2.4 11.6 L 9.4 11.6";
        fill: #00000000;
        stroke: root.ink;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        opacity: root.kind == 3 ? 0.4 : 1;
    }
    if root.kind == 3 : Path {
        x: (parent.width - 16px) / 2;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 2.6 13 L 13.4 3";
        fill: #00000000;
        stroke: AppTheme.player-danger-soft;
        stroke-width: 1.5px;
        stroke-line-cap: round;
    }

    // ---- 评论: speech bubble ----
    if root.kind == 4 : Path {
        x: (parent.width - 15px) / 2;
        y: (parent.height - 13px) / 2;
        width: 15px;
        height: 13px;
        viewbox-width: 15;
        viewbox-height: 13;
        commands: "M 2.5 0.75 L 12.5 0.75 C 13.9 0.75 15 1.85 15 3.25 L 15 7.75 C 15 9.15 13.9 10.25 12.5 10.25 L 6 10.25 L 3.2 12.6 L 3.2 10.25 L 2.5 10.25 C 1.1 10.25 0 9.15 0 7.75 L 0 3.25 C 0 1.85 1.1 0.75 2.5 0.75 Z";
        fill: #00000000;
        stroke: root.ink;
        stroke-width: 1.3px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    // ---- 性能: three rising bars on a baseline ----
    if root.kind == 5 : Path {
        x: (parent.width - 16px) / 2;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 1.8 13.6 L 14.2 13.6 M 4.4 13.6 L 4.4 9.2 M 8 13.6 L 8 6.2 M 11.6 13.6 L 11.6 3.2";
        fill: #00000000;
        stroke: root.ink;
        stroke-width: 1.6px;
        stroke-line-cap: round;
    }

    // ---- 设置: the ▤ sidebar mark ----
    if root.kind == 6 : Rectangle {
        x: (parent.width - 13px) / 2;
        y: (parent.height - 10px) / 2;
        width: 13px;
        height: 10px;
        background: #00000000;
        border-width: 1.4px;
        border-color: root.ink;
    }
    if root.kind == 6 : Rectangle {
        x: (parent.width + 13px) / 2 - 4px;
        y: (parent.height - 10px) / 2 + 2px;
        width: 2.5px;
        height: 5.5px;
        background: root.ink;
    }

    area := TouchArea {
        // 40px hit target around the 38px chip (1px overhang on each side), so
        // the bigger pill is easy to hit without growing the visible button.
        x: -1px;
        y: -1px;
        width: parent.width + 2px;
        height: parent.height + 2px;
        enabled: root.interactive;
        clicked => { root.clicked(); }
        // A wheel over a pill button is not the pill's background: keep it
        // away from the picture's volume handler.
        scroll-event(event) => { EventResult.accept }
    }
}

// 药丸平滑: the frame-interpolation cell. It reuses PillIcon's chip language
// (38x38 plate, 10px radius, same hover wash) but is its own component because
// it carries STATE in a badge, not an on/off highlight:
//
//   level 0 关闭   - a dim 4px dot
//   level 1 混合   - the same dot in `accent` at 60 %
//   level 2 块匹配 - solid accent dot plus a 3px four-ray glint on the axes (+)
//   level 3 OFA    - solid accent dot plus a 6.2px two-ray glint on the
//                    diagonals: the same sparkle turned 45°, so the hardware
//                    path differs in shape, not only in tint, from the CPU one
//
// The glyph is three nested right chevrons (frames advancing), drawn as one
// stroked Path - deliberately unlike the danmaku dashes, the 网络 bars or the
// play triangle, none of which has a chevron.
component InterpIcon inherits Rectangle {
    in property <int> level: 0;
    in property <bool> interactive: true;
    out property <bool> hot: area.has-hover;
    callback clicked();

    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: area.has-hover ? AppTheme.player-btn-hover : AppTheme.player-btn;
    animate background { duration: 120ms; easing: ease-out; }

    Path {
        x: (parent.width - 16px) / 2;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 1.8 3.4 L 6.2 8 L 1.8 12.6 M 5.8 3.4 L 10.2 8 L 5.8 12.6 M 9.8 3.4 L 14.2 8 L 9.8 12.6";
        fill: #00000000;
        stroke: AppTheme.player-text;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    // State dot, top-right of the chip: dim while off, accent at 60 % for the
    // blend mode, solid accent for both optical-flow modes (块匹配 on the CPU,
    // OFA on the N-card engine); the glint below tells those two apart.
    Rectangle {
        x: 26.5px;
        y: 6.5px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: root.level == 0 ? AppTheme.player-text-dim : AppTheme.accent;
        opacity: root.level == 1 ? 0.6 : 1;
        animate opacity { duration: 160ms; easing: ease-out; }
        animate background { duration: 160ms; easing: ease-out; }
    }

    // Level-2 glint (块匹配, CPU): a 3px four-ray spark up-right of the dot (a
    // stroked plus, crisper at 16px than a filled star). Orthogonal rays.
    if root.level == 2 : Path {
        x: 32.5px;
        y: 4.5px;
        width: 3px;
        height: 3px;
        viewbox-width: 3;
        viewbox-height: 3;
        commands: "M 1.5 0 L 1.5 3 M 0 1.5 L 3 1.5";
        fill: #00000000;
        stroke: AppTheme.accent;
        stroke-width: 0.9px;
        stroke-line-cap: round;
    }

    // Level-3 glint (OFA, hardware): two rays on the diagonals (45° / 135°), a
    // 6.2px sparkle in the same corner. It is the level-2 mark turned 45° - a
    // different angle AND fewer rays - so 块匹配 and OFA never read as the same
    // badge, even at 38px and without colour differences. The diagonal needs
    // the extra size to survive the 1px pixel grid at 100% DPI: a 3px x would
    // blur into a dot, while a 3px + still reads as a plus.
    if root.level == 3 : Path {
        x: 30.8px;
        y: 2.4px;
        width: 6.2px;
        height: 6.2px;
        viewbox-width: 6.2;
        viewbox-height: 6.2;
        commands: "M 1 1 L 5.2 5.2 M 5.2 1 L 1 5.2";
        fill: #00000000;
        stroke: AppTheme.accent;
        stroke-width: 1px;
        stroke-line-cap: round;
    }

    area := TouchArea {
        x: -1px;
        y: -1px;
        width: parent.width + 2px;
        height: parent.height + 2px;
        enabled: root.interactive;
        clicked => { root.clicked(); }
        // A wheel over a pill button is not the pill's background.
        scroll-event(event) => { EventResult.accept }
    }
}

// 性能: one stat row - label left, value right in a fixed column, so every
// number lines up like an instrument readout (no mono font needed: the bundle
// only ships Noto Sans SC). `clickable` turns the row into a control: a hover
// wash, a pointer cursor and a small chevron after the value (the 平滑 模式 row
// is the one such row - it cycles the mode). The chevron takes 11px out of the
// value column on that row only, so every other value stays flush right.
component NetStat inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <bool> strong: false;
    in property <bool> clickable: false;
    callback clicked();

    height: 24px;
    border-radius: 4px;
    background: root.clickable && area.has-hover
        ? AppTheme.player-menu-hover
        : #00000000;
    animate background { duration: 120ms; easing: ease-out; }

    Text {
        x: 0;
        width: 104px;
        height: 100%;
        text: root.label;
        color: AppTheme.player-text-dim;
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 104px;
        width: max(0px, parent.width - 104px - (root.clickable ? 11px : 0px));
        height: 100%;
        text: root.value;
        color: root.strong ? AppTheme.player-fg-strong : AppTheme.player-text;
        font-size: 11px;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    // The row's affordance: a 6x10 right chevron at the far right, in the same
    // stroke language as PanelRow. It brightens with the row's hover.
    if root.clickable : Path {
        x: parent.width - 7px;
        y: (parent.height - 10px) / 2;
        width: 6px;
        height: 10px;
        viewbox-width: 6;
        viewbox-height: 10;
        commands: "M 1.4 1.5 L 4.6 5 L 1.4 8.5";
        fill: #00000000;
        stroke: area.has-hover ? AppTheme.player-fg-strong : AppTheme.player-text-dim;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
        animate stroke { duration: 120ms; easing: ease-out; }
    }

    area := TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// 性能: one prefetch connection - busy dot, host left, claimed range
// centred, running byte total right. The three columns are fixed fractions of
// the row, so the rows read as one aligned table.
component NetWorkerRow inherits Rectangle {
    in property <string> host: "";
    in property <string> range: "";
    in property <string> bytes: "";
    in property <bool> busy: false;

    height: 18px;

    Rectangle {
        x: 0;
        y: (parent.height - 5px) / 2;
        width: 5px;
        height: 5px;
        border-radius: 2.5px;
        background: root.busy ? AppTheme.player-progress : AppTheme.player-track;
    }

    Text {
        x: 11px;
        width: max(0px, parent.width * 0.42 - 11px);
        height: 100%;
        text: root.host;
        color: root.busy ? AppTheme.player-text : AppTheme.player-text-dim;
        font-size: 10.5px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width * 0.42;
        width: max(0px, parent.width * 0.34);
        height: 100%;
        text: root.range;
        color: AppTheme.player-text-dim;
        font-size: 10.5px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width * 0.76;
        width: max(0px, parent.width * 0.24);
        height: 100%;
        text: root.bytes;
        color: AppTheme.player-text;
        font-size: 10.5px;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
}

// 性能: one entry of the 下载分布 legend - a 5px chip in the state's own
// colour (same tint/alpha as the strip cell) and its name.
component NetLegend inherits Rectangle {
    in property <string> label: "";
    in property <color> tint: AppTheme.player-track;
    in property <float> alpha: 1;

    horizontal-stretch: 1;
    height: 16px;
    background: #00000000;

    Rectangle {
        x: 0;
        y: (parent.height - 5px) / 2;
        width: 5px;
        height: 5px;
        border-radius: 1.5px;
        background: root.tint;
        opacity: root.alpha;
    }

    Text {
        x: 9px;
        width: max(0px, parent.width - 9px);
        height: 100%;
        text: root.label;
        color: AppTheme.player-text-dim;
        font-size: 9.5px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// ---------------------------------------------------------------------------
// 提示条 (toast). A 36px pill: a 16px drawn mark (never a glyph) inside a 24px
// tinted circle on the left, one 13px line, and a 3px progress hairline along
// the bottom edge. The surface is the same `player-menu` plate + hairline
// family as the popovers, so a toast reads as chrome rather than as a
// notification from another app.
//
// Entrance: 180ms, translate-y -8px -> 0 (slides DOWN into place) + fade in.
// Exit: 200ms, the reverse. The stack keeps a fixed 3 slots, so losing a toast
// is a state change on a live node and can animate - a model removal would
// destroy the node instead.
// ---------------------------------------------------------------------------
component ToastIcon inherits Rectangle {
    // 0 info · 1 success · 2 error
    in property <int> kind: 0;
    in property <color> tint: AppTheme.accent;

    width: 16px;
    height: 16px;
    background: #00000000;

    // info: ring + dot + stem
    if root.kind == 0 : Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 8 1.6 A 6.4 6.4 0 0 1 8 14.4 A 6.4 6.4 0 0 1 8 1.6";
        fill: #00000000;
        stroke: root.tint;
        stroke-width: 1.4px;
        stroke-line-cap: round;
    }
    if root.kind == 0 : Rectangle {
        x: 7px;
        y: 4.4px;
        width: 2px;
        height: 2px;
        border-radius: 1px;
        background: root.tint;
    }
    if root.kind == 0 : Rectangle {
        x: 7px;
        y: 7.2px;
        width: 2px;
        height: 4.6px;
        border-radius: 1px;
        background: root.tint;
    }

    // success: check mark
    if root.kind == 1 : Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 2.6 8.4 L 6.2 12 L 13.4 4.2";
        fill: #00000000;
        stroke: root.tint;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    // error: cross
    if root.kind == 2 : Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 3.8 3.8 L 12.2 12.2 M 12.2 3.8 L 3.8 12.2";
        fill: #00000000;
        stroke: root.tint;
        stroke-width: 1.8px;
        stroke-line-cap: round;
    }
}

component ToastView inherits Rectangle {
    in property <string> message: "";
    in property <int> kind: 0;
    in property <float> progress: 1.0;
    in property <bool> shown: false;
    // Slot top inside the stack; the stack owns the 3-slot geometry. Slot 0 is
    // the newest, so a new toast pushes the older ones DOWN.
    in property <length> slot_y: 0px;
    // Entrance offset: the state below eases it from -8px to 0 on entry and
    // back on the way out (slide down + fade in).
    property <length> rise: -8px;

    x: 0;
    y: self.slot_y + self.rise;
    width: 100%;
    height: 36px;
    border-radius: 18px;
    background: AppTheme.player-menu;
    border-width: 1px;
    border-color: AppTheme.player-menu-border;
    drop-shadow-color: AppTheme.player-shadow;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 3px;
    // 180ms in, 200ms out. The same animation carries a slot push-down when a
    // newer toast arrives above an older one.
    animate y { duration: root.shown ? 180ms : 200ms; easing: ease-out; }

    // Info uses the accent, success a lifted `player-on` (the raw green is too
    // dark on `player-menu`), error the theme danger.
    property <color> tint: root.kind == 1
        ? AppTheme.player-on.mix(AppTheme.player-fg-strong, 0.55)
        : (root.kind == 2 ? AppTheme.danger : AppTheme.accent);

    opacity: 0;
    states [
        shown when root.shown: {
            opacity: 1;
            rise: 0px;
            in {
                animate opacity { duration: 180ms; easing: ease-out; }
                animate rise { duration: 180ms; easing: ease-out; }
            }
            out {
                animate opacity { duration: 200ms; easing: ease-out; }
                animate rise { duration: 200ms; easing: ease-out; }
            }
        }
        hidden when !root.shown: {
            opacity: 0;
            rise: -8px;
        }
    ]

    // 24px tinted circle carrying the 16px mark.
    Rectangle {
        x: 8px;
        y: 6px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: root.tint.transparentize(0.82);

        ToastIcon {
            x: 4px;
            y: 4px;
            kind: root.kind;
            tint: root.tint;
        }
    }

    Text {
        x: 40px;
        y: 0;
        width: max(0px, parent.width - 52px);
        height: parent.height;
        text: root.message;
        color: AppTheme.player-text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    // 3px hairline along the bottom edge; `toast_progress` depletes 1 -> 0.
    Rectangle {
        x: 1px;
        y: parent.height - 4px;
        width: max(0px, (parent.width - 2px) * clamp(root.progress, 0, 1));
        height: 3px;
        border-radius: 1.5px;
        background: root.tint;
        opacity: 0.9;
    }
}

// 弹幕 popover: one segmented option (小 标准/大  25/50/75/100%, 滚动/顶部/底部).
component ChipButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> on: false;
    callback clicked();
    // Right-click: the host panel closes. No-op unless wired.
    callback dismiss();

    height: 26px;
    border-radius: 5px;
    background: root.on
        ? AppTheme.player-selected
        : (hit.has-hover ? AppTheme.player-menu-hover : AppTheme.player-btn);
    animate background { duration: 120ms; easing: ease-out; }

    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: root.on ? AppTheme.player-fg-strong : AppTheme.player-text-bright;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    hit := PanelHit {
        clicked => { root.clicked(); }
        dismiss => { root.dismiss(); }
    }
}

// ---------------------------------------------------------------------------
// 评论区 (player right panel) - small parts.
//
// Every colour here comes from AppTheme; alphas are derived with
// `transparentize()` so a token change moves the whole panel. The bundle ships
// no icon font, and an emoji would draw a colour glyph outside the theme, so
// the two marks this panel needs (heart, chevron) are `Path` geometry.
// ---------------------------------------------------------------------------

// Thread badge: UP主 / 置顶 / 楼中楼  15px tall, hugging its label.
component CmBadge inherits Rectangle {
    in property <string> text: "";
    in property <color> fill: AppTheme.player-selected;
    in property <color> ink: AppTheme.player-text-bright;

    width: badge_text.preferred-width + 10px;
    height: 15px;
    border-radius: 4px;
    background: root.fill;

    badge_text := Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: root.ink;
        font-size: 10px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// 赞 glyph: a filled heart. Two lobes + a point, drawn in a 10x9 viewbox so it
// scales with the 11.5px meta line.
component CmHeart inherits Path {
    in property <color> ink: AppTheme.player-text-dim;

    width: 10px;
    height: 9px;
    viewbox-width: 10;
    viewbox-height: 9;
    commands: "M 5 8.5 C 4.2 7.6 0.6 5.4 0.6 2.9 C 0.6 1.3 1.8 0.3 3.1 0.3 C 4.0 0.3 4.7 0.8 5 1.5 C 5.3 0.8 6.0 0.3 6.9 0.3 C 8.2 0.3 9.4 1.3 9.4 2.9 C 9.4 5.4 5.8 7.6 5 8.5 Z";
    fill: root.ink;
}

// 评论区  one comment thread - name + badges, a clamped body, the meta line and
// the 楼中楼 rows behind an animated height. The row's height follows its
// content, so a long comment (or an open thread) pushes the rows below it down;
// the ListView measures each item.
//
// Built from absolute positions, not a HorizontalLayout: the 32px avatar must be
// optically centred on the NAME line's cap height, which a layout starting at the
// content top cannot express.
//
// Measured metrics at the panel's 360px width (F99):
//   row     16px left/right padding, 14px above the name, 4px under the meta
//           line: consecutive top-level comments are 18px apart, with the 1px
//           hairline sitting on the row's top edge
//   avatar  32px (+1px ring), optically centred on the name: y = -6
//   column  text starts at x = 44 (32 avatar + 12 gap)
//   type    name 14px/600 on a 19px line, body 14px on a 23.8px line (1.7),
//           meta 12px on an 18px line, dot separators
//   thread  replies start at the text column (44px in), spine at its left edge,
//           26px avatars, 13.5px body, 12px between replies
component CommentThread inherits Rectangle {
    in property <CommentRow> item;
    // `up_owner` as the window publishes it ("UP主 · " name"), so the UP主 badge
    // needs no extra field in CommentRow.
    in property <string> up_owner: "";
    // Hairline on top: every top-level row but the first.
    in property <bool> separated: false;
    // Scroll gate: while the comment list is moving this is true, so no hover
    // wash (and no animation) runs on a row the list is sliding past the
    // pointer. It costs one boolean read per row, nothing per frame.
    in property <bool> quiet: false;
    // Both affordances belong to THIS row: the window binds them to the row's
    // index in `comment_items`. `more` is the 查看更多回复 link at the bottom of
    // an open thread and still reports the PARENT row (plus the page), because
    // a dialog is fetched by its root comment.
    callback toggle();
    callback more(int);
    // Right-click anywhere on the thread: the panel closes. No-op by default.
    callback dismiss();

    // 14px * 1.7 = 23.8px: one line of the body box. The clamp and the
    // measurement below both use it.
    property <length> line-pitch: 23.8px;
    property <int> max-lines: 8;
    // 展开 / 收起, local to the row: the data layer does not know the panel's
    // text width. Resets with the recycled row.
    in-out property <bool> body_open: false;

    // Height of the whole thread, from its own content. A ListView item MUST
    // have an explicit height - without one the list cannot compute its
    // content-height, so it never scrolls and its rows paint over the footer.
    out property <length> natural-h: content_col.preferred-height;
    height: self.natural-h;

    // Slint has no glyph metrics, so "is this longer than eight lines?" is the
    // measured wrapped height of the text itself against the 8-line box, gated
    // by a character-count heuristic (a 284px line fits ~20 CJK chars, so 88
    // characters can never reach eight lines - this only keeps a first-frame
    // measurement of 0 from collapsing the body). `character-count` is the one
    // string metric Slint 1.18 exposes; it counts characters, not display width.
    property <bool> body_clipped: body_text.preferred-height > root.max-lines * root.line-pitch + 0.5px
        && root.item.message.character-count > 88;
    property <bool> is_up: root.up_owner != "" && root.up_owner == "UP主 · " + root.item.uname;
    property <bool> has_thread: root.item.replies_text != "";
    property <bool> has_like: root.item.like_text != "";
    // One hover truth for the row wash; suppressed while the list moves.
    property <bool> wash: body_hit.has-hover && !root.quiet;

    // A card-less list item: a 3% ink wash is the only hover treatment (100ms),
    // so the surface stays the panel's own glass.
    background: root.wash ? AppTheme.player-fg-strong.transparentize(0.97) : #00000000;
    animate background { duration: 100ms; easing: ease-out; }

    // Hairline between top-level comments (never inside a thread). Inset to the
    // panel's 16px gutter so it reads as a separator, not a table rule.
    if root.separated : Rectangle {
        x: 16px;
        y: 0;
        width: max(0px, parent.width - 32px);
        height: 1px;
        background: AppTheme.player-menu-border;
    }

    // 14px above the name (the comment's own air), 4px below the meta line: the
    // next comment's 14px top padding makes exactly 18px between threads.
    content_col := VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 4px;
        spacing: 0px;

        // Click target = the comment body only, so the indented replies (and
        // their 查看更多回复 link) keep their own pointer targets. Declared
        // FIRST: every interactive affordance inside the body (the 楼中楼 pill
        // and 展开) is painted above it and therefore owns its own press. Plain
        // Rectangles/Text below do not consume pointer events, so a click
        // anywhere else still lands here.
        body := Rectangle {
            height: body_col.preferred-height + (root.body_clipped ? 20px : 0px);

            // The body toggles the thread; `pass-scroll: true` keeps the wheel
            // with the ListView (a row that eats it makes the panel look
            // unscrollable, which is exactly what happened here).
            body_hit := PanelHit {
                width: 100%;
                height: 100%;
                pass-scroll: true;
                clicked => { root.toggle(); }
                dismiss => { root.dismiss(); }
            }

            // ---- avatar: 32px, centred on the name's cap height ----
            Rectangle {
                x: 0;
                y: -6px;
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: AppTheme.player-btn;
                clip: true;

                if root.item.has_avatar : Image {
                    width: 100%;
                    height: 100%;
                    source: root.item.avatar;
                    image-fit: cover;
                }

                if !root.item.has_avatar : Text {
                    text: root.item.initial;
                    color: AppTheme.player-text-soft;
                    font-size: 12.5px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 1px ring, painted over the photo so the 32px disc keeps its size.
            Rectangle {
                x: 0;
                y: -6px;
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: #00000000;
                border-width: 1px;
                border-color: AppTheme.player-fg-strong.transparentize(0.9);
            }

            // Text column: 44 here, i.e. x = 60 absolute in the 360px panel.
            body_col := VerticalLayout {
                x: 44px;
                width: max(0px, parent.width - 44px);
                spacing: 0px;

                // ---- name + badges ----
                HorizontalLayout {
                    height: 19px;
                    spacing: 8px;

                    Text {
                        text: root.item.uname;
                        color: AppTheme.player-text-bright;
                        font-size: 14px;
                        font-weight: 600;
                        // Elide rather than push the badges out of the row; a
                        // CJK run wraps only in the body below.
                        min-width: 0px;
                        height: 100%;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.is_up : CmBadge {
                        text: "UP主";
                        fill: AppTheme.accent.transparentize(0.84);
                        ink: AppTheme.accent;
                    }

                    // The 楼中楼 badge is gone: the reply pill on the meta line
                    // is the one affordance for the thread, so the name line
                    // stays quiet (one badge at most).

                    // Absorbs the row's leftover width so the badge hugs the
                    // name instead of being pushed to the right edge.
                    Rectangle { horizontal-stretch: 1; }
                }

                Rectangle {
                    height: 2px;
                    background: #00000000;
                }

                // ---- body: eight lines, then 展开 ----
                // `line-height-factor` is relative to the font's natural line
                // height (Slint 1.18). Noto Sans SC at 14px is 20.2px natural, so
                // 1.18 lands the box on 23.8px, i.e. the design's 1.7 line height.
                body_box := Rectangle {
                    width: 100%;
                    height: root.body_clipped && !root.body_open
                        ? root.max-lines * root.line-pitch
                        : body_text.preferred-height;
                    clip: true;

                    body_text := Text {
                        width: 100%;
                        text: root.item.message;
                        color: AppTheme.player-text;
                        font-size: 14px;
                        // `line-height-factor` scales the font size in Slint
                        // 1.18 (measured: 1.18 * 14px = 16.5px pitch), so 1.7
                        // is exactly the design's 23.8px line.
                        line-height-factor: 1.7;
                        // Chinese has no spaces: `word-wrap` breaks at any
                        // character for long runs, which is what makes a CJK
                        // comment wrap like B站's own list. The width is the
                        // column's, so a long URL clips instead of stretching the
                        // panel.
                        wrap: word-wrap;
                        overflow: clip;
                    }
                }

                Rectangle {
                    height: 5px;
                    background: #00000000;
                }

                // ---- meta: 赞 · 时间 · 回复 pill ----
                // Flat, not grouped: a nested layout claims the row's leftover
                // width and pushes the dots away from 赞. Every item hugs and
                // the trailing spacer takes the slack.
                HorizontalLayout {
                    height: 18px;
                    spacing: 6px;

                    if root.has_like : Rectangle {
                        width: 10px;
                        height: 18px;
                        background: #00000000;

                        CmHeart {
                            y: (parent.height - self.height) / 2;
                            ink: AppTheme.player-text-soft;
                        }
                    }

                    if root.has_like : Text {
                        text: root.item.like_text;
                        color: AppTheme.player-text-soft;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    if root.has_like : Text {
                        text: "·";
                        color: AppTheme.player-text-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.item.time_text;
                        color: AppTheme.player-text-soft;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    if root.has_thread : Text {
                        text: "·";
                        color: AppTheme.player-text-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    // 楼中楼 chip: an explicit affordance, not a badge.
                    //   collapsed  ▸ 6 条回复      expanded  ▾ 收起回复
                    // A 18px accent pill with a drawn chevron, its own hit area
                    // and a 3%-ink hover. Clicking it toggles the thread (same
                    // `comment_toggle` the row body fires); the row body's hit
                    // area is painted *under* it, so the pill's press is never
                    // eaten.
                    if root.has_thread : Rectangle {
                        width: pill_row.preferred-width + 16px;
                        height: 18px;
                        border-radius: 9px;
                        background: chip_hit.has-hover && !root.quiet
                            ? AppTheme.accent.transparentize(0.84)
                            : (root.item.expanded
                                ? AppTheme.accent.transparentize(0.86)
                                : AppTheme.accent.transparentize(0.90));
                        animate background { duration: 100ms; easing: ease-out; }

                        pill_row := HorizontalLayout {
                            x: 8px;
                            y: 0;
                            height: 100%;
                            spacing: 4px;

                            Path {
                                y: (parent.height - self.height) / 2;
                                width: root.item.expanded ? 7px : 5px;
                                height: root.item.expanded ? 5px : 7px;
                                viewbox-width: root.item.expanded ? 7 : 5;
                                viewbox-height: root.item.expanded ? 5 : 7;
                                // filled triangle: ▾ while open, ▸ while closed.
                                commands: root.item.expanded
                                    ? "M 0 0 L 7 0 L 3.5 5 Z"
                                    : "M 0 0 L 5 3.5 L 0 7 Z";
                                fill: AppTheme.accent;
                            }

                            Text {
                                text: root.item.expanded ? "收起回复" : root.item.replies_text;
                                color: AppTheme.accent;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }
                        }

                        chip_hit := PanelHit {
                            width: 100%;
                            height: 100%;
                            pass-scroll: true;
                            clicked => { root.toggle(); }
                            dismiss => { root.dismiss(); }
                        }
                    }

                    // Absorbs the leftover width: the pill hugs 时间 instead of
                    // drifting to the row's right edge.
                    Rectangle { horizontal-stretch: 1; }
                }
            }

            // 展开 / 收起 strip: declared after the row body's hit area, so it
            // owns its own 18px band instead of toggling the thread.
            if root.body_clipped : Rectangle {
                x: 44px;
                y: body_col.preferred-height + 2px;
                width: max(0px, parent.width - 44px);
                height: 18px;
                border-radius: 4px;
                background: expand_hit.has-hover && !root.quiet
                    ? AppTheme.player-fg-strong.transparentize(0.97)
                    : #00000000;
                animate background { duration: 100ms; easing: ease-out; }

                HorizontalLayout {
                    x: 0;
                    y: 0;
                    height: 100%;
                    spacing: 3px;

                    Text {
                        text: root.body_open ? "收起" : "展开";
                        color: AppTheme.accent;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Path {
                        width: 7px;
                        height: 7px;
                        viewbox-width: 8;
                        viewbox-height: 8;
                        commands: root.body_open
                            ? "M 0.9 5.3 L 4 2.2 L 7.1 5.3"
                            : "M 0.9 2.7 L 4 5.8 L 7.1 2.7";
                        fill: #00000000;
                        stroke: AppTheme.accent;
                        stroke-width: 1.3px;
                        stroke-line-cap: round;
                    }

                    // Same reason as the meta line: keep the chevron beside 展开.
                    Rectangle { horizontal-stretch: 1; }
                }

                expand_hit := PanelHit {
                    width: 100%;
                    height: 100%;
                    pass-scroll: true;
                    clicked => { root.body_open = !root.body_open; }
                    dismiss => { root.dismiss(); }
                }
            }
        }

        // ---- 楼中楼 ----
        // Always instantiated, height 0 while closed, so opening animates the
        // height (200ms) and the content slides up 4px instead of popping in.
        // The block is the row's last child: nothing below it inside the row has
        // to re-flow while it grows.
        //
        // The block is full width (a layout positions its children, so an
        // explicit `x` here would be ignored); `content` below is the part that
        // starts at the parent's text column (44px in), so the spine sits
        // exactly under the comment's own text edge.
        replies_box := Rectangle {
            width: 100%;
            height: root.item.expanded
                ? 10px + rows_col.preferred-height + (root.item.has_more ? 24px : 0px)
                : 0px;
            clip: true;
            opacity: root.item.expanded ? 1 : 0;
            animate height {
                duration: root.item.expanded ? 200ms : 160ms;
                easing: ease-out;
            }
            animate opacity {
                duration: root.item.expanded ? 200ms : 160ms;
                easing: ease-out;
            }

            content := Rectangle {
                x: 44px;
                y: root.item.expanded ? 0px : 4px;
                width: max(0px, parent.width - 44px);
                height: 100%;
                animate y {
                    duration: root.item.expanded ? 200ms : 160ms;
                    easing: ease-out;
                }

                // Thread spine: accent at 18%, from the first avatar's centre to
                // the last one's. It stops above 查看更多回复 so the link reads
                // as a footer.
                if rows_col.preferred-height > 0px : Rectangle {
                    x: 0;
                    y: 13px;
                    width: 1px;
                    height: max(0px, rows_col.preferred-height - 26px);
                    background: AppTheme.accent.transparentize(0.82);
                }

                rows_col := VerticalLayout {
                    x: 10px;
                    y: 10px;
                    width: max(0px, parent.width - 10px);
                    spacing: 12px;

                    for reply in root.item.replies : Rectangle {
                        height: reply_col.preferred-height;

                        Rectangle {
                            x: 0;
                            y: -4px;
                            width: 26px;
                            height: 26px;
                            border-radius: 13px;
                            background: AppTheme.player-btn;
                            clip: true;

                            if reply.has_avatar : Image {
                                width: 100%;
                                height: 100%;
                                source: reply.avatar;
                                image-fit: cover;
                            }

                            if !reply.has_avatar : Text {
                                text: reply.initial;
                                color: AppTheme.player-text-soft;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            x: 0;
                            y: -4px;
                            width: 26px;
                            height: 26px;
                            border-radius: 13px;
                            background: #00000000;
                            border-width: 1px;
                            border-color: AppTheme.player-fg-strong.transparentize(0.9);
                        }

                        reply_col := VerticalLayout {
                            x: 34px;
                            width: max(0px, parent.width - 34px);
                            spacing: 3px;

                            HorizontalLayout {
                                height: 16px;
                                spacing: 6px;

                                Text {
                                    text: reply.uname;
                                    color: AppTheme.player-text-soft;
                                    font-size: 12.5px;
                                    font-weight: 500;
                                    min-width: 0px;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }

                                if reply.like_text != "" : HorizontalLayout {
                                    spacing: 3px;

                                    CmHeart { ink: AppTheme.player-text-dim; }

                                    Text {
                                        text: reply.like_text;
                                        color: AppTheme.player-text-dim;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle { horizontal-stretch: 1; }

                                Text {
                                    text: reply.time_text;
                                    color: AppTheme.player-text-dim;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                width: 100%;
                                text: reply.message;
                                color: AppTheme.player-text-soft;
                                font-size: 13.5px;
                                // 13.5 * 1.45 = 19.6px: one comfortable reply
                                // line, a step tighter than the top level.
                                line-height-factor: 1.45;
                                wrap: word-wrap;
                                overflow: clip;
                            }
                        }
                    }
                }

                if root.item.has_more : Rectangle {
                    x: 10px;
                    y: 10px + rows_col.preferred-height + 2px;
                    width: max(0px, parent.width - 10px);
                    height: 20px;
                    border-radius: 5px;
                    background: more_hit.has-hover && !root.quiet
                        ? AppTheme.player-fg-strong.transparentize(0.97)
                        : #00000000;
                    animate background { duration: 100ms; easing: ease-out; }

                    HorizontalLayout {
                        x: 0;
                        y: 0;
                        height: 100%;
                        spacing: 3px;

                        Text {
                            text: "查看更多回复";
                            color: AppTheme.accent;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        Path {
                            width: 8px;
                            height: 8px;
                            viewbox-width: 8;
                            viewbox-height: 8;
                            commands: "M 0.9 2.7 L 4 5.8 L 7.1 2.7";
                            fill: #00000000;
                            stroke: AppTheme.accent;
                            stroke-width: 1.3px;
                            stroke-line-cap: round;
                        }

                        // Keeps the chevron beside the label instead of at the
                        // block's right edge (the layout fills the row).
                        Rectangle { horizontal-stretch: 1; }
                    }

                    more_hit := PanelHit {
                        width: 100%;
                        height: 100%;
                        pass-scroll: true;
                        clicked => { root.more(root.item.next_pn); }
                        dismiss => { root.dismiss(); }
                    }
                }
            }
        }
    }
}

// 加载骨架: shaped like a real comment (32px avatar disc, a 14px name bar, two
// 12px body bars on the 23.8px rhythm, a 10px meta bar) instead of grey bars
// floating in a box. Three of them replace the first page in flight, one is the
// list footer while the next page loads, so the panel keeps its rhythm either
// way.
component CommentSkeleton inherits Rectangle {
    // 0..1, driven by the panel's 900ms pulse timer.
    in property <float> pulse: 0;
    // Scroll gate: the pulse animation is 0ms while the list moves and the
    // timer is stopped by the panel, so a scrolling skeleton is a static image.
    in property <bool> quiet: false;
    // Hairline on top, like a comment that follows another one.
    in property <bool> separated: false;
    // White at 10-16% is the only surface that reads against the panel's glass
    // in both themes (`player-btn` at rest is not a skeleton colour).
    property <float> level: 0.1 + root.pulse * 0.06;

    height: 106px;
    clip: true;

    if root.separated : Rectangle {
        x: 16px;
        y: 0;
        width: max(0px, parent.width - 32px);
        height: 1px;
        background: AppTheme.player-menu-border;
    }

    // One group opacity for the whole row: a single animated property instead of
    // one per bar.
    Rectangle {
        x: 16px;
        y: 14px;
        width: max(0px, parent.width - 32px);
        height: 78px;
        background: #00000000;
        opacity: root.level;
        animate opacity { duration: root.quiet ? 0ms : 900ms; easing: ease-in-out; }

        Rectangle {
            x: 0;
            y: 0;
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: AppTheme.player-fg-strong;
        }

        Rectangle {
            x: 44px;
            y: 1px;
            width: (parent.width - 44px) * 0.38;
            height: 14px;
            border-radius: 7px;
            background: AppTheme.player-fg-strong;
        }

        Rectangle {
            x: 44px;
            y: 26px;
            width: (parent.width - 44px) * 0.94;
            height: 12px;
            border-radius: 6px;
            background: AppTheme.player-fg-strong;
        }

        Rectangle {
            x: 44px;
            y: 46px;
            width: (parent.width - 44px) * 0.66;
            height: 12px;
            border-radius: 6px;
            background: AppTheme.player-fg-strong;
        }

        Rectangle {
            x: 44px;
            y: 68px;
            width: (parent.width - 44px) * 0.3;
            height: 10px;
            border-radius: 5px;
            background: AppTheme.player-fg-strong;
        }
    }
}

export component PlayerWindow inherits Window {
    default-font-family: "Chill Round Gothic";
    default-font-size: 14px;
    // Frameless like the main window; the native frame style (WS_CAPTION
    // cleared, WS_THICKFRAME kept) is enforced from Rust with
    // win::install_subclass. Resizing is app-driven: `resize-border-width: 0`
    // turns off Slint's own modal `drag_resize_window`, and the `ResizeFrame`
    // at the end of this window supplies the 8px hot zones.
    no-frame: true;
    resize-border-width: 0px;
    // Pure video canvas: the picture fills the whole window at the video's own
    // 960x540 aspect. There are no bars in the layout - the title and the
    // window controls float over the picture and fade with `chrome_shown`, and
    // the control bar is a floating pill that slides in on hover. The danmaku
    // layer maps the engine's fixed 960x540 space (player.rs VIDEO_W/VIDEO_H)
    // onto the canvas, so it scales with the window.
    //
    // `preferred-*`, not `width`/`height`: an explicit width/height binding is
    // turned into a `fixed-width` constant by the Slint compiler
    // (`check_window_layout`), which binds the WindowItem's own size to that
    // constant - `root.width` / `root.height` would then keep reporting
    // 960x540 after a resize and the canvas could never follow the window (nor
    // fill the screen in fullscreen). This is the main window's pattern: an
    // initial size that reflows with the window, with a floor that keeps the
    // floating pill usable.
    preferred-width: 960px;
    preferred-height: 540px;
    min-width: 480px;
    min-height: 270px;
    max-width: 100000px;
    max-height: 100000px;
    // Transparent on the Window itself, like the main window: the visible
    // background is the backdrop + tint stack below.
    background: transparent;

    // ---- backdrop ----------------------------------------------------------
    // The generated wallpaper TILE (see `src/backdrop.rs`), repeated under the
    // whole client area and anchored to the window's screen position, then the
    // player-glass tint above it. Nothing samples the desktop any more, so the
    // first painted frame is already the wallpaper + tint.
    in property <image> wallpaper;
    in property <bool> wallpaper_valid: false;

    // ---- chrome lifetime ------------------------------------------------
    // Written from Rust: the real cursor tested against the window rect at
    // ~60 Hz. It is the ONLY source of truth for `chrome_shown` below.
    // Deriving the chrome from item `has-hover` flags made the top-right `i`
    // chip, the pill and the popovers lose their hit target: the moment the
    // pointer crossed a gap between two hover areas the chrome faded out from
    // under it. Default false, so a build without the wiring stays hidden.
    in property <bool> pointer_inside: false;

    forward-focus: key_handler;

    // ---- drivers written from Rust: names and types are the Rust contract ----
    in property <image> frame;
    in property <string> video_title: "播放器";
    in property <string> player_status: "";
    in property <bool> playing: true;
    in property <[DanmakuItem]> danmaku_items;
    in property <bool> danmaku_running: false;

    // ---- buffering / pre-roll (written from Rust on the player tick) ----
    // `buffering` is true from `open` until the pacer's pre-roll target is
    // reached (or its timeout); `buffer_progress` walks 0..1 toward that
    // target. The 缓冲屏 below is the only consumer.
    in property <bool> buffering: false;
    in property <float> buffer_progress: 0.0;

    // ---- quality ----
    // `quality_menu_rows` is the model the 画质 menu draws (see
    // QualityMenuRow): the playable stream rows plus the locked 大会员 tiers.
    // `quality_rows` is the player's raw stream-only model; Rust still writes
    // it but the menu no longer draws it.
    // `quality_label` is the current stream's short name, shown on the 画质 row.
    // `quality_items` / `quality_qn` are the older collapsed-by-qn contract and
    // stay declared so the Rust tree keeps compiling; the menu no longer draws
    // them.
    in property <[QualityRow]> quality_rows: [];
    in property <[QualityMenuRow]> quality_menu_rows: [];
    in property <[QualityEntry]> quality_items;
    in-out property <int> quality_qn: 0;
    in property <string> quality_label: "";

    // ---- audio track ----
    in property <[AudioEntry]> audio_items;
    in-out property <int> audio_index: 0;
    // 音质 section of the 画质 popup (see AudioQualityRow). `audio_quality` is
    // the requested DASH audio id, 0 = 自动（最高）.
    in property <[AudioQualityRow]> audio_quality_rows;
    in-out property <int> audio_quality: 0;
    callback audio_quality_pick(int);
    in property <string> audio_label: "音轨";

    // ---- 截图 / 信息 / 比例 / 亮度 / 仅音频 / 睡眠 ----
    in-out property <bool> info_open: false;
    in property <[string]> info_lines;
    // Default 0 (适配): the picture keeps its aspect ratio and the opaque
    // `video-bg` container letterboxes it, so resizing the window never
    // distorts the frame. 1 填充 (cover) and 2 拉伸 (fill) stay one click away
    // in the 二级 panel's 画面比例 menu. Rust also seeds this at open
    // (`main.rs` `player.set_fit_mode(0)`), so the two defaults agree.
    in-out property <int> fit_mode: 0; // 0 适配 1 填充 2 拉伸
    in-out property <int> brightness: 0; // -100..100
    in-out property <bool> audio_only: false;
    in-out property <string> sleep_text: "";

    // ---- window modes ----
    in-out property <bool> topmost: false;
    in property <string> topmost_text: "置顶";
    in-out property <bool> mini_open: false;

    // ---- danmaku settings ----
    in-out property <float> danmaku_opacity: 1.0;
    in property <string> danmaku_opacity_text: "100";
    in-out property <int> danmaku_font: 1;
    in-out property <int> danmaku_speed: 100;
    in-out property <int> danmaku_area: 100;
    in-out property <bool> block_scroll: false;
    in-out property <bool> block_top: false;
    in-out property <bool> block_bottom: false;

    // ---- like ----
    in-out property <bool> liked: false;
    in property <string> like_text: "点赞";

    // ---- coin (投币) ----
    in-out property <int> coin_multiply: 0;
    in property <string> coin_text: "投币";

    // ---- favourite (收藏) ----
    in-out property <bool> favorited: false;
    in property <string> fav_text: "收藏";
    in property <[PlayerFavRow]> fav_items;
    in property <string> interaction_status: "";

    // ---- transport / time ----
    in-out property <float> position_ms: 0;
    in property <float> duration_ms: 0;
    in property <string> time_current: "00:00";
    in property <string> time_total: "00:00";
    in property <string> time_remaining: "-00:00";

    // ---- volume / mute ----
    in-out property <float> volume: 100;
    in property <bool> muted: false;
    in property <string> volume_text: "100";
    // ---- wheel volume feedback (transient, drawn, no numbers) ----
    // A wheel step shows the capsule for 900ms after the LAST step: a 60ms
    // countdown is reset to 15 ticks by every step, so a spin keeps it up and
    // it fades 900ms after the wheel stops.
    property <bool> wheel_hud_on: false;
    property <int> wheel_hud_ticks: 0;

    // ---- speed ----
    in-out property <float> speed_milli: 1000;
    in property <string> speed_text: "1.0x";

    // ---- danmaku ----
    in-out property <bool> danmaku_on: true;
    in-out property <string> danmaku_text: "弹幕开";
    // The fast lane's timer (see the split `Timer` pair below). Rust owns both:
    // `interval` is `min(120, monitor refresh)` (8 ms wake at 120 Hz, because a
    // Slint duration is whole milliseconds) and `running` is only true while
    // comments can actually move.
    in property <duration> danmaku_frame_interval: 8ms;
    in property <bool> danmaku_frame_running: false;

    // ---- danmaku density curve ----
    in property <[float]> density_buckets;
    in-out property <bool> density_on: true;
    // The 弹幕列表 panel and its row model are gone (the list page was removed
    // with the bottom strip). The model stays declared because the player's
    // danmaku hooks in `src/main.rs` still publish it.
    in property <[DanmakuRow]> danmaku_list;
    in property <int> danmaku_list_count: 0;
    in-out property <bool> danmaku_list_open: false;

    // ---- 提示条 (toast stack, Rust-driven) ----
    // Newest LAST: the stack draws the newest at the bottom. Max 3 on screen;
    // the oldest drop off the top. `kind` is 0 info · 1 success · 2 error.
    in property <[ToastItem]> toasts: [];
    // 1 -> 0 progress of the 3px hairline on each toast. Rust decrements it
    // while the toast is up; one shared value is enough while a single toast
    // shows (two visible toasts share the same bar - see the report).
    in property <float> toast_progress: 1.0;

    // ---- 历史弹幕 ----
    in property <[string]> history_dates;
    in property <string> history_status: "";
    in-out property <string> history_selected: "";

    // ---- 发送弹幕 ----
    in-out property <string> danmaku_input: "";
    in property <string> send_status: "";

    // ---- fullscreen ----
    in property <bool> fullscreen: false;
    in property <string> fullscreen_text: "全屏";

    // ---- 评论区 / 视频信息 (left sidebar) ----
    // The left sidebar is the video's "about + social + comments" side; the
    // right panel keeps "how to watch" (播放 / 画面 / 弹幕). Both slide with the
    // same 220ms x-animation and neither fades with the hover chrome.
    in-out property <bool> comments_open: false;
    in property <[CommentRow]> comment_items;
    // Sort: true = 热度 (mode 3), false = 按时间 (mode 2). Rust is the source of
    // truth and re-publishes it after every fetch.
    in-out property <bool> comments_hot: true;
    in property <bool> comments_loading: false;
    in property <string> comments_error: "";
    in property <int> comments_total: 0;
    in property <bool> comments_end: false;
    // Height of the comment list's LAST item: the footer skeleton (106 + 4
    // tail), the quiet end / error line (40 + 16), or the bare 16px tail that
    // keeps the last comment off the panel edge. The list is model-driven, so
    // the footer is an item, not a sibling - see the panel's comment block.
    property <length> comments-footer-h: root.comments_loading
        ? 110px
        : ((root.comments_end || root.comments_error != "") ? 56px : 16px);
    // One page per delivery: `comments_load_armed` clears when a request goes
    // out and re-arms when the model grows (a page landed). Without it the
    // near-bottom check would fire on every frame.
    property <bool> comments_load_armed: true;
    property <int> comments_seen: 0;
    // ---- 评论区 scroll gate (per-row animation only) ----
    // True while the comment list's `content-y` is moving, and for 120ms after
    // the last change. The strip's `player-glass` tint over the window backdrop
    // stays PAINTED for the whole scroll: hiding it behind a flat 94% plate
    // bought no measurable frames on the F99 harness and turned the panel into
    // an opaque plate the moment the list moved, which is what the user saw.
    // What this flag still gates is per-row work: no hover wash,
    // no skeleton pulse and no reply stagger while the list slides under the
    // pointer - the part of a scroll the panel actually paid for.
    property <bool> comments_scroll_busy: false;
    // Countdown ticks owned by the list's 40ms timer (3 x 40 = 120ms tail).
    property <int> comments_scroll_ticks: 0;
    in property <string> info_title: "";
    in property <string> info_owner: "";
    in property <string> info_stats: "";
    in property <image> info_cover;
    in property <bool> info_cover_ready: false;
    // Drives the indeterminate loading bar under the comment list.
    property <float> load_phase: 0;

    // ---- 外扩面板 (outward panels) ----
    // Opening one adds a strip to the WINDOW edge, so the video keeps its exact
    // size and position. Rust grows the outer window by the strip size in the
    // same event, then the strip simply fills the new space.
    //
    //   0 = none
    //   right_panel  1 = open (the 信息 / 评论 / 性能 / 设置 tab strip)
    //
    // The LEFT strip is gone: 视频信息 + 互动 moved into the right strip's 信息
    // tab, so only the right edge ever grows the window now. The bottom strip
    // (弹幕列表) went earlier. `left_panel` / `left_panel_w` / `bottom_panel` /
    // `bottom_panel_h` stay DECLARED so `src/main.rs` still compiles; they are
    // inert (no strip, no reserved width, no window growth).
    //
    // `right_tab` picks the body: 0 信息 · 1 评论 · 2 性能 · 3 设置. Rust may
    // still write `right_panel` 2/3 (the old BILI_PANEL_TEST values); a change
    // handler maps them onto the matching tab, so old callers keep working.
    //
    // `panel_changed()` fires AFTER `right_panel` changes, in BOTH layout modes,
    // so Rust can grow (or shrink) the window to match.
    in-out property <int> left_panel: 0;
    in-out property <int> right_panel: 0;
    in-out property <int> bottom_panel: 0;
    in property <length> left_panel_w: 320px;
    in property <length> right_panel_w: 360px;
    in property <length> bottom_panel_h: 200px;
    in-out property <int> right_tab: 0;
    callback right_tab_changed(int);
    // Fullscreen has no room to grow the window, so the SAME three ints switch
    // to overlay mode there: no strip reserves space, the panels float over the
    // picture anchored to the same edges. The default binding follows the
    // player's own `fullscreen` flag (written from Rust by on_toggle_fullscreen),
    // so the mode flips by itself; the wiring agent may still set it explicitly.
    in property <bool> panels_overlay: root.fullscreen;
    callback panel_changed();

    // Fired with the new level whenever 缩放进度条 enters, leaves or zooms.
    // Rust publishes the 20 scrub_heat values for THAT level here instead of
    // polling; the window itself is derived in Slint (no extra state).
    callback scrub_level_changed(int);

    // ---- 性能 (live profiler, published from Rust) ----
    // Every value is a pre-formatted string so the panel never has to guess a
    // unit; `net_buffer_ratio` (0..1) drives the buffer fill bar.
    in property <string> net_fps_presented: "";
    in property <string> net_fps_decoded: "";
    in property <string> net_first_frame: "";
    in property <string> net_buffer: "";
    in property <string> net_rate: "";
    in property <string> net_bitrate: "";
    in property <string> net_progress: "";
    in property <float> net_buffer_ratio: 0;
    in property <string> net_stalls: "";
    in property <string> net_codec: "";
    // Buffer diagnosis published by Rust (`PlaybackControl::buffer_detail`):
    // throughput / read-ahead, one pre-formatted line. Declared for the Rust
    // setter; shown as the last 缓冲 row below.
    in property <string> buffer_detail: "";
    // Per-connection rows for 线程 (Rust trims the list to 8).
    in property <[NetWorker]> net_workers: [];
    // 下载分布: 120 equal slices over the whole file. 0 missing, 1 downloaded,
    // 3 fetching now. Downloaded bytes are immediately playable, so the point
    // cache is merged into 1 (it is not a separate category). Rust patches the
    // rows in place (`set_row_data`) so the strip repaints without rebuilding.
    in property <[int]> net_map: [];
    // "4 / 4 线程 · 7.2 MB/s" - busy workers over configured ones.
    in property <string> net_active_text: "";
    // "已下载 48.0 MB / 455.9 MB (10.5%)".
    in property <string> net_total_text: "";
    // Live bar fill: the metered rate over the max of the last 5 s (0..1).
    in property <float> net_rate_ratio: 0;
    // 1 s pulse for the active slices in the strip (see the strip's opacity).
    property <float> net_pulse: 0;
    // The 性能 body is the visible tab: gates its pulse timer so a closed
    // panel repaints nothing.
    property <bool> net_panel_open: root.right_panel != 0 && root.right_tab == 2;

    // ---- 平滑 (frame interpolation, published from Rust) ----
    // One mode, three published strings: the short name for the 模式 row
    // ("关闭" / "混合" / "块匹配" / "OFA"), the generator readout for 生成, and
    // the optional GPU line ("" hides the row). The UI never formats a number
    // itself, and it never invents a mode: `interp_level` is DERIVED from
    // `interp_mode_text` so the badge can never disagree with the row.
    // `interp_cycle()` advances 0 -> 1 -> 2 -> 3 -> 0 in Rust (OFA is skipped
    // where its runtime is missing) and persists it; both the pill cell and the
    // panel row are entry points to the same call.
    in property <string> interp_mode_text: "关闭";
    in property <string> interp_stats_text: "—";
    in property <string> interp_gpu_text: "";
    callback interp_cycle();

    // 0 关闭 · 1 混合 · 2 块匹配 · 3 OFA. "关闭" is the documented default; the
    // optical-flow labels are matched on their own words, so a future spelling
    // ("块匹配光流", "OFA 光流") still lights the right badge, and any other
    // label reads as the blend mode instead of a false 关闭.
    property <int> interp_level: root.interp_mode_text == "关闭"
        || root.interp_mode_text == ""
        ? 0
        : (root.interp_mode_text.starts-with("块匹配") ? 2
            : (root.interp_mode_text.starts-with("OFA") ? 3 : 1));
    // The pill tooltip: one line per state, always naming the mode (never just
    // "平滑").
    property <string> interp_tip: root.interp_level == 0
        ? "平滑：关闭"
        : (root.interp_level == 3
            ? "平滑：OFA 光流（N 卡硬件）"
            : (root.interp_level == 2
                ? "平滑：块匹配光流（CPU）"
                : "平滑：帧混合（低延迟）"));

    // ---- 二级 panel ----
    // `fit_menu_open` / `brightness_menu_open` / `sleep_menu_open` are also
    // written from Rust (reset to false at startup), so they stay: they now
    // mean "that panel row is expanded".
    in-out property <bool> panel_open: false;
    in-out property <bool> fit_menu_open: false;
    in-out property <bool> brightness_menu_open: false;
    in-out property <bool> sleep_menu_open: false;
    property <bool> quality_expanded: false;
    property <bool> speed_expanded: false;
    property <bool> audio_expanded: false;
    property <bool> coin_expanded: false;
    property <bool> fav_expanded: false;
    property <bool> opacity_expanded: false;
    property <bool> font_expanded: false;
    property <bool> dspeed_expanded: false;
    property <bool> area_expanded: false;
    property <bool> type_expanded: false;
    property <bool> history_expanded: false;

    // ---- interaction state ----
    // A seek-bar drag only PREVIEWS: `drag_ms` drives the fill, the knob and
    // the time readout while the pointer is down, and the single `seek()` is
    // issued on release (a seek restarts the decoder, so one per gesture).
    //
    // `in-out` (not plain) so the QA drag harness can replay the exact same
    // property writes the pointer handler makes - no OS mouse event involved.
    in-out property <bool> dragging: false;
    in-out property <float> drag_ms: 0;
    property <float> shown_ms: root.dragging ? root.drag_ms : root.position_ms;
    // QA-only: stands in for `progress_area.pressed` while a harness replays a
    // drag. Production never writes it (default false), so the lost-pointer
    // fallback below behaves exactly as it always has for real gestures.
    in-out property <bool> qa_drag_hold: false;
    // QA-only: hold every player popover up at once (volume + danmaku + right
    // panel) so one capture can show all three glass treatments. Production
    // leaves it false; the normal click/hover rules still own the popovers.
    in-out property <bool> qa_hold_popovers: false;
    // QA-only: keep the chrome (and therefore the popovers) up for a replay
    // capture without touching the real cursor. Production leaves it false.
    in-out property <bool> qa_hold_chrome: false;

    // ---- QA probes: the right strip's scroll state, per active tab ----
    // One shared pair, written by whichever tab body is instantiated. A wheel
    // replay reads them before/after; `max` is the scroller's real travel.
    out property <length> qa_right_scroll_y: 0px;
    out property <length> qa_right_scroll_max: 0px;
    // Arms the 性能 / 设置 scroll probes (a 80ms timer) only for the QA replay.
    in-out property <bool> qa_scroll_probe: false;
    // 评论's list is instantiated conditionally, so the strip writes this
    // mirror instead of touching `comments_list` from outside its `if`.
    in-out property <length> comments_scroll_y: 0px;
    in-out property <length> comments_scroll_max: 0px;
    // Hit-band heights and drag-update counters, for the f145 measurements.
    // The heights are the REAL bands (not constants copied from the design):
    // the seek band is the 22px rectangle that owns the pointer, the volume
    // band the 128px `vol_area` over the popover track.
    out property <length> qa_seek_hit_h: seek_band.height;
    out property <length> qa_vol_hit_h: vol_area.height;
    out property <int> qa_seek_moves: 0;
    out property <int> qa_vol_moves: 0;
    // Window-space rects of the two drag bands and the volume button, so a
    // replay aims at the real laid-out geometry after the panel grows/shrinks.
    out property <length> qa_seek_x: seek_band.absolute-position.x;
    out property <length> qa_seek_y: seek_band.absolute-position.y;
    out property <length> qa_seek_w: seek_band.width;
    out property <length> qa_vol_x: vol_area.absolute-position.x;
    out property <length> qa_vol_y: vol_area.absolute-position.y;
    out property <length> qa_vol_w: vol_area.width;
    out property <length> qa_vol_btn_x: vol_icon.absolute-position.x;
    out property <length> qa_vol_btn_y: vol_icon.absolute-position.y;
    out property <length> qa_vol_btn_w: vol_icon.width;
    out property <bool> qa_vol_shown: vol_plate.shown;
    out property <length> qa_right_x: right_strip_area.absolute-position.x;
    out property <length> qa_right_w: right_strip_area.width;

    // ---- idle auto-hide veto (read by Rust) ----
    // Rust owns the idle timeout and writes `pointer_inside`; it reads this flag
    // only to know when NOT to time the chrome out. `chrome_shown` stays exactly
    // `pointer_inside` - the hold never forces the chrome up, it only keeps it up
    // while the user is demonstrably interacting.
    //
    // True while: a floating popover is open (音量 / 弹幕 / 画质), a seek bar or
    // 缩放进度条 drag is in flight, or the pointer is over the right panel (the
    // panel has its own close button, so keeping the pill up there is fine).
    // The player has no playlist panel and the toast stack has no hover target
    // (plain Rectangles), so neither contributes a condition here.
    in-out property <bool> chrome_hold: root.quality_expanded
        || pill.vol_open || pill.dm_open
        || root.dragging || root.scrub_dragging
        || right_strip_area.has-hover;

    // ---- pointer-driven chrome ----
    // ONE source of truth: `pointer_inside`, written by Rust from the real
    // cursor position against the window rect. The chrome is visible exactly
    // while the pointer is inside the window, so it can never fade out from
    // under a control, a popover or the gap between two buttons - the old OR of
    // item `has-hover` flags did exactly that (a 2px gap between the seek band
    // and the control row, or the pill's own padding, was enough). The bars
    // keep their own fade animations, which does the blending.
    //
    // While hidden, every control is `enabled: false` (below), so the picture
    // keeps the pointer; the panels are deliberately NOT gated on this.
    // `has-hover` is still tracked on the strips so their own hover washes work.
    property <bool> chrome_shown: root.pointer_inside || root.qa_hold_chrome;

    // ---- panel geometry (both layout modes) ----
    // `right_w` is the right strip's real size and never depends on the mode;
    // `reserve_r` is what the layout takes OUT of the window and is zero in
    // overlay mode, where the picture keeps the whole window. `pill_y` is the
    // pill's top edge in window coordinates: 100px up from the bottom edge
    // (92px pill + 8px inset), independent of any panel.
    //
    // The left strip is gone: `left_w` is pinned to 0 and `reserve_l` follows,
    // so the video keeps its size with only the 360px right strip reserved.
    // Nothing animates `right_w`: Rust snaps the outer window by the strip in
    // the same event, so the strip must snap with it (its content still fades).
    property <length> left_w: 0px;
    property <length> right_w: root.right_panel != 0 ? root.right_panel_w : 0px;
    // Inert: the bottom strip is gone, the band always uses the full height.
    property <length> bottom_h: 0px;
    property <length> reserve_l: 0px;
    property <length> reserve_r: root.panels_overlay ? 0px : root.right_w;
    property <length> reserve_b: 0px;
    property <length> video_w: max(0px, root.width - root.reserve_l - root.reserve_r);
    property <length> band_h: max(0px, root.height - root.reserve_b);
    property <length> pill_y: max(0px, root.height - 100px);

    // ---- 缩放进度条 (zoom scrubber) ----
    // Right-clicking the seek bar morphs the whole pill into a 20-cell heat
    // strip. The state lives here, in Slint:
    //
    //   scrub_level   0 = normal toolbar (no strip), 1 = the whole video,
    //                 2 = 1/20 of it, 3 = 1/400, 4 = 1/8000, 5 = 1/160000.
    //   scrub_cell_N  the cell (0..19) picked when zooming INTO level N+1, so
    //                 the window base can be rebuilt exactly on the way out.
    //   scrub_heat    the 20 densities (0..1) Rust publishes for the CURRENT
    //                 level; missing entries fall back to 0.15.
    //
    // The window is derived, never stored: base = sum(cell_k * duration /
    // 20^k) over the levels below the current one, span = duration / 20^(n-1).
    in-out property <int> scrub_level: 0;
    in-out property <int> scrub_cell_1: 0;
    in-out property <int> scrub_cell_2: 0;
    in-out property <int> scrub_cell_3: 0;
    in-out property <int> scrub_cell_4: 0;
    // Still published by Rust for the level's window; the strip no longer
    // paints it - the cells are a progress fill now, not a density heat map.
    in property <[float]> scrub_heat: [];
    // Drag = preview only (the strip's fill and line follow the pointer 1:1);
    // the single `seek()` is issued on release. `scrub_settle_ms` holds the
    // released target on screen until the new position lands, so the line never
    // snaps back to the old playhead for a frame.
    property <bool> scrub_dragging: false;
    property <float> scrub_drag_ms: 0;
    property <bool> scrub_settling: false;
    property <float> scrub_settle_ms: 0;
    property <float> scrub_preview_ms: root.scrub_dragging
        ? root.scrub_drag_ms
        : (root.scrub_settling ? root.scrub_settle_ms : root.shown_ms);
    // The 设置 body's content height. A ScrollView whose content is a layout is
    // bottom-aligned as soon as that content is taller than the viewport (it
    // starts at the maximum scroll, which hid 播放/画质 on a 540px window), so
    // the height is pinned explicitly - the same workaround the home page's
    // feed ScrollView uses. Keep the sum in step with the 设置 rows:
    // 11 rows x 40 + 3 sections x 32 + 20 gaps x 2 + 12 padding = 588.
    // 画质 no longer expands inline (it opens the floating menu below/above the
    // row), so it does not contribute to this sum any more.
    property <length> settings_h: 588px
        + (root.speed_expanded ? (6 * 34px + 6px) : 0px)
        + (root.audio_expanded ? (root.audio_items.length * 34px + 6px) : 0px)
        + (root.fit_menu_open ? (3 * 34px + 6px) : 0px)
        + (root.brightness_menu_open ? 38px : 0px)
        + (root.sleep_menu_open ? (6 * 32px + 26px) : 0px)
        + (root.history_expanded ? (root.history_dates.length * 30px + 28px) : 0px);
    // The 性能 body's content height, same ScrollView contract as
    // `settings_h`. Keep the sum in step with the rows below:
    //   pad 14 | 实时速度 32+34+12+4 | 线程 32+22+18n | 下载分布 32+10+18+16+6
    //   | 平滑 32+24n | 帧率 32+4*24 | 缓冲 32+5*24+18 (+24 明细)
    property <length> net_h: 14px
        + 82px
        + (54px + root.net_workers.length * 18px + (root.net_workers.length == 0 ? 18px : 0px))
        + 82px
        + 128px
        + (root.interp_gpu_text != "" ? 104px : 80px)
        + (170px + (root.buffer_detail != "" ? 24px : 0px));
    // 1 s pulse on the strip's active slices: half a second up, half a second
    // down, so a fetching worker reads as "live" against the static cells.
    animate net_pulse { duration: 500ms; easing: ease-in-out; }

    // ---- panel toggles ----
    // One home for the "close whatever is there / open the new one" rule, so
    // every entry point (pill, 信息 chip, tab row, panel close button) fires
    // `panel_changed()` exactly once and in the same way.
    //
    // `set-right(mode)` keeps the pill's old 1/2/3 meanings, now as tabs:
    // 1 评论 (tab 1), 2 性能 (tab 2), 3 设置 (tab 3). 信息 (tab 0) has no
    // legacy mode; it is reached by the top strip's chip and by the tab row.
    function set-right(mode: int) {
        let tab = max(1, min(3, mode));
        if (root.right_panel != 0 && root.right_tab == tab) {
            root.close-right();
            return;
        }
        let was_open = root.right_panel != 0;
        root.right_panel = 1;
        root.right_tab = tab;
        // The 画质 menu belongs to the 设置 body: switching or closing the panel
        // takes it with it, so reopening starts from the row, not from a menu
        // left open over another tab. The pill popovers follow the same rule:
        // only one floating surface is ever up.
        root.quality_expanded = false;
        pill.vol_open = false;
        pill.dm_open = false;
        if (!was_open) {
            root.panel_changed();
        }
        root.right_tab_changed(tab);
    }

    // The tab row's own click: same rules, but a click on the tab already shown
    // keeps the panel open (only the tab content is being chosen).
    function select-right-tab(tab: int) {
        let was_open = root.right_panel != 0;
        root.right_panel = 1;
        if (root.right_tab != tab) {
            root.right_tab = tab;
            root.quality_expanded = false;
            pill.vol_open = false;
            pill.dm_open = false;
            root.right_tab_changed(tab);
        }
        if (!was_open) {
            root.panel_changed();
        }
    }

    function close-right() {
        if (root.right_panel != 0) {
            root.right_panel = 0;
            root.quality_expanded = false;
            root.panel_changed();
        }
    }

    // Legacy bridge: Rust (BILI_PANEL_TEST) can still write the old 2/3 values.
    // Keep `right_panel` as "is it open" and let the int pick the tab.
    changed right_panel => {
        // A panel that closes (or reopens) mid-scroll must never leave the
        // per-row gate armed: the list that would release it is gone.
        root.comments_scroll_busy = false;
        if (root.right_panel == 2 || root.right_panel == 3) {
            root.right_tab = root.right_panel - 1;
            root.right_tab_changed(root.right_tab);
        }
    }

    // Same for a tab change: the comment list stops existing, so the gate is
    // released by the tab that owns it.
    changed right_tab => {
        root.comments_scroll_busy = false;
    }

    // 提示条 helpers: `k` counts from the NEWEST (0 = the newest, drawn at the
    // bottom of the stack). Out-of-range reads return empty / info so a slot
    // never indexes past the model.
    function toast-text(k: int) -> string {
        if (k >= root.toasts.length) {
            return "";
        }
        return root.toasts[root.toasts.length - 1 - k].text;
    }

    function toast-kind(k: int) -> int {
        if (k >= root.toasts.length) {
            return 0;
        }
        return root.toasts[root.toasts.length - 1 - k].kind;
    }

    // Labels for the 性能 panel: an empty published string reads as "-", so
    // an idle panel looks designed instead of showing gaps.
    pure function or-dash(value: string) -> string {
        return value == "" ? "-" : value;
    }

    // ---- 评论区  infinite scroll ----
    // Called from the list's `scrolled` callback and from its 200ms safety
    // timer. Arguments (instead of reading `comments_list` directly) because the
    // ListView lives inside a conditional block and its id is not reachable from
    // component scope.
    function comments-maybe-more(content_h: length, visible_h: length, content_y: length) {
        if (root.right_panel == 0 || root.right_tab != 1 || root.comments_loading || root.comments_end) {
            return;
        }
        if (root.comment_items.length == 0) {
            return;
        }
        // A new page landed: re-arm.
        if (root.comment_items.length != root.comments_seen) {
            root.comments_seen = root.comment_items.length;
            root.comments_load_armed = true;
        }
        if (!root.comments_load_armed) {
            return;
        }
        // Trigger: the last ~2 rows are visible, or the scroll fraction passes
        // 0.92. `content_y` is negative while scrolled, so "from the bottom" is
        // scrollable + content_y.
        let scrollable = content_h - visible_h;
        if (scrollable <= 0px) {
            // Nothing to scroll: the first page does not fill the body.
            root.comments_load_armed = false;
            root.comments_more();
            return;
        }
        let from_bottom = scrollable + content_y;
        if (from_bottom <= 140px || (-content_y) >= scrollable * 0.92) {
            root.comments_load_armed = false;
            root.comments_more();
        }
    }

    // ---- 画质 menu helpers ----
    // The 画质 row's value: the current stream's short name as published by
    // Rust, and "自动" until the first stream list arrives. The old default
    // ("画质") is never shown as a value now that the menu has real rows.
    property <string> quality_value: root.quality_label != ""
        ? root.quality_label
        : (root.quality_menu_rows.length == 0 ? "自动" : "当前画质");

    // Open the 画质 menu from Rust (QA capture: the menu normally opens through
    // the 画质 row's own click). Only the open direction is exposed; closing
    // stays the UI's.
    public function open_quality_menu() {
        root.quality_expanded = true;
        root.quality_menu_opened();
    }

    // Chip width for the badges the API sends. The rows are absolutely
    // positioned (a Flickable, not a layout), so the chip has to know its own
    // width; 8K is two glyphs, 会员 / 大会员 CJK glyphs, HDR three Latin ones.
    pure function quality-badge-w(badge: string) -> length {
        if (badge == "8K") {
            return 26px;
        }
        if (badge == "HDR") {
            return 32px;
        }
        if (badge == "杜比") {
            return 32px;
        }
        if (badge == "会员") {
            return 34px;
        }
        if (badge == "大会员") {
            return 46px;
        }
        return 0px;
    }

    // Configurable shortcuts: one candidate-key index per action (see the 设置
    // panel). Defaults match the original Space / arrows / M / F / Esc / D / Q / S.
    in property <[int]> key_map: [3, 4, 5, 6, 7, 0, 8, 12, 9, 10, 11];

    callback toggle_pause();
    callback player_closed();
    callback toggle_minimize();
    callback window_drag_start();
    callback window_drag_move();
    callback window_drag_end();
    callback resize_start(int);
    callback resize_move();
    callback resize_end();
    callback danmaku_tick();
    // The fast half of the danmaku layer: advance the on-screen comments and
    // nothing else (see the split timers).
    callback danmaku_frame_tick();
    callback seek(float);
    callback volume_changed(float);
    callback toggle_mute();
    callback set_speed(float);
    callback toggle_fullscreen();
    callback set_quality(int);
    // The 画质 menu picked row N of `quality_rows`. Index, not qn: one qn can
    // be several streams (AVC 1080P60 / HEVC 1080P60 / ...), so only the row
    // identifies the stream the user asked for.
    callback quality_pick(int);
    // The 画质 menu just opened. Rust resets its locked-tier toast latch, so a
    // locked row explains itself once per open instead of once per window.
    callback quality_menu_opened();
    callback danmaku_settings_changed(float, int);
    callback danmaku_speed_changed(int);
    callback danmaku_area_changed(int);
    callback danmaku_type_block_changed(bool, bool, bool);
    callback block_at(length, length);
    callback toggle_like();
    callback set_audio(int);
    callback take_screenshot();
    callback toggle_info();
    callback toggle_audio_only();
    callback set_sleep(int);
    callback toggle_topmost();
    callback toggle_mini();
    callback set_coin(int);
    callback open_fav_menu();
    callback toggle_fav(string);
    callback unfav_all();
    callback add_toview();
    callback download_current();
    callback open_history();
    callback set_history_date(string);
    callback send_danmaku(string);
    callback report_danmaku(string);
    callback thumbup_danmaku(string);
    // 评论区 (left sidebar). These four are the data layer's public entry
    // points; `comment_toggle` is the UI's row-expand (Rust owns `expanded`
    // so the row's state survives a republish) and fetches page 1 on open.
    //
    // The two comment callbacks carry a ROW INDEX into `comment_items`, never
    // an id: B站 rpids are int64 and Slint's `int` is 32-bit, so passing one
    // through here truncated it and no lookup could ever match. Rust keeps the
    // index -> rpid map for exactly the rows it published.
    //   comment_toggle(row)        top-level row in `comment_items`
    //   comment_replies(row, pn)   same row; `pn` is the 1-based dialog page
    callback comments_load();
    callback comments_more();
    callback comments_sort(bool);
    callback comment_replies(int, int);
    callback comment_toggle(int);

    title: root.video_title;
    icon: @image-url("../assets/icons/o11a1.png");

    Timer {
        interval: 33ms;
        running: root.danmaku_running;
        triggered => { root.danmaku_tick(); }
    }

    // The danmaku motion lane. Split from the 33 ms tick above on purpose: that
    // handler carries the toasts, the 画质 menu, the stats, the playlist, the
    // panels, the buffering overlay and the profiler, and running it at 8 ms
    // would quadruple the UI cost instead of making the comments smoother.
    //
    // `danmaku_frame_interval` is chosen by Rust (`min(120, monitor refresh)`,
    // `BILI_DANMAKU_HZ` for the A/B) and Slint restarts the timer when it
    // changes. `danmaku_frame_running` is written by the 33 ms tick, so a
    // paused, buffering or 弹幕-off window does not wake the UI thread at 120 Hz.
    Timer {
        interval: root.danmaku_frame_interval;
        running: root.danmaku_frame_running && root.danmaku_running;
        triggered => { root.danmaku_frame_tick(); }
    }

    // ---- 进度条 drag: preview only, one seek on release ----
    // Every seek restarts the decoder (~1s), so the drag itself is a pure
    // preview: `shown_ms` follows the pointer frame-exactly (fill, knob, time
    // readout) and the single `seek()` goes out on the Up event. There is no
    // live-seek timer any more.
    //
    // A release outside the window never reaches `progress_area`, so the drag
    // is finished here (and applied) as soon as the area is no longer pressed.
    // This is what keeps `dragging` from sticking.
    Timer {
        interval: 120ms;
        running: root.dragging;
        triggered => {
            if (root.dragging && !progress_area.pressed && !root.qa_drag_hold) {
                root.dragging = false;
                root.seek(root.drag_ms);
            }
        }
    }

    // After a scrub release the strip keeps the released target on screen until
    // the new position actually lands, so the green fill and the line never snap
    // back to the old playhead for a frame. The 900ms timer is the fallback for
    // a seek that never reports back.
    changed position_ms => {
        if (root.scrub_settling && abs(root.position_ms - root.scrub_settle_ms) < 1500) {
            root.scrub_settling = false;
        }
    }

    Timer {
        interval: 900ms;
        running: root.scrub_settling;
        triggered => { root.scrub_settling = false; }
    }

    // Wheel volume HUD: 60ms ticks, reset to 15 (900ms) by every wheel step.
    Timer {
        interval: 60ms;
        running: root.wheel_hud_on;
        triggered => {
            root.wheel_hud_ticks = max(0, root.wheel_hud_ticks - 1);
            if (root.wheel_hud_ticks <= 0) {
                root.wheel_hud_on = false;
            }
        }
    }

    // The chrome going away (pointer left the window) takes any hover-driven
    // popover with it, so it cannot come back stale on the next pointer entry.
    // The 画质 menu is a chrome child too: it closes with the same edge, so a
    // panel reopened later never shows a menu left over from the last session.
    Timer {
        interval: 150ms;
        running: !root.chrome_shown && (pill.vol_open || pill.dm_open || root.quality_expanded);
        triggered => {
            if (!root.chrome_shown) {
                pill.vol_open = false;
                pill.dm_open = false;
                root.quality_expanded = false;
                // The zoom strip morphed out of the pill is chrome as well.
                if (root.scrub_level != 0) {
                    root.scrub-close();
                }
            }
        }
    }

    // 音量 popover: a pointer y inside its 128px track becomes 0..100, bottom
    // = 0%. The value is floored at 0 / capped at 100 so a drag past either end
    // pins the fill to the track.
    pure function volume-level-at(y: length) -> float {
        if (vol_track.height <= 0px) {
            return root.volume;
        }
        return clamp(1 - y / vol_track.height, 0, 1) * 100;
    }

    pure function ms-at(x: length, width: length) -> float {        if (width <= 0px) {
            return 0;
        }
        return clamp((x / width) * root.duration_ms, 0, max(0, root.duration_ms));
    }

    // 00:00 / 0:00:00 for a millisecond value, used while the seek bar is
    // dragged so the readout follows the pointer instead of the playback
    // position (which only moves when a seek lands).
    pure function pad2(v: int) -> string {
        return v < 10 ? "0" + v : "" + v;
    }

    pure function fmt-ms(ms: float) -> string {
        let secs = round(max(0.0, ms) / 1000);
        let mins = floor(secs / 60);
        let hours = floor(mins / 60);
        let s = secs - mins * 60;
        let m = mins - hours * 60;
        if (hours > 0) {
            return hours + ":" + root.pad2(m) + ":" + root.pad2(s);
        }
        return root.pad2(m) + ":" + root.pad2(s);
    }

    // ---- 缩放进度条  geometry, state transitions, seek ----
    // The strip is 20 cells across the bar's inner width: the opened bar fills
    // ~80% of the player surface (clamped 720..1100px), and the cells stretch
    // with it, 1px gap, 8px inner padding on both sides.
    //
    // Current position: `scrub_frac` maps the preview playhead into the
    // CURRENT window (base..base+span, 0..1). While a drag is in flight the
    // preview IS the pointer, so the green fill and the 2px line follow it 1:1;
    // otherwise they sit on the real playback position (or the released target
    // until it lands). The line is never drawn under a hovering pointer.
    property <float> scrub_frac: clamp((root.scrub_preview_ms - root.scrub_base_ms) / max(1, root.scrub_span_ms), 0, 1);

    // 20^(level-1): level 1 = the whole video, 2 = 1/20, 3 = 1/400, ...
    pure function scrub-divisor(level: int) -> float {
        if (level <= 1) { return 1; }
        if (level == 2) { return 20; }
        if (level == 3) { return 400; }
        if (level == 4) { return 8000; }
        return 160000;
    }

    // Window start: each level below the current one contributed one cell of
    // its own (20x wider) window, so the offsets are exact powers of 20.
    function scrub-base(level: int) -> float {
        return (level >= 2 ? root.scrub_cell_1 * root.duration_ms / 20 : 0)
            + (level >= 3 ? root.scrub_cell_2 * root.duration_ms / 400 : 0)
            + (level >= 4 ? root.scrub_cell_3 * root.duration_ms / 8000 : 0)
            + (level >= 5 ? root.scrub_cell_4 * root.duration_ms / 160000 : 0);
    }

    function scrub-span(level: int) -> float {
        return max(1, root.duration_ms / root.scrub-divisor(level));
    }

    property <float> scrub_base_ms: root.scrub-base(root.scrub_level);
    property <float> scrub_span_ms: root.scrub-span(root.scrub_level);

    // The single writer for scrub_level: notifies Rust only on a real change.
    function scrub-set-level(level: int) {
        if (root.scrub_level == level) {
            return;
        }
        root.scrub_level = level;
        root.scrub_level_changed(level);
    }

    // Right-click the seek bar -> level 1 on the whole video. Zeroing the cell
    // path keeps the window exact when a fresh gesture starts.
    function scrub-open() {
        if (root.scrub_level != 0) {
            return;
        }
        root.scrub_cell_1 = 0;
        root.scrub_cell_2 = 0;
        root.scrub_cell_3 = 0;
        root.scrub_cell_4 = 0;
        root.scrub-set-level(1);
    }

    // Esc / click on the picture / play -> straight back to the toolbar.
    function scrub-close() {
        root.scrub_dragging = false;
        root.scrub-set-level(0);
    }

    // Double-click cell i: remember it for this level and divide the window by
    // 20 again. The cap (5) keeps the smallest window at ~45ms for a 2h video.
    function scrub-zoom-in(cell: int) {
        if (root.scrub_level <= 0 || root.scrub_level >= 5) {
            return;
        }
        if (root.scrub_level == 1) {
            root.scrub_cell_1 = cell;
        } else if (root.scrub_level == 2) {
            root.scrub_cell_2 = cell;
        } else if (root.scrub_level == 3) {
            root.scrub_cell_3 = cell;
        } else {
            root.scrub_cell_4 = cell;
        }
        root.scrub-set-level(root.scrub_level + 1);
    }

    // Right-click: one level back; at level 1 it morphs the toolbar back.
    function scrub-zoom-out() {
        if (root.scrub_level <= 1) {
            root.scrub-set-level(0);
            return;
        }
        root.scrub-set-level(root.scrub_level - 1);
    }

    // Press / drag on the strip: absolute ms at `x`, continuous over the cells
    // block (no snapping). The cells are inset by the bar's 8px padding.
    function scrub-ms-at(x: length, strip_w: length) -> float {
        return clamp(root.scrub_base_ms
            + clamp((x - 8px) / max(1px, strip_w - 16px), 0, 1) * root.scrub_span_ms,
            0, max(0, root.duration_ms));
    }

    // Cell under `x`, from the same geometry the cells are drawn with: the
    // cell width is passed in (`pill.scrub_cell_w`), so the hit test and the
    // drawing can never disagree after a resize.
    function scrub-cell-at(x: length, strip_w: length, cell_w: length) -> float {
        return clamp(floor((x - 8px) / max(1px, cell_w + 1px)), 0, 19);
    }

    // The strip's top-left label: the window in mm:ss.
    pure function two-digit(v: float) -> string {
        return v < 9.5 ? "0" + max(0, v).to-fixed(0) : v.to-fixed(0);
    }

    pure function clock(ms: float) -> string {
        return root.two-digit(floor(max(0, ms) / 60000))
            + ":" + root.two-digit(Math.mod(floor(max(0, ms) / 1000), 60));
    }

    property <string> scrub_window_text:
        root.clock(root.scrub_base_ms) + " – "
        + root.clock(min(root.duration_ms, root.scrub_base_ms + root.scrub_span_ms));

    // Level indicator: the playhead's cell at the current level's own
    // resolution, e.g. `1/20` on the whole video and `1/20 · 2/400` one level
    // in. Cells are 1-based, so the label always reads "cell N of M".
    pure function scrub-play-cell(cells: float) -> string {
        let frac = clamp(root.scrub_preview_ms / max(1, root.duration_ms), 0, 1);
        return (min(floor(frac * cells), cells - 1) + 1).to-fixed(0);
    }

    pure function scrub-level-label(level: int) -> string {
        let c20 = root.scrub-play-cell(20) + "/20";
        if (level <= 1) {
            return c20;
        }
        let c400 = c20 + " · " + root.scrub-play-cell(400) + "/400";
        if (level == 2) {
            return c400;
        }
        let c8000 = c400 + " · " + root.scrub-play-cell(8000) + "/8000";
        if (level == 3) {
            return c8000;
        }
        if (level == 4) {
            return c8000 + " · " + root.scrub-play-cell(160000) + "/160000";
        }
        return c8000 + " · " + root.scrub-play-cell(3200000) + "/3200000";
    }

    property <string> scrub_level_text: root.scrub-level-label(root.scrub_level);

    // Wheel over the picture / the pill's background: 2% steps, clamped. The
    // first wheel-up while muted only unmutes (Rust owns `muted`, so the
    // existing callback is the way to change it).
    function wheel-volume(up: bool) {
        if (up && root.muted) {
            root.toggle_mute();
            root.wheel_hud_ticks = 15;
            root.wheel_hud_on = true;
            return;
        }
        root.volume = clamp(root.volume + (up ? 2 : -2), 0, 100);
        root.volume_changed(root.volume);
        root.wheel_hud_ticks = 15;
        root.wheel_hud_on = true;
    }

    pure function speed-label(milli: float) -> string {
        if (milli == 2000) { return "2.0x"; }
        if (milli == 1500) { return "1.5x"; }
        if (milli == 1250) { return "1.25x"; }
        if (milli == 1000) { return "1.0x"; }
        if (milli == 750) { return "0.75x"; }
        return "0.5x";
    }

    pure function fit-label(mode: int) -> string {
        if (mode == 0) { return "适配"; }
        if (mode == 1) { return "填充"; }
        return "拉伸";
    }

    pure function font-label(size: int) -> string {
        if (size == 0) { return "小"; }
        if (size == 1) { return "标准"; }
        return "大";
    }

    // ---- buffering overlay geometry ----
    // The video engine lays out a fixed 960x540 picture (player.rs
    // VIDEO_W/VIDEO_H), so 适配 (fit_mode 0) letterboxes exactly that aspect
    // inside the band. `pic_*` is the picture's rect in the band's
    // coordinates: the buffer layer centres on the picture, so a letterboxed
    // window centres the mark on the 16:9 picture rather than on the window.
    // 填充 / 拉伸 paint edge to edge, so there the picture IS the band.
    property <length> pic_w: root.fit_mode == 0 ? min(root.video_w, root.band_h * 16.0 / 9.0) : root.video_w;
    property <length> pic_h: root.fit_mode == 0 ? min(root.band_h, root.video_w * 9.0 / 16.0) : root.band_h;
    property <length> pic_x: max(0px, (root.video_w - root.pic_w) / 2);
    property <length> pic_y: max(0px, (root.band_h - root.pic_h) / 2);

    // The progress arc, in the ring's own 92x92 viewbox (centre 46,46, r 42).
    // One SVG arc from 12 o'clock clockwise; the large-arc flag flips past
    // the half turn, and 100% becomes two half arcs because SVG cannot draw a
    // 360-degree arc from a point back to itself. Changing `commands` does not
    // re-create nodes - it re-tessellates this one Path only.
    pure function buffer-arc-path(progress: float) -> string {
        if (progress <= 0.002) {
            return "M 46 4";
        }
        if (progress >= 0.998) {
            return "M 46 4 A 42 42 0 1 1 46 88 A 42 42 0 1 1 46 4";
        }
        return "M 46 4 A 42 42 0 " + (progress > 0.5 ? "1" : "0") + " 1 "
            + (46 + 42 * (progress * 360deg).sin()).to-fixed(2) + " "
            + (46 - 42 * (progress * 360deg).cos()).to-fixed(2);
    }

    // An indeterminate 90-degree sweep for the "no frames yet" phase: while the
    // ring is empty the progress arc is a single invisible point, which reads as
    // a frozen player. This short arc travels the same track once per breath, so
    // the wait visibly continues even when there is no progress to report.
    pure function buffer-sweep-path(phase: float) -> string {
        return "M " + (46 + 42 * ((phase * 360deg).sin())).to-fixed(2) + " "
            + (46 - 42 * ((phase * 360deg).cos())).to-fixed(2) + " A 42 42 0 0 1 "
            + (46 + 42 * (((phase + 0.25) * 360deg).sin())).to-fixed(2) + " "
            + (46 - 42 * (((phase + 0.25) * 360deg).cos())).to-fixed(2);
    }

    // The arc eases toward the published value (Rust writes it at ~30 Hz), so
    // it slides instead of stepping. The line of text shares the same value so
    // the percentage and the arc can never disagree.
    property <float> buffer_arc: clamp(root.buffer_progress, 0, 1);
    animate buffer_arc { duration: 200ms; easing: ease-out; }

    // Breathing pulse: one full breath per 150 ticks of the 16 ms timer
    // (~2.4 s). 0 at the exhale, 1 at the inhale. This keeps the mark alive
    // while `buffer_progress` is flat on a slow network.
    property <float> buffer_phase: 0;
    property <float> buffer_pulse: 0.5 - 0.5 * (root.buffer_phase * 360deg).cos();

    Timer {
        interval: 16ms;
        running: root.buffering;
        triggered => { root.buffer_phase = Math.mod(root.buffer_phase + 0.006667, 1.0); }
    }

    // ---- backdrop ----------------------------------------------------------
    // Wallpaper tile first, tint above it: together they are the window
    // background. The layer repeats the tile under the whole client area at an
    // offset derived from the window's SCREEN position (parallax); the tint is
    // the player-glass surface. The video band paints opaque black over both;
    // the chrome bands and the letterbox bars stay transparent over them.
    if wallpaper_valid : WallpaperLayer {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: root.wallpaper;
    }
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: AppTheme.player-glass;
    }

    // ===================== 画面区 (video area) =====================
    // The picture and every piece of chrome live here, in one strip whose
    // geometry depends on the panel mode:
    //   reserved (windowed): x = left strip, width = window - both strips, so
    //     the picture keeps its exact size while Rust grows the window by the
    //     panel size in the same event as the integer change.
    //   overlay (fullscreen): x = 0, width = window, so the picture stays
    //     full-bleed and the panels float above it.
    // The band's height is the strip minus the bottom strip (reserved mode);
    // in overlay mode the bottom panel floats and the band keeps the full
    // height.
    Rectangle {
        x: root.reserve_l;
        y: 0;
        width: root.video_w;
        height: root.height;
        background: #00000000;

        // ---- the picture band: picture, letterbox, danmaku, status ----
        // The band is TRANSPARENT: an aspect mismatch (e.g. 1100x700) leaves
        // tinted letterbox bars instead of black ones, because the window's
        // generated backdrop + player-glass tint show through. The picture
        // itself is an opaque Image, so no frame pixel ever goes transparent.
        // `fit_mode` (适配/填充/拉伸) letterboxes inside this band; the danmaku
        // layer maps the engine's 960x540 space onto it.
        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: root.band_h;
            background: #00000000;

            Image {
                source: root.frame;
                width: 100%;
                height: 100%;
                image-fit: root.fit_mode == 0 ? ImageFit.contain : (root.fit_mode == 1 ? ImageFit.cover : ImageFit.fill);
            }

            // Brightness: two scrims, only one of which is ever visible.
            Rectangle {
                width: 100%;
                height: 100%;
                visible: root.brightness < 0;
                background: #000000;
                opacity: min(0.9, (-root.brightness) / 130);
            }

            Rectangle {
                width: 100%;
                height: 100%;
                visible: root.brightness > 0;
                background: #ffffff;
                opacity: min(0.9, root.brightness / 110);
            }

            Rectangle {
                width: 100%;
                height: 100%;
                clip: true;
                visible: root.danmaku_on;
                // No group opacity here: it would force an intermediate composition
                // layer every frame. The tick bakes `danmaku_opacity` into each
                // item's colour alpha instead (the settings slider still shows and
                // writes the property).
                opacity: 1.0;
                background: #00000000;

                // The engine lays danmaku out in its fixed 960x540 logical space
                // (player.rs VIDEO_W/VIDEO_H); this layer is the actual video band,
                // which is taller/wider in a resized or fullscreen window. Scale
                // position and size from that space to the band so the same lane
                // math lands correctly at any window size. The shadow copy keeps
                // its +1px offset AFTER scaling, and follows the item's baked alpha
                // so it fades with the body text.
                for item in root.danmaku_items : Text {
                    x: item.x * (parent.width / 960px) + 1px;
                    y: item.y * (parent.height / 540px) + 1px;
                    text: item.text;
                    color: AppTheme.danmaku-shadow.with-alpha(item.color.alpha / 255.0);
                    font-size: item.size * (parent.height / 540px);
                    font-weight: item.bold ? 700 : 400;
                }

                for item in root.danmaku_items : Text {
                    x: item.x * (parent.width / 960px);
                    y: item.y * (parent.height / 540px);
                    text: item.text;
                    color: item.color;
                    font-size: item.size * (parent.height / 540px);
                    font-weight: item.bold ? 700 : 400;
                }
            }

            // Non-interactive sleep indicator (the only state line left on the
            // picture: transient reminders are the toast stack now, so there is
            // no `player_status` / `interaction_status` text here any more).
            // Painted under `video_area` so the whole-band drag TouchArea stays
            // the topmost pointer target.
            Text {
                x: 12px;
                y: root.pill_y - 38px;
                width: max(0px, parent.width - 24px);
                height: 20px;
                text: root.sleep_text;
                color: AppTheme.video-status-fg;
                font-size: 12px;
                horizontal-alignment: left;
                vertical-alignment: center;
                opacity: 0.85;
                visible: root.sleep_text != "";
            }

            // The whole picture drags the window: down/move/up wire the absolute
            // window drag, so grabbing anywhere on the picture moves the window.
            // Declared LAST in the band so it is the topmost pointer target over
            // the whole picture: the danmaku layer, the brightness scrims and the
            // sleep line above it are all non-interactive. A press that travels
            // past a few px is a drag, not a click - the `dragged` flag (set on
            // move, cleared on release, reset on the next press) suppresses the
            // danmaku block that Slint would otherwise also emit for the release.
            // Slint dispatches `clicked` before the Up pointer-event, so the flag
            // is still set when the click is handled.
            video_area := TouchArea {
                width: 100%;
                height: 100%;

                property <length> press_x: 0px;
                property <length> press_y: 0px;
                property <bool> dragged: false;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        // The button lives on the Down event: a Move event carries
                        // no button, so checking it before the kind branches
                        // rejected every move and the window never followed the
                        // drag. Reject only a non-left press, accept the moves.
                        if (event.button != PointerEventButton.left) {
                            return EventResult.reject;
                        }
                        self.dragged = false;
                        self.press_x = self.mouse-x;
                        self.press_y = self.mouse-y;
                        root.window_drag_start();
                        EventResult.accept
                    } else if (event.kind == PointerEventKind.move) {
                        if (abs(self.mouse-x - self.press_x) > 4px || abs(self.mouse-y - self.press_y) > 4px) {
                            self.dragged = true;
                        }
                        root.window_drag_move();
                        EventResult.accept
                    } else if (event.kind == PointerEventKind.up) {
                        root.window_drag_end();
                        self.dragged = false;
                        EventResult.accept
                    } else {
                        // Cancel (the pointer left while grabbed): end the drag too.
                        root.window_drag_end();
                        self.dragged = false;
                        EventResult.accept
                    }
                }

                double-clicked => {
                    root.toggle_fullscreen();
                }

                // The click lands in band coordinates; `block_at` compares against
                // the engine's fixed 960x540 space (see the danmaku layer), so map
                // it back before the hit test. Skipped when the gesture was a drag.
                // A click on the picture also leaves the zoom scrubber (level 0)
                // and, in that case, does not fire a danmaku block: the click was
                // the dismissal.
                clicked => {
                    if (!self.dragged) {
                        if (root.quality_expanded) {
                            // A press on the picture is an outside click for the
                            // 画质 menu: dismiss the menu, do not also block a
                            // danmaku at that spot.
                            root.quality_expanded = false;
                        } else if (pill.vol_open || pill.dm_open) {
                            // Outside click for the pill popovers.
                            pill.vol_open = false;
                            pill.dm_open = false;
                        } else if (root.scrub_level != 0) {
                            root.scrub-close();
                        } else {
                            root.block_at(self.mouse-x * (960px / parent.width), self.mouse-y * (540px / parent.height));
                        }
                    }
                }

                // Wheel anywhere on the picture: volume, 2% per notch. The
                // panels sit above this strip, so their own scrolling never
                // reaches here.
                scroll-event(event) => {
                    if (event.delta-y != 0) {
                        // Slint's delta-y is positive for a wheel-up notch.
                        root.wheel-volume(event.delta-y > 0);
                        return EventResult.accept;
                    }
                    EventResult.reject
                }
            }
        }

        // ===================== 缓冲屏 (buffering / pre-roll) =====================
        // Sits over the PICTURE only: `pic_*` follows 适配's letterbox inside
        // the band, so a 1100x700 window centres the mark on the 16:9 picture,
        // not on the window, and the side/bottom panel strips are never
        // covered. Declared after the picture band and before every chrome
        // element: above the frozen frame, danmaku and status text, UNDER the
        // title strip, top controls and the pill - those keep their exact
        // hover behaviour. The layer has no TouchArea, so the picture still
        // owns the drag and the click and the chrome's hover is untouched.
        //
        // Composition, in the app's own language: a faint scrim, then a
        // 132px plate (same surface / hairline / 30px radius family as the
        // floating pill and the 二级 panels) carrying a 92px ring. The ring's
        // track is `player-track`; the arc is `accent`, the same colour the
        // seek bar uses for progress. Nothing here is a font glyph or a new
        // colour.
        Rectangle {
            x: root.reserve_l + root.pic_x;
            y: root.pic_y;
            width: root.pic_w;
            height: root.pic_h;
            background: #00000000;
            // 120 ms in / 200 ms out. Two directions, so a state transition
            // (which can differ per direction) rather than one implicit
            // animation.
            opacity: 0;
            states [
                buffering when root.buffering: {
                    opacity: 1;
                    in { animate opacity { duration: 120ms; easing: ease-out; } }
                    out { animate opacity { duration: 200ms; easing: ease-out; } }
                }
                idle when !root.buffering: {
                    opacity: 0;
                }
            ]

            // Scrim: dims a bright frame just enough for the ring to read. The
            // chrome above it is not affected.
            Rectangle {
                width: 100%;
                height: 100%;
                background: AppTheme.video-bg;
                opacity: 0.14 + 0.06 * root.buffer_pulse;
            }

            // The plate. Its own opacity breathes; the ring is a sibling, so
            // the arc keeps its contrast through the breath.
            GlassPanel {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 132px;
                height: 132px;
                radius: 30px;
                tint: AppTheme.player-menu-tint;
                edge: AppTheme.player-menu-border;
                opacity: 0.84 + 0.12 * root.buffer_pulse;
            }

            // 12 o'clock seat: the full track, very low contrast against the
            // plate, so the arc reads as the moving part.
            Path {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 92px;
                height: 92px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 92;
                viewbox-height: 92;
                commands: "M 46 4 A 42 42 0 1 1 46 88 A 42 42 0 1 1 46 4";
                fill: #00000000;
                stroke: AppTheme.accent;
                stroke-width: 2.5px;
                stroke-line-cap: round;
                opacity: 0.20;
            }

            // Indeterminate sweep, only while there is no measurable progress.
            Path {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 92px;
                height: 92px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 92;
                viewbox-height: 92;
                commands: root.buffer-sweep-path(root.buffer_phase);
                fill: #00000000;
                stroke: AppTheme.accent;
                stroke-width: 2.5px;
                stroke-line-cap: round;
                opacity: root.buffer_arc < 0.05 ? 0.95 : 0;
            }

            // The buffered part: `buffer_progress` in degrees of arc, growing
            // clockwise from 12 o'clock. A plain Path binding, so no node is
            // created or destroyed as the value changes.
            Path {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 92px;
                height: 92px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 92;
                viewbox-height: 92;
                commands: root.buffer-arc-path(root.buffer_arc);
                fill: #00000000;
                stroke: AppTheme.accent;
                stroke-width: 2.5px;
                stroke-line-cap: round;
                opacity: 0.92 + 0.08 * root.buffer_pulse;
            }

            // The single line: the state is in the arc, the line only says
            // what and how much. A 1px shadow copy (the title's treatment)
            // keeps it legible over a bright frame.
            Text {
                x: (parent.width - 220px) / 2;
                y: (parent.height - 16px) / 2 + 83px;
                width: 220px;
                height: 16px;
                text: "正在缓冲 " + (root.buffer_arc * 100).to-fixed(0) + "%";
                color: AppTheme.video-status-shadow;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                opacity: 0.55;
            }

            Text {
                x: (parent.width - 220px) / 2;
                y: (parent.height - 16px) / 2 + 82px;
                width: 220px;
                height: 16px;
                text: "正在缓冲 " + (root.buffer_arc * 100).to-fixed(0) + "%";
                color: AppTheme.video-status-fg;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                opacity: 0.95;
            }
        }

        // ===================== 顶部覆盖屏 (while the chrome is shown) =====================
        // Declared after the band so it paints above it. The title sits directly
        // on the picture - a shadow copy behind a body copy - with the 信息 chip
        // (left panel) and the minimise/close cluster in the top-right corner.
        // Everything fades with `chrome_shown` and is disabled while hidden, so
        // the video keeps the pointer when the chrome is away. The OS resize rim
        // owns y 0-8, so the drag strip and every button start at y: 8px.
        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 44px;
            background: #00000000;
            opacity: root.chrome_shown ? 1 : 0;
            animate opacity { duration: 250ms; easing: ease-out; }

            // Window drag: the top ~44px strip minus the resize rim, the 信息 chip
            // and the top-right control cluster.
            top_drag := TouchArea {
                x: 8px;
                y: 8px;
                width: max(0px, parent.width - 88px - 8px - 34px);
                height: 36px;
                enabled: root.chrome_shown;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        if (event.button != PointerEventButton.left) {
                            return EventResult.reject;
                        }
                        root.window_drag_start();
                        EventResult.accept
                    } else if (event.kind == PointerEventKind.move) {
                        root.window_drag_move();
                        EventResult.accept
                    } else {
                        root.window_drag_end();
                        EventResult.accept
                    }
                }
            }

            // Title overlaid on the picture: a 1px-offset shadow copy under the
            // body copy keeps it legible over bright frames.
            Text {
                x: 16px;
                y: 9px;
                width: max(0px, parent.width - 186px);
                height: 20px;
                text: root.video_title;
                color: AppTheme.video-status-shadow;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                x: 16px;
                y: 10px;
                width: max(0px, parent.width - 186px);
                height: 20px;
                text: root.video_title;
                color: AppTheme.video-status-fg;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }

            // 信息: opens the RIGHT panel on its 信息 tab (视频信息 + 互动).
            // A drawn "i" mark - the bundled font has no emoji, so no glyph is
            // used anywhere here. In overlay mode the top-right corner can sit
            // ON an open right panel, so the whole cluster slides left by that
            // panel's width.
            Rectangle {
                x: parent.width - 114px - (root.panels_overlay ? root.right_w : 0px);
                y: 12px;
                width: 26px;
                height: 26px;
                border-radius: 6px;
                background: root.right_panel != 0 && root.right_tab == 0
                    ? AppTheme.player-selected
                    : (info_btn.has-hover ? AppTheme.video-overlay-bg : #00000000);

                Rectangle {
                    x: (parent.width - 2.6px) / 2;
                    y: 6px;
                    width: 2.6px;
                    height: 2.6px;
                    border-radius: 1.3px;
                    background: root.right_panel != 0 && root.right_tab == 0 ? AppTheme.player-fg-strong : AppTheme.video-overlay-fg;
                }

                Rectangle {
                    x: (parent.width - 2.6px) / 2;
                    y: 10.6px;
                    width: 2.6px;
                    height: 8px;
                    border-radius: 1.3px;
                    background: root.right_panel != 0 && root.right_tab == 0 ? AppTheme.player-fg-strong : AppTheme.video-overlay-fg;
                }

                info_btn := TouchArea {
                    enabled: root.chrome_shown;
                    clicked => {
                        if (root.right_panel != 0 && root.right_tab == 0) {
                            root.close-right();
                        } else {
                            root.select-right-tab(0);
                        }
                    }
                }
            }

            // Top-right cluster: minimise / close only. 小窗 and 置顶 live in the
            // 设置 panel's 其他 section. A TouchArea, not a Rectangle, so the
            // whole 68x26 cluster is one hit target.
            top_controls := TouchArea {
                x: parent.width - 80px - (root.panels_overlay ? root.right_w : 0px);
                y: 12px;
                width: 68px;
                height: 26px;
                enabled: root.chrome_shown;

                MarkButton {
                    x: 0;
                    width: 32px;
                    height: 26px;
                    kind: 0;
                    mark-size: 11px;
                    base: AppTheme.video-overlay-bg;
                    mark: AppTheme.video-overlay-fg;
                    hover-bg: AppTheme.video-overlay-hover;
                    interactive: root.chrome_shown;
                    clicked => { root.toggle_minimize(); }
                }

                MarkButton {
                    x: 36px;
                    width: 32px;
                    height: 26px;
                    kind: 2;
                    mark-size: 11px;
                    base: AppTheme.video-overlay-bg;
                    mark: AppTheme.video-overlay-fg;
                    hover-bg: AppTheme.video-overlay-hover;
                    close-hover-bg: AppTheme.danger;
                    interactive: root.chrome_shown;
                    clicked => { root.player_closed(); }
                }
            }
        }

        // ===================== 浮动药丸 (92px: top band = seek, bottom = controls)
        // =====================
        // Bigger transport, as asked: 452px wide, 92px tall, still centred over
        // the picture and hugging its content. Eight cells now - the 全屏 cell
        // is gone (double-click on the picture toggles fullscreen) and 平滑
        // joined between 性能 and 设置, so the pill grew by one cell (44px)
        // from its 408px seven-cell size. The vertical split stays literal
        // - a 4px seek track inside a 22px hit band, the 38px control row below
        // it - so the pill reads as a transport, not a band.
        //
        // One logical grid:
        //   vertical   9 (top pad) | 22 (seek band) | 9 (gap) | 40 (controls) | 12
        //   horizontal 14 (outer gutter) | cell | gaps | 14
        //   cells: play 38, time 104 (12.5px readout), volume 38, danmaku 38,
        //          comments 38, network 38, smooth 38, settings 38
        //   x: 0 | 50 | 166 | 210 | 254 | 298 | 342 | 386, content width 424
        // Every control keeps a 40px hit target around its 38px chip.
        // The bar slides down out of view when the chrome hides and fades with
        // it; every interactive element is gated on `chrome_shown` (disabled
        // while hidden), because `opacity: 0` alone keeps hit-testing.
        //
        // Zoom scrubber: right-clicking the seek bar morphs the SAME pill into
        // the 20-cell heat strip. Design: the opened bar is ~80% of the player
        // surface (clamped 720..1100px), 72px tall, 8px inner padding; the
        // window label sits top-left, the level indicator (`1/20 · 2/400`)
        // top-right, and the 34px cell row fills the width between them. A 2px
        // accent line with a 6px cap marks the playhead inside the window: at
        // `position_ms` while the pointer is away, exactly under the pointer
        // while it is on the strip (a `02:14` chip floats above the line), and
        // it eases back over 120ms after a release.
        // Width and height ease over 120ms, the normal controls fade out, the
        // cells fade in with a 40ms stagger.
        pill := Rectangle {
            x: (parent.width - self.width) / 2;
            y: root.chrome_shown ? root.pill_y : root.pill_y + 104px;
            // 80% of the window, floored at 720 and capped at 1100 so the cells
            // stay legible on a narrow window and do not sprawl on a 4K one.
            width: max(0px, min(parent.width - 24px, root.scrub_level > 0
                ? clamp(parent.width * 0.8, 720px, 1100px)
                : 452px));
            height: root.scrub_level > 0 ? 72px : 92px;
            border-radius: root.scrub_level > 0 ? 12px : 14px;
            background: #00000000;
            drop-shadow-color: AppTheme.player-shadow;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 5px;

            // The pill is the player's main chrome panel: the diffused backdrop
            // under a 63 % bar tint (bar-fill keeps its theme ink pair).
            GlassPanel {
                width: 100%;
                height: 100%;
                radius: parent.border-radius;
                tint: AppTheme.bar-fill.transparentize(0.35);
            }
            opacity: root.chrome_shown ? 1 : 0;
            animate y { duration: 220ms; easing: ease-out; }
            animate opacity { duration: 250ms; easing: ease-out; }
            animate width { duration: 120ms; easing: ease-out; }
            animate height { duration: 120ms; easing: ease-out; }
            animate border-radius { duration: 120ms; easing: ease-out; }

            // Cell width for the current bar width: 20 cells + 19px of gaps
            // inside the 8px padding. One number, used by the drawing, the
            // hit test and the playhead line.
            property <length> scrub_cells_w: max(0px, self.width - 16px);
            property <length> scrub_cell_w: max(1px, (self.scrub_cells_w - 19px) / 20);

            // ---- current-position line + progress fill ----
            // ONE position drives both the green fill and the 2px line: the
            // current playback fraction of the CURRENT window. While a drag is
            // in flight `scrub_frac` follows the pointer 1:1 (no lag, no
            // animation); on release the line holds the released target until
            // the seek lands. Hovering the strip moves nothing - the indicator
            // is never drawn under a pointer that has not pressed.
            property <length> scrub_head_x: 8px + self.scrub_cells_w * root.scrub_frac;

            property <bool> vol_open: false;
            property <int> vol_miss: 0;
            property <bool> vol_dragging: false;
            property <bool> dm_open: false;

            // Hover detector for the popovers: declared first so the controls
            // below stay on top of it. (The chrome itself no longer depends on
            // any hover flag - see `pointer_inside`.) Wheel here is the pill's
            // background: volume, same 2% step as the picture.
            pill_hover := TouchArea {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                enabled: root.chrome_shown;

                // Empty pill space (or the pill's own plate) is an outside click
                // for the popovers.
                clicked => {
                    pill.vol_open = false;
                    pill.dm_open = false;
                }

                scroll-event(event) => {
                    if (event.delta-y != 0) {
                        // Slint's delta-y is positive for a wheel-up notch.
                        root.wheel-volume(event.delta-y > 0);
                        return EventResult.accept;
                    }
                    EventResult.reject
                }
            }

            // ---- 缩放进度条  the 20-cell heat strip ----
            scrub_strip := Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                background: #00000000;
                opacity: root.scrub_level > 0 ? 1 : 0;
                animate opacity { duration: 140ms; easing: ease-out; }

                // Window label: `00:00 – 06:15`, top-left inside the 8px pad.
                Text {
                    x: 8px;
                    y: 8px;
                    width: max(0px, parent.width - 220px);
                    height: 16px;
                    text: root.scrub_window_text;
                    // Theme-aware: the pill's bar-fill follows the theme, so
                    // player-text-dim (sized for the dark chrome) washes out
                    // on the light plate.
                    color: AppTheme.text-dim;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                // Level indicator: `1/20 · 2/400`, top-right.
                Text {
                    x: max(0px, parent.width - 8px - 200px);
                    y: 8px;
                    width: min(200px, max(0px, parent.width - 16px));
                    height: 16px;
                    text: root.scrub_level_text;
                    color: AppTheme.text-dim;
                    font-size: 10px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }

                // 20 cells: they stretch with the bar (cells ~44px wide on a
                // 900px window), 34px tall, 1px gap, 8px inner padding. Each
                // cell is the dark track with a green PROGRESS slice clipped
                // inside it: the strip reads as one continuous progress fill
                // that keeps the cell structure and its 1px gaps.
                cell_row := Rectangle {
                    x: 8px;
                    y: 30px;
                    width: max(0px, parent.width - 16px);
                    height: 34px;
                    background: #00000000;

                    for i in 20 : Rectangle {
                        x: i * (pill.scrub_cell_w + 1px);
                        y: 0;
                        width: pill.scrub_cell_w;
                        height: parent.height;
                        border-radius: 3px;
                        background: AppTheme.player-track;
                        opacity: root.scrub_level > 0 ? 1 : 0;
                        animate opacity { duration: 120ms; delay: 40ms * i; easing: ease-out; }

                        // Progress inside this cell: its own width, clamped to
                        // the cell, so the fill clips at every 1px gap and never
                        // bleeds into the next cell.
                        Rectangle {
                            x: 0;
                            y: 0;
                            width: clamp(pill.scrub_cells_w * root.scrub_frac
                                - i * (pill.scrub_cell_w + 1px), 0px, pill.scrub_cell_w);
                            height: 100%;
                            border-radius: 3px;
                            background: AppTheme.player-progress;
                        }
                    }
                }

                // Playhead: a 2px white line across the cell row at the current
                // progress, with a 6px cap on top and a dark halo behind it so
                // it reads on both the green fill and the dark track.
                if root.scrub_level > 0 : Rectangle {
                    x: pill.scrub_head_x - 3px;
                    y: cell_row.y - 5px;
                    width: 6px;
                    height: cell_row.height + 10px;
                    border-radius: 3px;
                    background: AppTheme.player-shadow;
                }

                if root.scrub_level > 0 : Rectangle {
                    x: pill.scrub_head_x - 1px;
                    y: cell_row.y - 4px;
                    width: 2px;
                    height: cell_row.height + 8px;
                    border-radius: 1px;
                    background: AppTheme.player-fg-strong;
                }

                // 6px cap on the line's top end.
                if root.scrub_level > 0 : Rectangle {
                    x: pill.scrub_head_x - 3px;
                    y: cell_row.y - 4px;
                    width: 6px;
                    height: 4px;
                    border-radius: 2px;
                    background: AppTheme.player-fg-strong;
                }

                // Drag readout: the preview time, floating just above the pill.
                // Shown only while the pointer is DOWN (the fill and the line
                // follow it); the window label at the top-left keeps showing the
                // range, so both are readable at once. The chip is clamped to
                // the pill's own 8px gutters, so it never leaves the strip.
                if root.scrub_dragging : GlassPanel {
                    x: clamp(pill.scrub_head_x - self.width / 2, 8px,
                        max(8px, parent.width - 8px - self.width));
                    y: -28px;
                    width: pointer_label.preferred-width + 14px;
                    height: 20px;
                    border-radius: 5px;
                    background: AppTheme.player-menu;
                    border-width: 1px;
                    border-color: AppTheme.player-menu-border;
                    drop-shadow-color: AppTheme.player-shadow;
                    drop-shadow-blur: 10px;
                    drop-shadow-offset-y: 3px;

                    pointer_label := Text {
                        x: 7px;
                        width: max(0px, parent.width - 14px);
                        height: 100%;
                        text: root.clock(root.scrub_preview_ms);
                        color: AppTheme.player-fg-strong;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                // The whole strip is the seek surface: press anywhere and drag
                // horizontally for a continuous absolute seek PREVIEW. The fill,
                // the line and the time chip follow the pointer 1:1 while the
                // button is down; the single `seek()` is issued on release.
                // Right-click steps one level out (level 1 -> back to the
                // toolbar); double-click a cell dives one level in on that
                // cell's slice.
                scrub_area := TouchArea {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 100%;
                    enabled: root.chrome_shown && root.scrub_level > 0;

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.right) {
                            if (event.kind == PointerEventKind.down) {
                                root.scrub-zoom-out();
                                return EventResult.accept;
                            }
                            return EventResult.reject;
                        }
                        // `button` is `Other` on a move (see PanelSlider).
                        if (event.kind != PointerEventKind.move && event.button != PointerEventButton.left) {
                            return EventResult.reject;
                        }
                        if (event.kind == PointerEventKind.down) {
                            root.scrub_settling = false;
                            root.scrub_dragging = true;
                            root.scrub_drag_ms = root.scrub-ms-at(self.mouse-x, self.width);
                            EventResult.accept
                        } else if (event.kind == PointerEventKind.move) {
                            if (root.scrub_dragging) {
                                root.scrub_drag_ms = root.scrub-ms-at(self.mouse-x, self.width);
                            }
                            EventResult.accept
                        } else if (event.kind == PointerEventKind.up) {
                            if (root.scrub_dragging) {
                                root.scrub_drag_ms = root.scrub-ms-at(self.mouse-x, self.width);
                                root.scrub_dragging = false;
                                // Hold the released target on the strip until
                                // the new position lands.
                                root.scrub_settle_ms = root.scrub_drag_ms;
                                root.scrub_settling = true;
                                root.seek(root.scrub_drag_ms);
                            }
                            EventResult.accept
                        } else {
                            // Cancel (pointer lost): drop the preview, no seek.
                            root.scrub_dragging = false;
                            EventResult.accept
                        }
                    }

                    double-clicked => {
                        root.scrub-zoom-in(root.scrub-cell-at(self.mouse-x, self.width, pill.scrub_cell_w));
                    }
                }
            }

            // ---- top band: the seek bar ----
            // A 22px hit band around a 4px track: grabbing and dragging it is
            // easy without making the bar itself heavy. The band's centre is
            // the old 16px band's centre, so the visual bar has not moved.
            seek_band := Rectangle {
                x: 14px;
                y: 9px;
                width: max(0px, parent.width - 28px);
                height: 22px;
                background: #00000000;
                opacity: root.scrub_level > 0 ? 0 : 1;
                animate opacity { duration: 120ms; easing: ease-out; }

                track := Rectangle {
                    x: 0;
                    width: 100%;
                    height: 4px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 2px;
                    background: AppTheme.player-track;
                }

                Rectangle {
                    x: track.x;
                    y: track.y;
                    width: track.width;
                    height: track.height;
                    clip: true;
                    visible: root.density_on && root.density_buckets.length > 0;
                    background: #00000000;

                    for b[i] in root.density_buckets : Rectangle {
                        x: track.width * i / root.density_buckets.length;
                        width: max(1px, track.width / root.density_buckets.length);
                        height: track.height;
                        background: AppTheme.accent;
                        // Only where danmaku actually exists, capped well below
                        // the fill's own opacity: a 0.15 floor over every bucket
                        // tinted the whole track and made the played/unplayed
                        // split unreadable.
                        opacity: b > 0 ? 0.12 + 0.55 * b : 0;
                    }
                }

                progress_fill := Rectangle {
                    x: track.x;
                    y: track.y;
                    height: track.height;
                    border-radius: track.border-radius;
                    background: AppTheme.accent;
                    width: track.width * (root.shown_ms / max(1, root.duration_ms));
                }

                // 6px accent halo, only while the button is down.
                Rectangle {
                    x: progress_fill.x + progress_fill.width - self.width / 2;
                    y: (parent.height - self.height) / 2;
                    width: root.dragging ? 22px : 0px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: AppTheme.accent.transparentize(0.72);
                    opacity: root.dragging ? 1 : 0;
                    animate width { duration: 120ms; easing: ease-out; }
                    animate opacity { duration: 120ms; easing: ease-out; }
                }

                // Knob: 8px at rest, 10px while dragging. Its x tracks the
                // PREVIEW fraction (`shown_ms`), so it follows the pointer.
                Rectangle {
                    x: progress_fill.x + progress_fill.width - self.width / 2;
                    y: (parent.height - self.height) / 2;
                    width: root.dragging ? 10px : 8px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: AppTheme.player-knob;
                    opacity: progress_area.has-hover || root.dragging ? 1 : 0;
                    animate width { duration: 120ms; easing: ease-out; }
                    animate opacity { duration: 120ms; easing: ease-out; }
                }

                progress_area := TouchArea {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 100%;
                    // Hidden chrome must not eat the drag; neither must the
                    // morphed-away toolbar (the strip owns the pointer then).
                    enabled: root.chrome_shown && root.scrub_level == 0;

                    // One gesture, one seek. Down only starts the PREVIEW; every
                    // move writes `drag_ms` (fill/knob/bubble/readout follow at
                    // pointer rate, the position is untouched); the single
                    // `seek()` goes out on Up. A plain click is the same path -
                    // it jumps to the pressed point on release.
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.right) {
                            // Right-click the seek bar: open the zoom scrubber.
                            if (event.kind == PointerEventKind.down) {
                                root.scrub-open();
                                return EventResult.accept;
                            }
                            return EventResult.reject;
                        }
                        // `button` is `Other` on a move; the old left-only
                        // gate rejected every drag move, which is why the fill
                        // only jumped on down/up. `root.dragging` gates it now.
                        if (event.kind != PointerEventKind.move && event.button != PointerEventButton.left) {
                            return EventResult.reject;
                        }
                        if (event.kind == PointerEventKind.down) {
                            root.dragging = true;
                            // The track is the coordinate space, not the padded
                            // band around it: mouse-x is relative to this area,
                            // and `track.x` is its inset inside it.
                            root.drag_ms = root.ms-at(self.mouse-x - track.x, track.width);
                            EventResult.accept
                        } else if (event.kind == PointerEventKind.move) {
                            if (root.dragging) {
                                root.drag_ms = root.ms-at(self.mouse-x - track.x, track.width);
                                root.qa_seek_moves = root.qa_seek_moves + 1;
                            }
                            EventResult.accept
                        } else if (event.kind == PointerEventKind.up) {
                            if (root.dragging) {
                                root.drag_ms = root.ms-at(self.mouse-x - track.x, track.width);
                                root.dragging = false;
                                root.seek(root.drag_ms);
                            }
                            EventResult.accept
                        } else {
                            // Cancel (pointer lost / area disabled mid-drag):
                            // never leave the drag stuck - end it and apply the
                            // last position the pointer showed.
                            if (root.dragging) {
                                root.dragging = false;
                                root.seek(root.drag_ms);
                            }
                            EventResult.accept
                        }
                    }
                }
            }

            // ---- drag time bubble: the target time, above the knob ----
            // One surface in the pill's own language; it exists only while the
            // button is down and rides the preview fraction 1:1.
            if root.dragging && root.scrub_level == 0 : GlassPanel {
                x: max(4px, min(pill.width - self.width - 4px,
                    seek_band.x + seek_band.width
                        * clamp(root.shown_ms / max(1, root.duration_ms), 0, 1)
                        - self.width / 2));
                y: seek_band.y - self.height - 2px;
                width: 58px;
                height: 22px;
                radius: 7px;
                tint: AppTheme.bar-fill.transparentize(0.35);
                shadow: true;
                shadow-color: AppTheme.player-shadow;
                shadow-blur: 10px;
                shadow-y: 3px;

                Text {
                    text: root.fmt-ms(root.drag_ms);
                    color: AppTheme.text;
                    font-size: 11px;
                    font-weight: 600;
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // ---- bottom: the control row ----
            // A TouchArea, not a Rectangle: it paints nothing and tracks the
            // pointer over the whole row - every cell plus the gaps.
            controls_row := TouchArea {
                x: 14px;
                y: 40px;
                width: max(0px, parent.width - 28px);
                height: 40px;
                enabled: root.chrome_shown && root.scrub_level == 0;
                opacity: root.scrub_level > 0 ? 0 : 1;
                animate opacity { duration: 120ms; easing: ease-out; }

                // play / pause - drawn, never a glyph.
                Rectangle {
                    x: 0;
                    y: 1px;
                    width: 38px;
                    height: 38px;
                    border-radius: 10px;
                    background: play_area.has-hover ? AppTheme.accent-hover : AppTheme.accent;
                    animate background { duration: 120ms; easing: ease-out; }

                    if root.playing : Rectangle {
                        x: (parent.width - 8px) / 2;
                        y: (parent.height - 10px) / 2;
                        width: 8px;
                        height: 10px;
                        background: #00000000;
                        Rectangle { x: 0; width: 2.6px; height: 10px; border-radius: 1px; background: AppTheme.accent-fg; }
                        Rectangle { x: 5.4px; width: 2.6px; height: 10px; border-radius: 1px; background: AppTheme.accent-fg; }
                    }

                    if !root.playing : Path {
                        x: (parent.width - 9px) / 2 + 1px;
                        y: (parent.height - 10px) / 2;
                        width: 9px;
                        height: 10px;
                        viewbox-width: 10;
                        viewbox-height: 11;
                        commands: "M 0.75 0.75 L 9.25 5.5 L 0.75 10.25 Z";
                        fill: AppTheme.accent-fg;
                    }

                    play_area := TouchArea {
                        enabled: root.chrome_shown && root.scrub_level == 0;
                        clicked => {
                            root.scrub-close();
                            root.toggle_pause();
                        }
                        // Wheel over a button is not the background.
                        scroll-event(event) => { EventResult.accept }
                    }
                }

                // 当前时间 / 总时长 
                Text {
                    x: 50px;
                    y: 1px;
                    width: 104px;
                    height: 38px;
                    text: (root.dragging ? root.fmt-ms(root.drag_ms) : root.time_current) + " / " + root.time_total;
                    color: AppTheme.player-time;
                    font-size: 12.5px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                // 音量: ONE button. Click toggles mute; the popover above it
                // carries the slider (see below).
                // 音量: click = mute (unchanged); the vertical level popover
                // opens on hover and stays while the pointer is on it.
                vol_icon := PillIcon {
                    x: 166px;
                    y: 1px;
                    width: 38px;
                    height: 38px;
                    border-radius: 10px;
                    kind: root.muted ? 1 : 0;
                    active: root.muted;
                    // The speaker stroke box is 13.9px wide inside its 16px
                    // viewbox (body 2.4..8.4 + waves to 14.9, plus the 0.7px
                    // half-stroke), so its optical centre sits 0.65px RIGHT of
                    // the box centre. Pull the mark back by exactly that, so
                    // the glyph's own bbox centres on the 38px hit area
                    // (measured delta <= 0.2px).
                    mark-dx: -0.65px;
                    interactive: root.chrome_shown && root.scrub_level == 0;
                    clicked => { root.toggle_mute(); }
                }

                // 弹幕: ONE button - click opens/toggles the popover, and the
                // popover's own 弹幕开/关 switch owns the on/off state (the
                // keyboard shortcut D still toggles it directly).
                dm_icon := PillIcon {
                    x: 210px;
                    y: 1px;
                    width: 38px;
                    height: 38px;
                    border-radius: 10px;
                    kind: root.danmaku_on ? 2 : 3;
                    active: pill.dm_open;
                    interactive: root.chrome_shown && root.scrub_level == 0;
                    clicked => {
                        if (pill.dm_open) {
                            pill.dm_open = false;
                        } else {
                            pill.vol_open = false;
                            root.quality_expanded = false;
                            pill.dm_open = true;
                        }
                    }
                }

                // 评论 (right panel, 评论 tab)
                PillIcon {
                    x: 254px;
                    y: 1px;
                    width: 38px;
                    height: 38px;
                    border-radius: 10px;
                    kind: 4;
                    active: root.right_panel != 0 && root.right_tab == 1;
                    interactive: root.chrome_shown && root.scrub_level == 0;
                    clicked => { root.set-right(1); }
                }

                // 性能 (right panel, 性能 tab)
                PillIcon {
                    x: 298px;
                    y: 1px;
                    width: 38px;
                    height: 38px;
                    border-radius: 10px;
                    kind: 5;
                    active: root.right_panel != 0 && root.right_tab == 2;
                    interactive: root.chrome_shown && root.scrub_level == 0;
                    clicked => { root.set-right(2); }
                }

                // 平滑: frame interpolation. Click cycles 关闭 -> 混合 ->
                // 块匹配 -> OFA in Rust (which persists the choice and skips
                // the OFA step when its runtime is missing); the badge carries
                // the current mode, the tooltip above the pill spells it out.
                interp_icon := InterpIcon {
                    x: 342px;
                    y: 1px;
                    width: 38px;
                    height: 38px;
                    level: root.interp_level;
                    interactive: root.chrome_shown && root.scrub_level == 0;
                    clicked => { root.interp_cycle(); }
                }

                // 设置 (right panel, 设置 tab)
                PillIcon {
                    x: 386px;
                    y: 1px;
                    width: 38px;
                    height: 38px;
                    border-radius: 10px;
                    kind: 6;
                    active: root.right_panel != 0 && root.right_tab == 3;
                    interactive: root.chrome_shown && root.scrub_level == 0;
                    clicked => { root.set-right(3); }
                }

                // 全屏 is NOT a pill cell any more (the user asked for it to be
                // removed). It stays reachable by DOUBLE-CLICKING the picture:
                // see `video_area.double-clicked => root.toggle_fullscreen()`.
                // The keyboard shortcut (F8 / Esc to leave) is unchanged.
            }

            // ---- 平滑 tooltip (one line, above the pill) ----
            // Raised only while the 平滑 cell itself is hovered. It is a
            // Rectangle, not a TouchArea: it can never steal the pointer (and
            // so the hover) from the cell that shows it. Its x is centred on
            // that cell and clamped to the pill's own 6px margin; y -30px sits
            // clear of the 16px seek band. The plate is the popovers' own
            // surface (menu fill, 1px hairline, soft shadow).
            interp_tip_plate := Rectangle {
                property <bool> shown: interp_icon.hot
                    && root.chrome_shown && root.scrub_level == 0;
                visible: self.shown;
                width: interp_tip_label.preferred-width + 16px;
                height: 22px;
                x: clamp(controls_row.x + interp_icon.x + interp_icon.width / 2
                    - self.width / 2, 6px,
                    max(6px, pill.width - 6px - self.width));
                y: -30px;
                border-radius: 6px;
                background: AppTheme.player-menu;
                border-width: 1px;
                border-color: AppTheme.player-menu-border;
                drop-shadow-color: AppTheme.player-shadow;
                drop-shadow-blur: 10px;
                drop-shadow-offset-y: 3px;

                interp_tip_label := Text {
                    x: 8px;
                    width: max(0px, parent.width - 16px);
                    height: 100%;
                    text: root.interp_tip;
                    color: AppTheme.player-text;
                    font-size: 10.5px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            // ---- 音量 popover (above the button) ----
            // A vertical iOS-style level: 64 x 168 plate, a 12 x 128 track filled
            // from the BOTTOM, an 18px thumb that appears on hover/drag, a drawn
            // speaker at the bottom, and no numbers at all.
            //
            // The button's click stays the mute toggle (unchanged). The plate
            // opens on HOVER over the button and stays up while the pointer is on
            // it: the poll below ORs the plate's own hover with the track area's
            // (`vol_area.hot`) because a sibling TouchArea stops seeing hover once
            // the slider's area owns the pointer - that was the bug that closed
            // the old popover mid-drag. `vol_dragging` holds it open even when the
            // pointer is dragged outside the track.
            vol_plate := GlassPanel {
                property <bool> shown: (pill.vol_open || root.qa_hold_popovers) && root.chrome_shown && root.scrub_level == 0;
                // Fade out, then stop hit-testing.
                visible: self.shown || self.opacity > 0;
                x: 153px;
                y: -self.height - 8px + (self.shown ? 0px : 6px);
                width: 64px;
                height: 168px;
                radius: 12px;
                tint: AppTheme.player-menu-tint;
                edge: AppTheme.player-menu-border;
                fill-image: true;
                shadow: true;
                shadow-color: AppTheme.player-shadow;
                shadow-blur: 14px;
                shadow-y: 4px;
                opacity: self.shown ? 1 : 0;
                animate y { duration: 180ms; easing: ease-out; }
                animate opacity { duration: 180ms; easing: ease-out; }

                // Pointer on the plate itself (keeps the poll alive).
                vol_pop_area := TouchArea {
                    width: 100%;
                    height: 100%;
                    enabled: vol_plate.shown;
                    scroll-event(event) => { EventResult.accept }
                }

                // Track: 12 x 128, fully rounded, 12px below the plate top.
                vol_track := Rectangle {
                    x: (parent.width - 12px) / 2;
                    y: 12px;
                    width: 12px;
                    height: 128px;
                    border-radius: 6px;
                    background: AppTheme.player-track;
                }

                // Fill: the same shape, grown from the BOTTOM edge upwards.
                vol_fill := Rectangle {
                    x: vol_track.x;
                    width: vol_track.width;
                    height: vol_track.height * clamp(root.volume, 0, 100) / 100;
                    y: vol_track.y + vol_track.height - self.height;
                    border-radius: 6px;
                    background: root.muted ? AppTheme.player-muted-fill : AppTheme.accent;
                }

                // Thumb: 18px, sitting on the fill's top edge, hidden at rest.
                Rectangle {
                    x: (parent.width - 18px) / 2;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    y: clamp(vol_track.y + vol_track.height - vol_fill.height - 9px,
                        vol_track.y - 3px, vol_track.y + vol_track.height - 6px);
                    background: AppTheme.player-knob;
                    opacity: vol_area.has-hover || vol_area.pressed || pill.vol_dragging ? 1 : 0;
                    animate opacity { duration: 120ms; easing: ease-out; }
                }

                // Drawn speaker at the bottom, inside the plate and clear of the
                // track: the same mark as the pill button, slashed while muted.
                Path {
                    x: (parent.width - 16px) / 2;
                    y: 146px;
                    width: 16px;
                    height: 12px;
                    viewbox-width: 16;
                    viewbox-height: 12;
                    commands: root.muted
                        ? "M 1.4 4.2 L 4.2 4.2 L 7.4 1.2 L 7.4 10.8 L 4.2 7.8 L 1.4 7.8 Z M 10.2 3.4 L 14.2 8.6 M 14.2 3.4 L 10.2 8.6"
                        : "M 1.4 4.2 L 4.2 4.2 L 7.4 1.2 L 7.4 10.8 L 4.2 7.8 L 1.4 7.8 Z M 9.6 3.9 C 10.9 4.9 10.9 7.1 9.6 8.1 M 11.9 1.9 C 14.4 3.8 14.4 8.2 11.9 10.1";
                    fill: #00000000;
                    stroke: AppTheme.player-text-soft;
                    stroke-width: 1.3px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                }

                // Interaction: a 32px hit band over the 12px track. Press jumps to
                // that level and starts the drag; moving vertically follows the
                // pointer; release ends it. The first press also unmutes.
                vol_area := TouchArea {
                    x: (parent.width - 32px) / 2;
                    y: 12px;
                    width: 32px;
                    height: 128px;
                    enabled: vol_plate.shown;
                    scroll-event(event) => { EventResult.accept }

                    pointer-event(event) => {
                        // Move events carry `button: Other`; the press/release
                        // carry the real button. `self.pressed` is the drag gate.
                        if (event.kind != PointerEventKind.move && event.button != PointerEventButton.left) {
                            return EventResult.reject;
                        }
                        if (event.kind == PointerEventKind.down) {
                            // `muted` is an `in` property: unmute goes through
                            // Rust once, on the press (never per move).
                            if (root.muted) {
                                root.toggle_mute();
                            }
                            pill.vol_dragging = true;
                            root.volume = root.volume-level-at(self.mouse-y);
                            root.volume_changed(root.volume);
                            EventResult.accept
                        } else if (event.kind == PointerEventKind.move) {
                            if (self.pressed) {
                                root.volume = root.volume-level-at(self.mouse-y);
                                root.volume_changed(root.volume);
                                root.qa_vol_moves = root.qa_vol_moves + 1;
                            }
                            EventResult.accept
                        } else {
                            pill.vol_dragging = false;
                            EventResult.accept
                        }
                    }
                }
            }

            // ---- 弹幕 popover (above the button) ----
            // Every danmaku parameter that used to live in the 设置 panel's 弹幕
            // section: on/off, 透明度  字号, 速度, 显示区域, 类型屏蔽, the
            // 发送弹幕 field and 分布密度. The 弹幕列表 row is gone with the
            // bottom strip. Fixed 300x276 grid of absolute rows, like the 二级
            // panel, so the sliders never sit inside a scroll gesture.
            //
            // CLICK-to-open (the pill button toggles it): hover-open could not
            // survive the pointer leaving the button, which made every control
            // inside unusable. It now closes only on an explicit action - the
            // button again, a click outside, Esc, or another popover opening -
            // so nothing inside it can dismiss it while a slider is dragged.
            GlassPanel {
                property <bool> shown: (pill.dm_open || root.qa_hold_popovers) && root.chrome_shown && root.scrub_level == 0;
                // Fade out, then stop hit-testing: a closed popover must not
                // sit invisibly over the picture.
                visible: self.shown || self.opacity > 0;
                x: 54px;
                y: -self.height - 8px + (self.shown ? 0px : 6px);
                width: 300px;
                height: 276px;
                radius: 10px;
                tint: AppTheme.player-menu-tint;
                edge: AppTheme.player-menu-border;
                fill-image: true;
                shadow: true;
                shadow-color: #00000073;
                shadow-blur: 14px;
                shadow-y: 4px;
                opacity: self.shown ? 1 : 0;
                animate y { duration: 160ms; easing: ease-out; }
                animate opacity { duration: 160ms; easing: ease-out; }

                dm_pop_area := TouchArea {
                    width: 100%;
                    height: 100%;
                    enabled: parent.shown;
                    scroll-event(event) => { EventResult.accept }
                }

                Text {
                    x: 12px;
                    y: 8px;
                    width: 140px;
                    height: 24px;
                    text: "弹幕设置";
                    color: AppTheme.player-text-bright;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                // on / off
                Rectangle {
                    x: 228px;
                    y: 8px;
                    width: 60px;
                    height: 24px;
                    border-radius: 12px;
                    background: root.danmaku_on
                        ? AppTheme.player-on
                        : (dm_toggle.has-hover ? AppTheme.player-menu-hover : AppTheme.player-btn);
                    animate background { duration: 120ms; easing: ease-out; }

                    Text {
                        width: 100%;
                        height: 100%;
                        text: root.danmaku_on ? "弹幕开" : "弹幕关";
                        color: root.danmaku_on ? AppTheme.player-fg-strong : AppTheme.player-text-dim;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    dm_toggle := TouchArea {
                        clicked => {
                            root.danmaku_on = !root.danmaku_on;
                            root.danmaku_text = root.danmaku_on ? "弹幕开" : "弹幕关";
                        }
                    }
                }

                // 透明度 
                Text {
                    x: 12px;
                    y: 40px;
                    width: 56px;
                    height: 26px;
                    text: "透明度";
                    color: AppTheme.player-text-dim;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                PanelSlider {
                    x: 72px;
                    y: 40px;
                    width: 172px;
                    height: 26px;
                    value: root.danmaku_opacity;
                    live(v) => { root.danmaku_opacity = v; }
                    commit(v) => {
                        root.danmaku_opacity = v;
                        root.danmaku_settings_changed(root.danmaku_opacity, root.danmaku_font);
                    }
                }
                Text {
                    x: 248px;
                    y: 40px;
                    width: 40px;
                    height: 26px;
                    text: root.danmaku_opacity_text + "%";
                    color: AppTheme.player-text-soft;
                    font-size: 11px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }

                // 字号
                Text {
                    x: 12px;
                    y: 70px;
                    width: 56px;
                    height: 26px;
                    text: "字号";
                    color: AppTheme.player-text-dim;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                for f[index] in [0, 1, 2] : ChipButton {
                    x: 72px + index * 74px;
                    y: 70px;
                    width: 68px;
                    on: root.danmaku_font == f;
                    text: root.font-label(f);
                    clicked => {
                        root.danmaku_font = f;
                        root.danmaku_settings_changed(root.danmaku_opacity, f);
                    }
                }

                // 速度
                Text {
                    x: 12px;
                    y: 100px;
                    width: 56px;
                    height: 26px;
                    text: "速度";
                    color: AppTheme.player-text-dim;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                PanelSlider {
                    x: 72px;
                    y: 100px;
                    width: 172px;
                    height: 26px;
                    value: (root.danmaku_speed - 50) / 150;
                    live(v) => { root.danmaku_speed = round(clamp(50 + v * 150, 50, 200)); }
                    commit(v) => {
                        root.danmaku_speed = round(clamp(50 + v * 150, 50, 200));
                        root.danmaku_speed_changed(root.danmaku_speed);
                    }
                }
                Text {
                    x: 248px;
                    y: 100px;
                    width: 40px;
                    height: 26px;
                    text: "" + root.danmaku_speed + "%";
                    color: AppTheme.player-text-soft;
                    font-size: 11px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }

                // 显示区域
                Text {
                    x: 12px;
                    y: 130px;
                    width: 56px;
                    height: 26px;
                    text: "区域";
                    color: AppTheme.player-text-dim;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                for a[index] in [25, 50, 75, 100] : ChipButton {
                    x: 72px + index * 55.5px;
                    y: 130px;
                    width: 50.5px;
                    on: root.danmaku_area == a;
                    text: a + "%";
                    clicked => {
                        root.danmaku_area = a;
                        root.danmaku_area_changed(a);
                    }
                }

                // 类型屏蔽
                Text {
                    x: 12px;
                    y: 160px;
                    width: 56px;
                    height: 26px;
                    text: "屏蔽";
                    color: AppTheme.player-text-dim;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                ChipButton {
                    x: 72px;
                    y: 160px;
                    width: 68px;
                    text: "滚动";
                    on: root.block_scroll;
                    clicked => {
                        root.block_scroll = !root.block_scroll;
                        root.danmaku_type_block_changed(root.block_scroll, root.block_top, root.block_bottom);
                    }
                }
                ChipButton {
                    x: 146px;
                    y: 160px;
                    width: 68px;
                    text: "顶部";
                    on: root.block_top;
                    clicked => {
                        root.block_top = !root.block_top;
                        root.danmaku_type_block_changed(root.block_scroll, root.block_top, root.block_bottom);
                    }
                }
                ChipButton {
                    x: 220px;
                    y: 160px;
                    width: 68px;
                    text: "底部";
                    on: root.block_bottom;
                    clicked => {
                        root.block_bottom = !root.block_bottom;
                        root.danmaku_type_block_changed(root.block_scroll, root.block_top, root.block_bottom);
                    }
                }

                Rectangle {
                    x: 12px;
                    y: 192px;
                    width: 276px;
                    height: 1px;
                    background: AppTheme.player-menu-border;
                }

                // 发送弹幕 
                Rectangle {
                    x: 12px;
                    y: 196px;
                    width: 216px;
                    height: 28px;
                    border-radius: 7px;
                    background: AppTheme.player-btn;

                    dm_input := TextInput {
                        x: 10px;
                        y: 0;
                        width: max(0px, parent.width - 20px);
                        height: 100%;
                        enabled: root.chrome_shown;
                        text <=> root.danmaku_input;
                        color: AppTheme.player-text;
                        font-size: 11px;
                        single-line: true;
                        vertical-alignment: center;
                        selection-background-color: AppTheme.accent;
                        selection-foreground-color: AppTheme.accent-fg;
                        accepted => { root.send_danmaku(root.danmaku_input); }
                    }

                    Text {
                        x: 10px;
                        y: 0;
                        width: max(0px, parent.width - 20px);
                        height: 100%;
                        text: "发送弹幕";
                        color: AppTheme.player-text-dim;
                        font-size: 11px;
                        vertical-alignment: center;
                        visible: root.danmaku_input == "" && !dm_input.has-focus;
                    }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 7px;
                        background: #00000000;
                        border-width: 1px;
                        border-color: dm_input.has-focus ? AppTheme.accent : AppTheme.player-menu-border;
                        animate border-color { duration: 140ms; easing: ease-out; }
                    }
                }

                PlayerBtn {
                    x: 234px;
                    y: 196px;
                    width: 54px;
                    height: 28px;
                    corner: 7px;
                    text: "发送";
                    base: AppTheme.accent;
                    hover: AppTheme.accent-hover;
                    text-color: AppTheme.accent-fg;
                    interactive: root.chrome_shown;
                    clicked => { root.send_danmaku(root.danmaku_input); }
                }

                // send status (the real message from the worker, when there is one)
                Text {
                    x: 12px;
                    y: 226px;
                    width: 276px;
                    height: 14px;
                    text: root.send_status;
                    color: AppTheme.player-text-status;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                // 分布密度: the density curve drawn inside the seek track.
                Text {
                    x: 12px;
                    y: 242px;
                    width: 120px;
                    height: 26px;
                    text: "分布密度";
                    color: AppTheme.player-text-dim;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                ChipButton {
                    x: 234px;
                    y: 242px;
                    width: 54px;
                    text: root.density_on ? "开" : "关";
                    on: root.density_on;
                    clicked => { root.density_on = !root.density_on; }
                }
            }

            // 音量 hover keep-alive. Opens on the first 60ms poll over the
            // button; closes only after FIVE missed polls (300ms) with the
            // pointer on neither the button nor the plate - that grace is what
            // lets the pointer cross the 8px gap. "On the plate" is the plate's
            // own area OR the track's (`vol_area.hot`), because the track's
            // TouchArea takes hover away from its sibling area; `vol_dragging`
            // holds it open while the slider is being dragged.
            //
            // 弹幕 and 画质 are click-opened and need no poll: nothing inside
            // them can dismiss them while a slider or a row is in use.
            Timer {
                interval: 60ms;
                running: root.chrome_shown && (pill.vol_open || vol_icon.hot);
                triggered => {
                    if (!pill.vol_open) {
                        pill.vol_dragging = false;
                    }
                    if (pill.vol_dragging) {
                        pill.vol_miss = 0;
                        return;
                    }
                    if (vol_icon.hot || vol_pop_area.has-hover || vol_area.has-hover) {
                        pill.vol_miss = 0;
                        if (!pill.vol_open) {
                            pill.dm_open = false;
                            root.quality_expanded = false;
                        }
                        pill.vol_open = true;
                    } else if (pill.vol_open) {
                        if (pill.vol_miss >= 5) {
                            pill.vol_open = false;
                        } else {
                            pill.vol_miss = pill.vol_miss + 1;
                        }
                    }
                }
            }
        }

        // ===================== 滚轮音量 HUD =====================
        // A 24 x 140 capsule near the video's right edge (16px in, vertically
        // centred): `player-menu` + hairline + the floating-chrome shadow, a
        // 6px track filled from the BOTTOM to the current level, and a 16px
        // drawn speaker at the bottom. No text and no numbers - the position of
        // the fill is the reading. It is painted from plain Rectangles/Paths
        // with no TouchArea at all, so it is pointer-transparent and can never
        // steal a click or the wheel.
        GlassPanel {
            x: parent.width - 40px;
            y: (parent.height - 140px) / 2;
            width: 24px;
            height: 140px;
            radius: 12px;
            tint: AppTheme.player-menu-tint;
            edge: AppTheme.player-menu-border;
            shadow: true;
            shadow-color: AppTheme.player-shadow;
            shadow-blur: 14px;
            shadow-y: 4px;
            opacity: root.wheel_hud_on ? 1 : 0;
            animate opacity {
                duration: root.wheel_hud_on ? 140ms : 240ms;
                easing: ease-out;
            }

            hud_track := Rectangle {
                x: (parent.width - 6px) / 2;
                y: 10px;
                width: 6px;
                height: 100px;
                border-radius: 3px;
                background: AppTheme.player-track;
            }

            // Fill grows from the BOTTOM edge to the volume level.
            Rectangle {
                x: hud_track.x;
                width: hud_track.width;
                height: hud_track.height * clamp(root.volume, 0, 100) / 100;
                y: hud_track.y + hud_track.height - self.height;
                border-radius: 3px;
                background: root.muted ? AppTheme.player-muted-fill : AppTheme.accent;
            }

            Path {
                x: (parent.width - 16px) / 2;
                y: 118px;
                width: 16px;
                height: 12px;
                viewbox-width: 16;
                viewbox-height: 12;
                commands: root.muted
                    ? "M 1.4 4.2 L 4.2 4.2 L 7.4 1.2 L 7.4 10.8 L 4.2 7.8 L 1.4 7.8 Z M 10.2 3.4 L 14.2 8.6 M 14.2 3.4 L 10.2 8.6"
                    : "M 1.4 4.2 L 4.2 4.2 L 7.4 1.2 L 7.4 10.8 L 4.2 7.8 L 1.4 7.8 Z M 9.6 3.9 C 10.9 4.9 10.9 7.1 9.6 8.1 M 11.9 1.9 C 14.4 3.8 14.4 8.2 11.9 10.1";
                fill: #00000000;
                stroke: AppTheme.player-text-soft;
                stroke-width: 1.3px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }

        // ===================== 提示条 (toast stack) =====================
        // Top-centre of the video area, 12px under the 44px title strip, so the
        // stack never covers the pill, its popovers or the buffering plate.
        // Three fixed slots (36px each with an 8px gap = 124px), newest on TOP:
        // a new message enters at slot 0 and pushes the older ones down. Fixed
        // slots are what makes the 200ms exit animatable - a model removal
        // would destroy the node.
        toast_stack := Rectangle {
            x: (parent.width - self.width) / 2;
            y: 56px;
            width: min(420px, max(0px, parent.width - 32px));
            height: 124px;
            background: #00000000;

            ToastView {
                slot_y: 0px;
                shown: root.toasts.length > 0;
                message: root.toast-text(0);
                kind: root.toast-kind(0);
                progress: clamp(root.toast_progress, 0, 1);
            }

            ToastView {
                slot_y: 44px;
                shown: root.toasts.length > 1;
                message: root.toast-text(1);
                kind: root.toast-kind(1);
                progress: clamp(root.toast_progress, 0, 1);
            }

            ToastView {
                slot_y: 88px;
                shown: root.toasts.length > 2;
                message: root.toast-text(2);
                kind: root.toast-kind(2);
                progress: clamp(root.toast_progress, 0, 1);
            }
        }
    }

    // The LEFT strip is gone. 视频信息 + 互动 now live in the right panel's
    // 信息 tab; `left_panel` / `left_panel_w` stay declared (inert) so src/main.rs
    // keeps compiling, and `reserve_l` is pinned to 0.
    // ===================== 右栏: 信息 / 评论 / 性能 / 设置 =====================
    // One strip, four contents behind a 40px tab row: 0 信息 (视频信息 + 互动,
    // the old left strip), 1 评论, 2 性能, 3 设置. `right_panel` is only
    // "is it open"; `right_tab` picks the body. Reserved mode: the strip
    // occupies the new space Rust added on the right edge, so the picture keeps
    // its size. Overlay mode (fullscreen): it hangs on the picture's right edge
    // and paints above it. The body slides 18px out of the edge and fades in
    // place (160ms) when the panel opens.
    Rectangle {
        x: root.width - root.right_w;
        y: 0;
        width: root.right_w;
        height: root.height;
        // One GlassPanel: the pre-blurred backdrop under the player's dark
        // tint, plus the hairline. Full height, so its radius is 0.
        background: #00000000;
        border-width: 0px;
        clip: true;

        GlassPanel {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            radius: 0px;
            tint: AppTheme.player-panel-tint;
            edge: AppTheme.player-menu-border;
            // The whole wallpaper, not a 360px crop of its centre: the strip is
            // then literally a window onto the same layer as the home window.
            fill-image: true;
        }

        right_strip_area := PanelHit { width: 100%; height: 100%; dismiss => { root.close-right(); } pass-scroll: true; }

        // 评论区 indeterminate loading sweep: a 3px accent bar sliding under the
        // list while a page is in flight. Declared outside the mode switch so
        // the phase keeps ticking while 性能 or 设置 is showing.
        Timer {
            interval: 24ms;
            running: root.comments_loading;
            triggered => { root.load_phase = Math.mod(root.load_phase + 0.035, 1.0); }
        }

        // 评论区 scroll gate countdown: 3 x 40ms = the 120ms tail after the last
        // `content-y` change. Lives outside the mode switch (the list itself is
        // inside a conditional) so a list that disappears mid-scroll can never
        // leave the per-row gate armed.
        Timer {
            interval: 40ms;
            running: root.comments_scroll_busy;
            triggered => {
                root.comments_scroll_ticks -= 1;
                if (root.comments_scroll_ticks <= 0) {
                    root.comments_scroll_busy = false;
                }
            }
        }

        Rectangle {
            x: root.right_panel != 0 ? 0px : 18px;
            y: 0;
            width: root.right_panel_w;
            height: 100%;
            background: #00000000;
            opacity: root.right_panel != 0 ? 1 : 0;
            animate x { duration: 160ms; easing: ease-out; }
            animate opacity { duration: 160ms; easing: ease-out; }

            VerticalLayout {
                spacing: 0px;

                // ---- 40px tab row: 信息 · 评论 · 性能 · 设置 ----
                // Four equal cells, one accent underline on the active tab, one
                // close button. The underline (not a filled chip) keeps the row
                // light while still reading as the panel's primary switch.
                Rectangle {
                    height: 40px;
                    background: #00000000;

                    HorizontalLayout {
                        x: 10px;
                        y: 0;
                        width: parent.width - 52px;
                        height: 40px;
                        spacing: 0px;

                        for tab_label[index] in ["信息", "评论", "性能", "设置"] : Rectangle {
                            width: 60px;
                            height: 40px;
                            background: #00000000;

                            Text {
                                width: 100%;
                                height: 100%;
                                text: tab_label;
                                // The player strip is dark in BOTH themes, so the
                                // tab inks are the player's own bright/dim pair
                                // (`AppTheme.text` would be #1a1a1a in light mode
                                // on a #1b1b22 plate - unreadable).
                                color: root.right_tab == index
                                    ? AppTheme.player-fg-strong
                                    : AppTheme.player-text-dim;
                                font-size: 12.5px;
                                font-weight: root.right_tab == index ? 600 : 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                animate color { duration: 120ms; easing: ease-out; }
                            }

                            if root.right_tab == index : Rectangle {
                                x: (parent.width - 22px) / 2;
                                y: parent.height - 2px;
                                width: 22px;
                                height: 2px;
                                border-radius: 1px;
                                background: AppTheme.accent;
                            }

                            tab_hit := PanelHit {
                                pass-scroll: true;
                                clicked => { root.select-right-tab(index); }
                                dismiss => { root.close-right(); }
                            }
                        }
                    }

                    MarkButton {
                        x: parent.width - 38px;
                        y: 7px;
                        width: 26px;
                        height: 26px;
                        kind: 2;
                        mark-size: 10px;
                        mark: AppTheme.player-text-bright;
                        hover-bg: AppTheme.player-menu-hover;
                        close-hover-bg: AppTheme.danger;
                        clicked => { root.close-right(); }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        width: 100%;
                        height: 1px;
                        background: AppTheme.player-menu-border;
                    }
                }

                // ================= 0 信息 =================
                // 视频信息 + 互动: the old LEFT strip's content, now the first tab.
                // Same header, same chips, same coin / fav sub-lists - only the
                // strip it lives in changed. Its 38px "视频信息" title row is gone:
                // the tab row already names the tab.
                if root.right_tab == 0 : Rectangle {
                    height: max(0px, parent.height - 40px);
                    background: #00000000;

                    // 信息 was the one tab with no scroller: the chips, the
                    // 互动 rows and the expanding coin / fav sub-lists can be
                    // taller than a short window, and the wheel did nothing.
                    // Content-height is the layout's own preferred height, so
                    // an expanded sub-list grows the scroll range immediately.
                    info_scroll := ScrollView {
                        vertical-stretch: 1;
                        content-height: info_body.preferred-height;
                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                        info_body := VerticalLayout {
                        spacing: 0px;
                        // ---- compact video info: cover, title, UP主  数据 ----
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 10px;

                            Rectangle {
                                width: 84px;
                                height: 48px;
                                border-radius: 6px;
                                background: AppTheme.player-btn;
                                clip: true;

                                if root.info_cover_ready : Image {
                                    width: 100%;
                                    height: 100%;
                                    source: root.info_cover;
                                    image-fit: cover;
                                }
                            }

                            VerticalLayout {
                                spacing: 2px;

                                Text {
                                    text: root.info_title;
                                    color: AppTheme.player-fg-strong;
                                    font-size: 12px;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                    height: 32px;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.info_owner;
                                    color: AppTheme.player-text-soft;
                                    font-size: 11px;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.info_stats;
                                    color: AppTheme.player-text-dim;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: AppTheme.player-menu-border;
                        }

                        // ---- 互动 ----
                        Rectangle {
                            height: 26px;

                            Text {
                                x: 12px;
                                y: 0;
                                width: max(0px, parent.width - 24px);
                                height: parent.height;
                                text: "互动";
                                color: AppTheme.player-text-dim;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 46px;
                            property <length> chip_w: max(0px, (self.width - 20px - 24px) / 5);

                            // 点赞
                            Rectangle {
                                x: 10px;
                                y: 4px;
                                width: parent.chip_w;
                                height: 36px;
                                border-radius: 6px;
                                background: root.liked
                                    ? AppTheme.player-selected
                                    : (like_chip.has-hover ? AppTheme.player-menu-hover : AppTheme.player-btn);
                                animate background { duration: 120ms; easing: ease-out; }

                                Text {
                                    text: root.like_text;
                                    color: root.liked ? AppTheme.player-fg-strong : AppTheme.player-text;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                like_chip := PanelHit { clicked => { root.toggle_like(); } dismiss => { root.close-right(); } pass-scroll: true; }
                            }

                            // 投币 (expands into the 1/2 coin choice below the strip)
                            Rectangle {
                                x: 10px + parent.chip_w + 6px;
                                y: 4px;
                                width: parent.chip_w;
                                height: 36px;
                                border-radius: 6px;
                                background: root.coin_multiply > 0
                                    ? AppTheme.player-selected
                                    : (coin_chip.has-hover ? AppTheme.player-menu-hover : AppTheme.player-btn);
                                animate background { duration: 120ms; easing: ease-out; }

                                Text {
                                    text: root.coin_text;
                                    color: root.coin_multiply > 0 ? AppTheme.player-fg-strong : AppTheme.player-text;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                coin_chip := PanelHit { clicked => { root.coin_expanded = !root.coin_expanded; } dismiss => { root.close-right(); } pass-scroll: true; }
                            }

                            // 收藏 (expands into the folder list below the strip)
                            Rectangle {
                                x: 10px + 2 * (parent.chip_w + 6px);
                                y: 4px;
                                width: parent.chip_w;
                                height: 36px;
                                border-radius: 6px;
                                background: root.favorited
                                    ? AppTheme.player-selected
                                    : (fav_chip.has-hover ? AppTheme.player-menu-hover : AppTheme.player-btn);
                                animate background { duration: 120ms; easing: ease-out; }

                                Text {
                                    text: root.fav_text;
                                    color: root.favorited ? AppTheme.player-fg-strong : AppTheme.player-text;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                fav_chip := PanelHit {
                                    pass-scroll: true;
                                    clicked => {
                                        if (!root.fav_expanded) {
                                            root.open_fav_menu();
                                        }
                                        root.fav_expanded = !root.fav_expanded;
                                    }
                                    dismiss => { root.close-right(); }
                                }
                            }

                            // 稍后再看
                            Rectangle {
                                x: 10px + 3 * (parent.chip_w + 6px);
                                y: 4px;
                                width: parent.chip_w;
                                height: 36px;
                                border-radius: 6px;
                                background: toview_chip.has-hover ? AppTheme.player-menu-hover : AppTheme.player-btn;
                                animate background { duration: 120ms; easing: ease-out; }

                                Text {
                                    text: "稍后看";
                                    color: AppTheme.player-text;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                toview_chip := PanelHit { clicked => { root.add_toview(); } dismiss => { root.close-right(); } pass-scroll: true; }
                            }

                            // 下载
                            Rectangle {
                                x: 10px + 4 * (parent.chip_w + 6px);
                                y: 4px;
                                width: parent.chip_w;
                                height: 36px;
                                border-radius: 6px;
                                background: dl_chip.has-hover ? AppTheme.player-menu-hover : AppTheme.player-btn;
                                animate background { duration: 120ms; easing: ease-out; }

                                Text {
                                    text: "下载";
                                    color: AppTheme.player-text;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                dl_chip := PanelHit { clicked => { root.download_current(); } dismiss => { root.close-right(); } pass-scroll: true; }
                            }
                        }

                        // 投币 sub-list
                        Rectangle {
                            property <length> sub_h: root.coin_expanded ? (2 * 34px + 8px) : 0px;
                            height: self.sub_h;
                            clip: true;
                            animate sub_h { duration: 160ms; easing: ease-out; }

                            for m[index] in [1, 2] : Rectangle {
                                x: 10px;
                                y: 4px + index * 34px;
                                width: max(0px, parent.width - 20px);
                                height: 34px;
                                border-radius: 5px;
                                background: root.coin_multiply == m
                                    ? AppTheme.player-selected
                                    : (c_item.has-hover ? AppTheme.player-menu-hover : #00000000);
                                animate background { duration: 120ms; easing: ease-out; }

                                Text {
                                    x: 10px;
                                    width: max(0px, parent.width - 20px);
                                    height: parent.height;
                                    text: m == 1 ? "投 1 枚硬币" : "投 2 枚硬币";
                                    color: root.coin_multiply == m ? AppTheme.player-fg-strong : AppTheme.player-text;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }

                                c_item := PanelHit {
                                    pass-scroll: true;
                                    clicked => {
                                        root.coin_expanded = false;
                                        root.set_coin(m);
                                    }
                                    dismiss => { root.close-right(); }
                                }
                            }
                        }

                        // 收藏 sub-list: folders + 取消收藏.
                        Rectangle {
                            property <int> rows: max(1, root.fav_items.length);
                            property <length> sub_h: root.fav_expanded ? (self.rows * 34px + 48px) : 0px;
                            height: self.sub_h;
                            clip: true;
                            animate sub_h { duration: 160ms; easing: ease-out; }

                            if root.fav_items.length == 0 : Text {
                                x: 10px;
                                y: 4px;
                                width: max(0px, parent.width - 20px);
                                height: 34px;
                                text: "暂无收藏夹";
                                color: AppTheme.player-text-dim;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            for folder[index] in root.fav_items : Rectangle {
                                x: 10px;
                                y: 4px + index * 34px;
                                width: max(0px, parent.width - 20px);
                                height: 34px;
                                border-radius: 5px;
                                background: fv_item.has-hover ? AppTheme.player-menu-hover : #00000000;
                                animate background { duration: 120ms; easing: ease-out; }

                                Text {
                                    x: 10px;
                                    width: max(0px, parent.width - 20px);
                                    height: parent.height;
                                    text: folder.title;
                                    color: AppTheme.player-text;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                fv_item := PanelHit { clicked => { root.toggle_fav(folder.fid); } dismiss => { root.close-right(); } pass-scroll: true; }
                            }

                            Rectangle {
                                x: 10px;
                                y: 4px + parent.rows * 34px;
                                width: max(0px, parent.width - 20px);
                                height: 30px;
                                border-radius: 5px;
                                background: unfav_item.has-hover ? AppTheme.player-danger-bg-hover : AppTheme.player-danger-bg;

                                Text {
                                    text: "取消收藏（全部收藏夹）";
                                    color: AppTheme.player-danger-text;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                unfav_item := PanelHit { clicked => { root.unfav_all(); } dismiss => { root.close-right(); } pass-scroll: true; }
                            }
                        }

                        // No trailing stretch filler inside a scroller: the
                        // content ends where the last row ends, so the range
                        // is exactly the overflow and never a blank page.
                    }

                        // QA probe: publish the 信息 scroller's live offset and
                        // travel for the wheel replay. Aliases are required:
                        // `changed` takes a plain identifier, never a path.
                        property <length> info_y <=> info_scroll.content-y;
                        property <length> info_ch <=> info_scroll.content-height;
                        property <length> info_vh <=> info_scroll.visible-height;

                        changed info_y => {
                            root.qa_right_scroll_y = info_y;
                            root.qa_right_scroll_max = max(0px, info_ch - info_vh);
                        }
                        changed info_ch => {
                            root.qa_right_scroll_max = max(0px, info_ch - info_vh);
                        }
                        changed info_vh => {
                            root.qa_right_scroll_max = max(0px, info_ch - info_vh);
                        }
                        init => {
                            root.qa_right_scroll_max = max(0px, info_ch - info_vh);
                        }
                    }
                }

                // ================= 1 评论区 =================
                // A reading surface on the panel's own tint. There is no opaque
                // film here: the strip's `player-glass` tint over the window
                // backdrop carries the surface, and the only extra layer is a
                // very soft vertical scrim where the text sits - 30%
                // `player-glass` at the header easing to 4% at the bottom. Body
                // text therefore keeps its measured contrast while the surface
                // still reads as frosted glass.
                //
                // Height chain (this is what used to be broken): the strip is
                // `height: 100%` of the window, this panel takes that height
                // EXPLICITLY minus the 40px tab row, and the list fills the rest
                // below the 52px header. The footer is the LAST ITEM of the
                // list (index == items.length), so it can never overlap a
                // comment and it scrolls away with the content.
                if root.right_tab == 1 : Rectangle {
                    height: max(0px, parent.height - 40px);
                    background: #00000000;

                    // The whole 评论 body is the wheel surface: the header
                    // (sort tabs), the empty state and the gap around the list
                    // have no Flickable of their own, so a rejected wheel here
                    // must still move the list. The list itself stays the
                    // scroller (rows hand their wheel to it via pass-scroll).
                    comments_wheel := TouchArea {
                        width: 100%;
                        height: 100%;

                        scroll-event(event) => {
                            let delta = event.delta-y != 0 ? event.delta-y : event.delta-x;
                            if (delta != 0 && root.comments_scroll_max > 0px) {
                                root.comments_scroll_y = clamp(
                                    root.comments_scroll_y + delta,
                                    -root.comments_scroll_max, 0px);
                                return EventResult.accept;
                            }
                            EventResult.reject
                        }

                        // A click on the panel's empty background still closes
                        // it, exactly like the old full-strip dismiss area.
                        clicked => { root.close-right(); }

                    // ---- legibility scrim: text only, glass on top ----
                    // A flat 90% plate used to sit here. This is the same job
                    // done with a soft gradient, so the panel reads as the same
                    // frosted glass as the other tabs: 30% player-glass at the
                    // header easing to 4% at the bottom. The strip's own 65%
                    // tint does the rest, so the body ink still measures
                    // 6.7:1 over the brightest frame the F99 capture produced
                    // while the picture behind stays visible - a 55% scrim left
                    // no picture visible at all (a flat plate) and was rejected
                    // for that reason.
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                        background: @linear-gradient(
                            180deg,
                            AppTheme.player-glass.with-alpha(0.30) 0%,
                            AppTheme.player-glass.with-alpha(0.12) 50%,
                            AppTheme.player-glass.with-alpha(0.04) 100%
                        );
                    }

                    // 900ms pulse shared by every skeleton on the panel. Stopped
                    // while the list is moving (see the scroll gate below): a
                    // scrolling skeleton is a static shape.
                    property <float> sk_pulse: 0;

                    // ---- header: 52px, 评论 N left + sort right ----
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 52px;
                        background: #00000000;

                        Text {
                            x: 16px;
                            width: max(0px, parent.width - 144px);
                            height: 100%;
                            text: root.comments_total > 0 ? "评论 " + root.comments_total : "评论";
                            color: AppTheme.player-fg-strong;
                            font-size: 16px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        // Segmented 热度 / 时间: 96x28 track, 44x24 pills.
                        Rectangle {
                            x: parent.width - 112px;
                            y: 12px;
                            width: 96px;
                            height: 28px;
                            border-radius: 8px;
                            background: AppTheme.player-btn;

                            Rectangle {
                                x: 2px;
                                y: 2px;
                                width: 44px;
                                height: 24px;
                                border-radius: 6px;
                                background: root.comments_hot
                                    ? AppTheme.player-selected
                                    : (hot_btn.has-hover ? AppTheme.player-menu-hover : #00000000);
                                animate background { duration: 120ms; easing: ease-out; }

                                Text {
                                    text: "热度";
                                    color: root.comments_hot ? AppTheme.player-fg-strong : AppTheme.player-text-dim;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    animate color { duration: 120ms; easing: ease-out; }
                                }

                                hot_btn := PanelHit {
                                    pass-scroll: true;
                                    width: 100%;
                                    height: 100%;
                                    clicked => {
                                        root.comments_hot = true;
                                        root.comments_sort(true);
                                    }
                                    dismiss => { root.close-right(); }
                                }
                            }

                            Rectangle {
                                x: 50px;
                                y: 2px;
                                width: 44px;
                                height: 24px;
                                border-radius: 6px;
                                background: root.comments_hot
                                    ? #00000000
                                    : (new_btn.has-hover ? AppTheme.player-menu-hover : AppTheme.player-selected);
                                animate background { duration: 120ms; easing: ease-out; }

                                Text {
                                    text: "时间";
                                    color: root.comments_hot ? AppTheme.player-text-dim : AppTheme.player-fg-strong;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    animate color { duration: 120ms; easing: ease-out; }
                                }

                                new_btn := PanelHit {
                                    pass-scroll: true;
                                    width: 100%;
                                    height: 100%;
                                    clicked => {
                                        root.comments_hot = false;
                                        root.comments_sort(false);
                                    }
                                    dismiss => { root.close-right(); }
                                }
                            }
                        }

                        // Hairline under the header: the list's own top rule.
                        Rectangle {
                            y: parent.height - 1px;
                            width: 100%;
                            height: 1px;
                            background: AppTheme.player-menu-border;
                        }
                    }

                    // ---- first-page sweep: 2px accent bar, no text ----
                    // Only while the list is still empty; a page fetch on a
                    // populated list shows the footer skeleton instead.
                    Rectangle {
                        x: 0;
                        y: 52px;
                        width: 100%;
                        height: root.comments_loading && root.comment_items.length == 0 ? 2px : 0px;
                        clip: true;
                        background: AppTheme.player-track.transparentize(0.6);

                        Rectangle {
                            width: 32%;
                            height: 100%;
                            x: root.load_phase * (parent.width - self.width);
                            background: AppTheme.accent;
                            opacity: 0.75;
                        }
                    }

                    // ---- the list ----
                    if root.comment_items.length > 0 : list_box := Rectangle {
                        x: 0;
                        y: 52px;
                        width: 100%;
                        height: max(0px, parent.height - 52px);
                        background: #00000000;

                        // ---- scroll gate: rows only, the glass stays ----
                        // The strip keeps its clipped glass image and the
                        // `player-glass` tint for the whole scroll (the old
                        // flat 94% plate is gone: no measured gain, opaque in
                        // practice). Only per-row animation is gated - the
                        // 3-tick (120ms) countdown releases it after the last
                        // `content-y` change.
                        //
                        // Rows read the flag (their `quiet` input), so no hover
                        // wash, skeleton pulse or reply stagger animates per row
                        // while the list is moving - the part of a scroll this
                        // panel actually paid for.
                        //
                        // `changed` only takes a plain identifier, so the offset
                        // is aliased into this scope first. The countdown timer
                        // lives outside the `if` (see the strip's Timer), so a
                        // list that disappears mid-scroll cannot leave the gate
                        // armed.
                        // The strip's outer wheel handler writes the root
                        // mirror (the list is conditional, so it must not be
                        // referenced from outside this block); the list owns
                        // the same property in the other direction, so a wheel
                        // over the rows keeps both in step.
                        property <length> c_y <=> comments_list.content-y;
                        property <length> c_ch <=> comments_list.content-height;
                        property <length> c_vh <=> comments_list.visible-height;
                        // Two-way bridge between the strip's wheel property and
                        // this conditional list: the wheel writes `want_y`, the
                        // list's own scroll writes `c_y`; each changed handler
                        // mirrors it once (the 0.5px guard stops a loop).
                        property <length> want_y <=> root.comments_scroll_y;

                        changed want_y => {
                            if (abs(comments_list.content-y - want_y) > 0.5px) {
                                comments_list.content-y = want_y;
                            }
                        }

                        changed c_y => {
                            root.comments_scroll_y = c_y;
                            root.comments_scroll_busy = true;
                            root.comments_scroll_ticks = 3;
                            root.comments_scroll_max = max(0px, c_ch - c_vh);
                            root.qa_right_scroll_y = c_y;
                            root.qa_right_scroll_max = root.comments_scroll_max;
                        }
                        changed c_ch => {
                            root.comments_scroll_max = max(0px, c_ch - c_vh);
                            root.qa_right_scroll_max = root.comments_scroll_max;
                        }
                        changed c_vh => {
                            root.comments_scroll_max = max(0px, c_ch - c_vh);
                            root.qa_right_scroll_max = root.comments_scroll_max;
                        }

                        comments_list := ListView {
                            width: 100%;
                            height: 100%;
                            // ScrollView/ListView exposes `enabled` (the Flickable
                            // underneath has no public `interactive` in 1.18); a
                            // ListView scrolls by wheel and by drag-pan unless
                            // `mouse-drag-pan-enabled` says otherwise.
                            enabled: true;
                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            mouse-drag-pan-enabled: false;
                            scrolled => {
                                root.comments-maybe-more(
                                    comments_list.content-height,
                                    comments_list.visible-height,
                                    comments_list.content-y);
                            }

                            // One item per comment plus ONE footer item. Items need
                            // an explicit height (@row_item.height): without it a
                            // ListView cannot compute content-height, which is the
                            // the reason this list once never scrolled.
                            //
                            // `i` is the top-level row index, and it is the whole
                            // identity the data layer gets: the pill (collapsed and
                            // open), the row body and 查看更多回复 inside the expanded
                            // thread all resolve through this one index, so a 楼中楼
                            // page is always fetched for the row's own rpid - no
                            // 32-bit id crosses the callback boundary.
                            for i in root.comment_items.length + 1 : Rectangle {
                                width: 100%;
                                height: i < root.comment_items.length ? row_item.height : root.comments-footer-h;

                                row_item := CommentThread {
                                    width: 100%;
                                    visible: i < root.comment_items.length;
                                    item: root.comment_items[min(i, root.comment_items.length - 1)];
                                    up_owner: root.info_owner;
                                    separated: i > 0 && i < root.comment_items.length;
                                    quiet: root.comments_scroll_busy;
                                    toggle => { root.comment_toggle(i); }
                                    more(pn) => { root.comment_replies(i, pn); }
                                    dismiss => { root.close-right(); }
                                }

                                // Footer / skeleton: the last row of the content.
                                if i == root.comment_items.length : Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: 100%;
                                    height: 100%;
                                    background: #00000000;

                                    if root.comments_loading : CommentSkeleton {
                                        y: 0;
                                        pulse: sk_pulse;
                                        quiet: root.comments_scroll_busy;
                                    }

                                    if !root.comments_loading && root.comments_error != "" : Text {
                                        x: 16px;
                                        width: max(0px, parent.width - 32px);
                                        height: 40px;
                                        text: root.comments_error;
                                        color: AppTheme.player-danger-text;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    if !root.comments_loading && root.comments_error == "" && root.comments_end : Text {
                                        y: 0;
                                        width: 100%;
                                        height: 40px;
                                        text: "没有更多评论了";
                                        color: AppTheme.player-text-dim;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Safety net the `scrolled` callback cannot see: a page
                        // shorter than the body never scrolls, so the next page is
                        // requested without any pointer input. The armed flag in
                        // `comments-maybe-more` keeps it to one call per page.
                        Timer {
                            interval: 200ms;
                            running: true;
                            triggered => {
                                root.comments-maybe-more(
                                    comments_list.content-height,
                                    comments_list.visible-height,
                                    comments_list.content-y);
                            }
                        }
                    }

                    // ---- first page / empty / error ----
                    // Loading paints THREE comment-shaped skeletons in the list's
                    // own rhythm (32px avatar, 14px name bar, two 12px body bars,
                    // a meta bar, hairlines between them) - not grey bars floating
                    // in an empty panel.
                    if root.comment_items.length == 0 : Rectangle {
                        x: 0;
                        y: 52px;
                        width: 100%;
                        height: max(0px, parent.height - 52px);
                        background: #00000000;

                        if root.comments_loading : VerticalLayout {
                            spacing: 0px;

                            CommentSkeleton { separated: false; pulse: sk_pulse; }
                            CommentSkeleton { separated: true; pulse: sk_pulse; }
                            CommentSkeleton { separated: true; pulse: sk_pulse; }
                        }

                        if !root.comments_loading && root.comments_error != "" : Text {
                            width: 100%;
                            height: 100%;
                            text: root.comments_error;
                            color: AppTheme.player-danger-text;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }

                        if !root.comments_loading && root.comments_error == "" : Text {
                            width: 100%;
                            height: 100%;
                            text: "还没有评论";
                            color: AppTheme.player-text-dim;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // The pulse runs only while something is loading AND the list
                    // is still: a scrolling panel runs no skeleton animation.
                    Timer {
                        interval: 900ms;
                        running: root.comments_loading && !root.comments_scroll_busy;
                        triggered => { sk_pulse = 1 - sk_pulse; }
                    }
                    }
                }

                // ================= 2 性能 =================
                // A diagnostic instrument, not a debug dump. Top to bottom:
                //   实时速度   metered throughput as one big number + a 3px bar
                //              scaled to the max of the last 5 s
                //   线程       busy / configured + the per-connection rows
                //   下载分布   the whole file in 120 slices (missing /
                //              downloaded / fetching) with the playhead
                //   平滑       the interpolation mode (click to cycle), the
                //              generator readout and an optional GPU line
                //   帧率/缓冲  the decoder's own numbers
                // Every value is a string Rust publishes; an empty one reads "-".
                if root.right_tab == 2 : Rectangle {
                    vertical-stretch: 1;
                    background: #00000000;

                    // 1 s pulse for the active cells: `net_pulse` animates 0 -> 1
                    // -> 0, and the strip's active slices fade with it.
                    Timer {
                        interval: 1000ms;
                        running: root.net_panel_open;
                        triggered => { root.net_pulse = root.net_pulse == 0 ? 1 : 0; }
                    }

                    net_scroll := ScrollView {
                        vertical-stretch: 1;
                        content-height: root.net_h;
                        // Wheel only, like every other list in the panel: the
                        // scrollbar was a second, heavier affordance.
                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 2px;
                            padding-bottom: 12px;
                            spacing: 0px;

                            Timer {
                                interval: 80ms;
                                running: root.qa_scroll_probe;
                                triggered => {
                                    root.qa_right_scroll_y = net_scroll.content-y;
                                    root.qa_right_scroll_max = max(0px,
                                        net_scroll.content-height - net_scroll.visible-height);
                                }
                            }

                            // ---- 1 实时速度 ----
                            PanelSection { text: "实时速度"; }

                            Text {
                                height: 34px;
                                text: root.or-dash(root.net_rate);
                                color: AppTheme.player-fg-strong;
                                font-size: 24px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            // live bar: 3px well, accent fill, 0..1 of the 5 s max.
                            // The fill is a plain left-aligned overlay: x = 0 and
                            // width = ratio x the well, so it can only grow
                            // rightwards (no centred transform, no gradient).
                            Rectangle {
                                height: 12px;
                                background: #00000000;

                                Rectangle {
                                    x: 0;
                                    y: 4px;
                                    width: 100%;
                                    height: 3px;
                                    border-radius: 1.5px;
                                    background: AppTheme.player-track;
                                }

                                Rectangle {
                                    x: 0;
                                    y: 4px;
                                    width: parent.width * clamp(root.net_rate_ratio, 0, 1);
                                    height: 3px;
                                    border-radius: 1.5px;
                                    background: AppTheme.accent;
                                    animate width { duration: 200ms; easing: ease-out; }
                                }
                            }

                            Rectangle { height: 4px; background: #00000000; }

                            // ---- 2 线程 ----
                            PanelSection { text: "线程"; }

                            Text {
                                height: 22px;
                                text: root.or-dash(root.net_active_text);
                                color: AppTheme.player-text;
                                font-size: 11.5px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            if root.net_workers.length == 0 : Text {
                                height: 18px;
                                text: "等待连接";
                                color: AppTheme.player-text-dim;
                                font-size: 10.5px;
                                vertical-alignment: center;
                            }

                            for w in root.net_workers : NetWorkerRow {
                                host: w.host;
                                range: w.range;
                                bytes: w.bytes;
                                busy: w.busy;
                            }

                            // ---- 3 下载分布 ----
                            PanelSection { text: "下载分布"; }

                            Rectangle {
                                height: 10px;
                                background: #00000000;

                                // 120 slices, 1px gaps, 2px radius: 0 missing
                                // (track), 1 downloaded (green 55%), 3 fetching
                                // (accent, pulsing). Downloaded bytes are
                                // immediately playable, so the point cache is
                                // NOT a separate state - Rust merges it into 1.
                                for s[i] in root.net_map : Rectangle {
                                    x: i * (parent.width / max(1, root.net_map.length));
                                    width: max(1px, parent.width / max(1, root.net_map.length) - 1px);
                                    y: 2px;
                                    height: 6px;
                                    border-radius: 2px;
                                    background: s == 3
                                        ? AppTheme.accent
                                        : (s >= 1 ? AppTheme.player-progress : AppTheme.player-track);
                                    opacity: s == 3
                                        ? 0.55 + 0.45 * root.net_pulse
                                        : (s == 1 ? 0.55 : 1);
                                }

                                // 播放位置: a 2px white playhead over the strip.
                                // `shown_ms` follows the seek drag, so the marker
                                // previews the target before the seek lands.
                                if root.duration_ms > 0.0 : Rectangle {
                                    x: min(
                                        max(0px, parent.width - 2px),
                                        parent.width * clamp(root.shown_ms / root.duration_ms, 0, 1)
                                    );
                                    y: 2px;
                                    width: 2px;
                                    height: 6px;
                                    border-radius: 1px;
                                    background: AppTheme.player-fg-strong;
                                }
                            }

                            Text {
                                height: 18px;
                                text: root.or-dash(root.net_total_text);
                                color: AppTheme.player-text;
                                font-size: 10.5px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                NetLegend { label: "未下载"; tint: AppTheme.player-track; }
                                NetLegend { label: "已下载"; tint: AppTheme.player-progress; alpha: 0.55; }
                                NetLegend {
                                    label: "下载中";
                                    tint: AppTheme.accent;
                                    alpha: 0.55 + 0.45 * root.net_pulse;
                                }
                            }

                            Rectangle { height: 6px; background: #00000000; }

                            // ---- 4 平滑 ----
                            // Frame interpolation. 模式 is the panel's second
                            // entry point to the same cycle the pill cell
                            // fires; 生成 is Rust's generator readout and GPU
                            // only appears when Rust publishes a GPU line.
                            // Three 24px rows, the label column at 104px - the
                            // exact NetStat geometry of 帧率 / 缓冲 below.
                            PanelSection { text: "平滑"; }
                            NetStat {
                                label: "模式";
                                value: root.interp_mode_text;
                                clickable: true;
                                clicked => { root.interp_cycle(); }
                            }
                            NetStat { label: "生成"; value: root.interp_stats_text; }
                            if root.interp_gpu_text != "" : NetStat {
                                label: "GPU";
                                value: root.interp_gpu_text;
                            }

                            // ---- 5 帧率 ----
                            PanelSection { text: "帧率"; }
                            NetStat { label: "呈现"; value: root.or-dash(root.net_fps_presented); strong: true; }
                            NetStat { label: "解码"; value: root.or-dash(root.net_fps_decoded); }
                            NetStat { label: "首帧耗时"; value: root.or-dash(root.net_first_frame); }
                            NetStat { label: "编码"; value: root.or-dash(root.net_codec); }

                            // ---- 6 缓冲 ----
                            PanelSection { text: "缓冲"; }
                            NetStat { label: "缓冲"; value: root.or-dash(root.net_buffer); }
                            NetStat { label: "估算码率"; value: root.or-dash(root.net_bitrate); }
                            NetStat { label: "网络速率"; value: root.or-dash(root.net_rate); }
                            NetStat { label: "进度"; value: root.or-dash(root.net_progress); }
                            NetStat { label: "卡顿"; value: root.or-dash(root.net_stalls); }
                            if root.buffer_detail != "" : NetStat { label: "缓冲明细"; value: root.buffer_detail; }

                            // buffer fill: 6px well, accent fill, 0..1 from Rust
                            Rectangle {
                                height: 18px;
                                background: #00000000;

                                Rectangle {
                                    x: 0;
                                    y: 6px;
                                    width: 100%;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: AppTheme.player-track;
                                }

                                Rectangle {
                                    x: 0;
                                    y: 6px;
                                    width: parent.width * clamp(root.net_buffer_ratio, 0, 1);
                                    height: 6px;
                                    border-radius: 3px;
                                    background: AppTheme.accent;
                                    animate width { duration: 200ms; easing: ease-out; }
                                }
                            }
                        }
                    }
                }

                // ================= 3 设置 =================
                // The old ▤ panel unchanged: 播放 / 画面 / 其他. The 弹幕 section
                // is gone - every danmaku control now lives in the pill's 弹幕
                // popover, so there is exactly one home for each of them.
                if root.right_tab == 3 : Rectangle {
                    vertical-stretch: 1;
                    background: #00000000;

                    settings_scroll := ScrollView {
                        vertical-stretch: 1;
                        content-height: root.settings_h;
                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                        VerticalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            padding-bottom: 12px;
                            spacing: 2px;

                            Timer {
                                interval: 80ms;
                                running: root.qa_scroll_probe;
                                triggered => {
                                    root.qa_right_scroll_y = settings_scroll.content-y;
                                    root.qa_right_scroll_max = max(0px,
                                        settings_scroll.content-height - settings_scroll.visible-height);
                                }
                            }

                            // ---------------- 播放 ----------------
                            PanelSection { text: "播放"; }

                            // 画质 opens the floating stream menu (see the 画质
                            // menu block at the end of the player root, anchored
                            // to this row). The row keeps its chevron so it reads
                            // as "expands into something", but nothing is pushed
                            // down here any more: the menu floats over the panel.
                            PanelRow {
                                label: "画质";
                                value: root.quality_value;
                                expandable: true;
                                expanded: root.quality_expanded;
                                clicked => {
                                    if (!root.quality_expanded) {
                                        pill.vol_open = false;
                                        pill.dm_open = false;
                                        // One locked-tier toast per open: tell
                                        // Rust this is a fresh menu.
                                        root.quality_menu_opened();
                                    }
                                    root.quality_expanded = !root.quality_expanded;
                                }
                                dismiss => { root.close-right(); }
                            }

                            PanelRow {
                                label: "倍速";
                                value: root.speed_text;
                                expandable: true;
                                expanded: root.speed_expanded;
                                clicked => { root.speed_expanded = !root.speed_expanded; }
                                dismiss => { root.close-right(); }
                            }
                            Rectangle {
                                property <length> sub_h: root.speed_expanded ? (6 * 34px + 6px) : 0px;
                                height: self.sub_h;
                                clip: true;
                                animate sub_h { duration: 160ms; easing: ease-out; }

                                for s[index] in [2000, 1500, 1250, 1000, 750, 500] : Rectangle {
                                    x: 3px;
                                    y: 3px + index * 34px;
                                    width: max(0px, parent.width - 6px);
                                    height: 34px;
                                    border-radius: 5px;
                                    background: root.speed_milli == s
                                        ? AppTheme.player-selected
                                        : (s_item.has-hover ? AppTheme.player-menu-hover : #00000000);
                                    animate background { duration: 120ms; easing: ease-out; }

                                    Text {
                                        x: 10px;
                                        width: max(0px, parent.width - 20px);
                                        height: parent.height;
                                        text: root.speed-label(s);
                                        color: root.speed_milli == s ? AppTheme.player-fg-strong : AppTheme.player-text;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }

                                    s_item := PanelHit {
                                        pass-scroll: true;
                                        clicked => {
                                            root.speed_expanded = false;
                                            root.set_speed(s);
                                        }
                                        dismiss => { root.close-right(); }
                                    }
                                }
                            }

                            PanelRow {
                                label: "音轨";
                                value: root.audio_label;
                                expandable: true;
                                expanded: root.audio_expanded;
                                clicked => { root.audio_expanded = !root.audio_expanded; }
                                dismiss => { root.close-right(); }
                            }
                            Rectangle {
                                property <length> sub_h: root.audio_expanded ? (root.audio_items.length * 34px + 6px) : 0px;
                                height: self.sub_h;
                                clip: true;
                                animate sub_h { duration: 160ms; easing: ease-out; }

                                for entry[index] in root.audio_items : Rectangle {
                                    x: 3px;
                                    y: 3px + index * 34px;
                                    width: max(0px, parent.width - 6px);
                                    height: 34px;
                                    border-radius: 5px;
                                    background: root.audio_index == entry.index
                                        ? AppTheme.player-selected
                                        : (a_item.has-hover ? AppTheme.player-menu-hover : #00000000);
                                    animate background { duration: 120ms; easing: ease-out; }

                                    Text {
                                        x: 10px;
                                        width: max(0px, parent.width - 20px - (entry.vip ? 34px : 0px));
                                        height: parent.height;
                                        text: entry.label;
                                        color: root.audio_index == entry.index ? AppTheme.player-fg-strong : AppTheme.player-text;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    if entry.vip : Rectangle {
                                        x: parent.width - 40px;
                                        y: (parent.height - 14px) / 2;
                                        width: 30px;
                                        height: 14px;
                                        border-radius: 3px;
                                        background: AppTheme.vip-badge-bg;

                                        Text {
                                            text: "会员";
                                            color: AppTheme.vip-badge-fg;
                                            font-size: 9px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    a_item := PanelHit {
                                        pass-scroll: true;
                                        clicked => {
                                            root.audio_expanded = false;
                                            root.audio_index = entry.index;
                                            root.set_audio(entry.index);
                                        }
                                        dismiss => { root.close-right(); }
                                    }
                                }
                            }

                            PanelRow {
                                label: "仅音频";
                                value: root.audio_only ? "开" : "关";
                                accent: root.audio_only;
                                clicked => { root.toggle_audio_only(); }
                                dismiss => { root.close-right(); }
                            }

                            // ---------------- 画面 ----------------
                            PanelSection { text: "画面"; }

                            PanelRow {
                                label: "画面比例";
                                value: root.fit-label(root.fit_mode);
                                expandable: true;
                                expanded: root.fit_menu_open;
                                clicked => { root.fit_menu_open = !root.fit_menu_open; }
                                dismiss => { root.close-right(); }
                            }
                            Rectangle {
                                property <length> sub_h: root.fit_menu_open ? (3 * 34px + 6px) : 0px;
                                height: self.sub_h;
                                clip: true;
                                animate sub_h { duration: 160ms; easing: ease-out; }

                                for m[index] in [0, 1, 2] : Rectangle {
                                    x: 3px;
                                    y: 3px + index * 34px;
                                    width: max(0px, parent.width - 6px);
                                    height: 34px;
                                    border-radius: 5px;
                                    background: root.fit_mode == m
                                        ? AppTheme.player-selected
                                        : (f_item.has-hover ? AppTheme.player-menu-hover : #00000000);
                                    animate background { duration: 120ms; easing: ease-out; }

                                    Text {
                                        x: 10px;
                                        width: max(0px, parent.width - 20px);
                                        height: parent.height;
                                        text: root.fit-label(m);
                                        color: root.fit_mode == m ? AppTheme.player-fg-strong : AppTheme.player-text;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }

                                    f_item := PanelHit {
                                        pass-scroll: true;
                                        clicked => {
                                            root.fit_mode = m;
                                            root.fit_menu_open = false;
                                        }
                                        dismiss => { root.close-right(); }
                                    }
                                }
                            }

                            PanelRow {
                                label: "亮度";
                                value: root.brightness > 0 ? "+" + root.brightness : "" + root.brightness;
                                expandable: true;
                                expanded: root.brightness_menu_open;
                                clicked => { root.brightness_menu_open = !root.brightness_menu_open; }
                                dismiss => { root.close-right(); }
                            }
                            Rectangle {
                                property <length> sub_h: root.brightness_menu_open ? 38px : 0px;
                                height: self.sub_h;
                                clip: true;
                                animate sub_h { duration: 160ms; easing: ease-out; }

                                PanelSlider {
                                    x: 6px;
                                    y: 6px;
                                    width: max(0px, parent.width - 12px);
                                    height: 26px;
                                    value: (root.brightness + 100) / 200;
                                    live(v) => { root.brightness = round(clamp(v * 200 - 100, -100, 100)); }
                                    commit(v) => { root.brightness = round(clamp(v * 200 - 100, -100, 100)); }
                                    dismiss => { root.close-right(); }
                                }
                            }

                            PanelRow {
                                label: "截图";
                                value: "保存当前帧";
                                clicked => { root.take_screenshot(); }
                                dismiss => { root.close-right(); }
                            }

                            // ---------------- 其他 ----------------
                            PanelSection { text: "其他"; }

                            PanelRow {
                                label: "小窗";
                                value: root.mini_open ? "开" : "关";
                                accent: root.mini_open;
                                clicked => { root.toggle_mini(); }
                                dismiss => { root.close-right(); }
                            }

                            PanelRow {
                                label: "置顶";
                                value: root.topmost_text;
                                accent: root.topmost;
                                clicked => { root.toggle_topmost(); }
                                dismiss => { root.close-right(); }
                            }

                            PanelRow {
                                label: "睡眠定时";
                                value: root.sleep_text == "" ? "关" : "已设置";
                                accent: root.sleep_text != "";
                                expandable: true;
                                expanded: root.sleep_menu_open;
                                clicked => { root.sleep_menu_open = !root.sleep_menu_open; }
                                dismiss => { root.close-right(); }
                            }
                            Rectangle {
                                property <length> sub_h: root.sleep_menu_open ? (6 * 32px + 26px) : 0px;
                                height: self.sub_h;
                                clip: true;
                                animate sub_h { duration: 160ms; easing: ease-out; }

                                Text {
                                    x: 10px;
                                    y: 3px;
                                    width: max(0px, parent.width - 20px);
                                    height: 18px;
                                    text: root.sleep_text == "" ? "到点自动暂停播放" : root.sleep_text;
                                    color: AppTheme.player-text-dim;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                for v[index] in [15, 30, 60, 90] : Rectangle {
                                    x: 3px;
                                    y: 22px + index * 32px;
                                    width: max(0px, parent.width - 6px);
                                    height: 30px;
                                    border-radius: 5px;
                                    background: sl_item.has-hover ? AppTheme.player-menu-hover : #00000000;
                                    animate background { duration: 120ms; easing: ease-out; }

                                    Text {
                                        text: v + " 分钟";
                                        color: AppTheme.player-text-bright;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    sl_item := PanelHit {
                                        pass-scroll: true;
                                        clicked => {
                                            root.sleep_menu_open = false;
                                            root.set_sleep(v);
                                        }
                                        dismiss => { root.close-right(); }
                                    }
                                }

                                Rectangle {
                                    x: 3px;
                                    y: 22px + 4 * 32px;
                                    width: max(0px, parent.width - 6px);
                                    height: 30px;
                                    border-radius: 5px;
                                    background: sl_end.has-hover ? AppTheme.player-menu-hover : #00000000;

                                    Text {
                                        text: "播完当前视频";
                                        color: AppTheme.player-text-bright;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    sl_end := PanelHit {
                                        pass-scroll: true;
                                        clicked => {
                                            root.sleep_menu_open = false;
                                            root.set_sleep(-1);
                                        }
                                        dismiss => { root.close-right(); }
                                    }
                                }

                                Rectangle {
                                    x: 3px;
                                    y: 22px + 5 * 32px;
                                    width: max(0px, parent.width - 6px);
                                    height: 30px;
                                    border-radius: 5px;
                                    background: sl_cancel.has-hover ? AppTheme.player-danger-bg-hover : AppTheme.player-danger-bg;

                                    Text {
                                        text: "取消定时";
                                        color: AppTheme.player-danger-text;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    sl_cancel := PanelHit {
                                        pass-scroll: true;
                                        clicked => {
                                            root.sleep_menu_open = false;
                                            root.set_sleep(0);
                                        }
                                        dismiss => { root.close-right(); }
                                    }
                                }
                            }

                            // 历史弹幕: whose date list used to sit in the 弹幕
                            // section. It is a data-source picker, not a display
                            // parameter, so it keeps its expandable list here.
                            PanelRow {
                                label: "历史弹幕";
                                value: root.history_selected;
                                expandable: true;
                                expanded: root.history_expanded;
                                clicked => {
                                    if (!root.history_expanded) {
                                        root.open_history();
                                    }
                                    root.history_expanded = !root.history_expanded;
                                }
                                dismiss => { root.close-right(); }
                            }
                            Rectangle {
                                property <length> sub_h: root.history_expanded ? (root.history_dates.length * 30px + 28px) : 0px;
                                height: self.sub_h;
                                clip: true;
                                animate sub_h { duration: 160ms; easing: ease-out; }

                                Text {
                                    x: 10px;
                                    y: 3px;
                                    width: max(0px, parent.width - 20px);
                                    height: 18px;
                                    text: root.history_status;
                                    color: AppTheme.player-text-dim;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                for date[index] in root.history_dates : Rectangle {
                                    x: 3px;
                                    y: 22px + index * 30px;
                                    width: max(0px, parent.width - 6px);
                                    height: 28px;
                                    border-radius: 5px;
                                    background: root.history_selected == date
                                        ? AppTheme.player-selected
                                        : (h_item.has-hover ? AppTheme.player-menu-hover : #00000000);
                                    animate background { duration: 120ms; easing: ease-out; }

                                    Text {
                                        x: 10px;
                                        width: max(0px, parent.width - 20px);
                                        height: parent.height;
                                        text: date;
                                        color: root.history_selected == date ? AppTheme.player-fg-strong : AppTheme.player-text;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }

                                    h_item := PanelHit {
                                        pass-scroll: true;
                                        clicked => {
                                            root.history_selected = date;
                                            root.set_history_date(date);
                                        }
                                        dismiss => { root.close-right(); }
                                    }
                                }
                            }
                        }
                    }

                    // ================= 画质 menu: every advertised tier =================
                    // One row per raw DASH stream (`quality_menu_rows`), plus one
                    // locked row per tier the video advertises but this account
                    // may not play (4K / 1080P60 / HDR / 8K on a non-VIP
                    // account). Rows are 44px: the label 13.5/600 on the left,
                    // the detail line (resolution · fps · codec · Mbps) 11.5px
                    // `player-text-soft` under it, a 20px badge chip on the
                    // right, a check mark on the current stream and a subtle
                    // accent rail on rows that carry a badge.
                    //
                    // Locked rows are 55% opacity, carry a `大会员` chip and a
                    // small lock instead of the check, get no hover wash and do
                    // not close the menu when clicked: the pick callback logs
                    // the tier and Rust shows one toast at most per open.
                    //
                    // Geometry: the panel floats over this 设置 body, 300px wide,
                    // right-aligned to the strip's 10px inset and anchored to the
                    // 画质 row (section 32 + spacing 2 + 40px row = 74px in body
                    // coordinates, minus the ScrollView's live offset, so it
                    // travels with the row). Ten rows plus padding is 448px, which
                    // does not fit above a row that sits 74px below the body top,
                    // so the menu opens above the row when it fits and otherwise
                    // flips below it, capping its height to the room there (the
                    // rest scrolls). It is never taller than 10 rows and never
                    // leaves the panel.
                    //
                    // `quality_pick(index)` reports the row index into
                    // `quality_menu_rows`; Rust keeps the row→stream mapping.
                    if root.quality_expanded : Rectangle {
                        property <length> row_bottom: 74px + settings_scroll.content-y;
                        property <length> row_top: self.row_bottom - 40px;
                        property <int> rows_visible: root.quality_menu_rows.length == 0 ? 1 : min(root.quality_menu_rows.length, 10);
                        property <length> wanted_h: max(58px, self.rows_visible * 44px + 8px);
                        property <length> space_above: max(0px, self.row_top - 6px - 4px);
                        property <length> space_below: max(0px, parent.height - 8px - self.row_bottom - 6px);
                        property <bool> opens_up: self.wanted_h <= self.space_above;
                        property <length> menu_h: min(self.wanted_h, max(58px, self.opens_up ? self.space_above : self.space_below));
                        property <length> menu_y: self.opens_up
                            ? self.row_top - 6px - self.menu_h
                            : min(self.row_bottom + 6px, max(4px, parent.height - 8px - self.menu_h));

                        // Outside click inside the panel: one press anywhere on
                        // the 设置 body closes the menu instead of hitting the row
                        // under the pointer. Wheel events are not consumed, so the
                        // body still scrolls. Clicks on the picture are handled by
                        // `video_area` (it dismisses the menu too).
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.quality_expanded = false; }
                        }

                        x: parent.width - 310px;
                        y: self.menu_y;
                        width: 300px;
                        height: self.menu_h;
                        background: #00000000;

                        GlassPanel {
                            width: 100%;
                            height: 100%;
                            radius: 10px;
                            tint: AppTheme.player-menu-tint;
                            edge: AppTheme.player-menu-border;
                            shadow: true;
                            shadow-color: AppTheme.player-shadow;
                            shadow-blur: 16px;
                            shadow-y: 6px;

                            ScrollView {
                                x: 4px;
                                y: 4px;
                                width: parent.width - 8px;
                                height: max(0px, parent.height - 8px);
                                content-height: max(1, root.quality_menu_rows.length) * 44px
                                    + (root.audio_quality_rows.length > 0
                                        ? 30px + root.audio_quality_rows.length * 40px
                                        : 0px);
                                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                mouse-drag-pan-enabled: false;

                                for row[i] in root.quality_menu_rows : Rectangle {
                                    x: 0;
                                    y: i * 44px;
                                    width: 100%;
                                    height: 44px;
                                    border-radius: 6px;
                                    // Locked rows never get a wash: hover must not
                                    // suggest they can be picked.
                                    background: row.current
                                        ? AppTheme.player-selected
                                        : (!row.locked && q_row.has-hover ? AppTheme.player-menu-hover : #00000000);
                                    animate background { duration: 120ms; easing: ease-out; }
                                    opacity: row.locked ? 0.55 : 1.0;

                                    // Badges push the text block left by their own
                                    // width, the check mark by another 18px and the
                                    // lock by 16px, so they never overlap on a row
                                    // that is both current and badged (1080P60 HDR).
                                    property <length> chip_w: root.quality-badge-w(row.badge);
                                    property <length> chip_gap: row.badge == "" ? 0px : self.chip_w + 6px;
                                    property <length> lock_gap: row.locked ? 16px : 0px;
                                    property <length> text_right: 10px + self.chip_gap + (row.current ? 16px : 0px) + self.lock_gap;

                                    // Accent rail: only on rows that carry a
                                    // badge, so HDR / 8K / 杜比 / 会员 read as one
                                    // shape language.
                                    if row.badge != "" : Rectangle {
                                        x: 3px;
                                        y: 10px;
                                        width: 2px;
                                        height: 24px;
                                        border-radius: 1px;
                                        background: AppTheme.accent;
                                        opacity: 0.65;
                                    }

                                    Text {
                                        x: 13px;
                                        y: 4px;
                                        width: max(0px, parent.width - 13px - parent.text_right);
                                        height: 20px;
                                        text: row.label;
                                        color: row.current ? AppTheme.player-fg-strong : AppTheme.player-text;
                                        font-size: 13.5px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    // One line, elided: the detail never wraps, so
                                    // every row keeps its 44px pitch even with a
                                    // long string (extra codec / route notes).
                                    Text {
                                        x: 13px;
                                        y: 22px;
                                        width: max(0px, parent.width - 13px - parent.text_right);
                                        height: 17px;
                                        text: row.detail;
                                        color: AppTheme.player-text-soft;
                                        font-size: 11.5px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    if row.badge != "" : Rectangle {
                                        x: parent.width - 10px - parent.chip_w;
                                        y: 12px;
                                        width: parent.chip_w;
                                        height: 20px;
                                        border-radius: 4px;
                                        background: row.badge == "会员" || row.badge == "大会员"
                                            ? AppTheme.vip-badge-bg
                                            : AppTheme.player-selected;

                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: row.badge;
                                            color: row.badge == "会员" || row.badge == "大会员" ? AppTheme.vip-badge-fg : AppTheme.player-text-bright;
                                            font-size: 9.5px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Check mark: a drawn stroke (the bundled
                                    // font has no check glyph), accent on the
                                    // current stream.
                                    if row.current : Path {
                                        x: parent.width - 10px - parent.chip_gap - 12px;
                                        y: 17px;
                                        width: 11px;
                                        height: 10px;
                                        viewbox-width: 11;
                                        viewbox-height: 10;
                                        commands: "M 1 5.2 L 4.2 8.4 L 10 1.6";
                                        fill: #00000000;
                                        stroke: AppTheme.accent;
                                        stroke-width: 1.6px;
                                        stroke-line-cap: round;
                                    }

                                    // Locked tier: a small padlock in the slot the
                                    // check mark uses on a playable stream.
                                    if row.locked : Path {
                                        x: parent.width - 10px - parent.chip_gap - 12px;
                                        y: 16px;
                                        width: 12px;
                                        height: 12px;
                                        viewbox-width: 14;
                                        viewbox-height: 14;
                                        commands: "M 3.2 6.2 L 3.2 4.6 C 3.2 1.5, 10.8 1.5, 10.8 4.6 L 10.8 6.2 M 1.6 6.2 L 12.4 6.2 L 12.4 13.2 L 1.6 13.2 Z";
                                        fill: #00000000;
                                        stroke: AppTheme.player-text-dim;
                                        stroke-width: 1.4px;
                                        stroke-line-cap: round;
                                        stroke-line-join: round;
                                    }

                                    // Hover tooltip on a locked row: the one-line
                                    // reason, in the same plate language as the
                                    // pill tooltips, drawn over the chip while the
                                    // pointer rests on the row.
                                    if row.locked && q_row.has-hover : Rectangle {
                                        x: parent.width - 10px - 96px;
                                        y: 10px;
                                        width: 96px;
                                        height: 24px;
                                        border-radius: 6px;
                                        background: AppTheme.player-menu;
                                        border-width: 1px;
                                        border-color: AppTheme.player-menu-border;
                                        drop-shadow-color: AppTheme.player-shadow;
                                        drop-shadow-blur: 8px;
                                        drop-shadow-offset-y: 2px;

                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: "需要大会员";
                                            color: AppTheme.player-text;
                                            font-size: 10.5px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    q_row := PanelHit {
                                        pass-scroll: true;
                                        clicked => {
                                            // A locked row is not selectable: the
                                            // menu stays open (one toast at most,
                                            // from Rust) and the pick is logged.
                                            if !row.locked {
                                                root.quality_expanded = false;
                                            }
                                            root.quality_pick(i);
                                        }
                                        dismiss => { root.close-right(); }
                                    }
                                }

                                // ---- 音质: the audio tiers of this video ----
                                // Same row rhythm as the video tiers, after a
                                // divider and a small header. `detail` is the
                                // measured bandwidth from the stream itself.
                                Rectangle {
                                    x: 6px;
                                    y: (max(1, root.quality_menu_rows.length) * 44px + 8px);
                                    width: parent.width - 12px;
                                    height: 1px;
                                    background: AppTheme.player-menu-border;
                                }
                                Text {
                                    x: 13px;
                                    y: (max(1, root.quality_menu_rows.length) * 44px + 8px) + 1px;
                                    width: parent.width - 26px;
                                    height: 20px;
                                    text: "音质";
                                    color: AppTheme.player-text-dim;
                                    font-size: 10.5px;
                                    vertical-alignment: center;
                                }
                                for arow[ai] in root.audio_quality_rows : Rectangle {
                                    x: 0;
                                    y: (max(1, root.quality_menu_rows.length) * 44px + 8px) + 22px + ai * 40px;
                                    width: 100%;
                                    height: 38px;
                                    border-radius: 6px;
                                    background: arow.current
                                        ? AppTheme.player-selected
                                        : (!arow.locked && a_row.has-hover ? AppTheme.player-menu-hover : #00000000);
                                    animate background { duration: 120ms; easing: ease-out; }
                                    opacity: arow.locked ? 0.55 : 1.0;

                                    Text {
                                        x: 13px;
                                        y: 0;
                                        width: max(0px, parent.width - 13px - 30px);
                                        height: 20px;
                                        text: arow.label;
                                        color: arow.current ? AppTheme.player-fg-strong : AppTheme.player-text;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        x: 13px;
                                        y: 19px;
                                        width: max(0px, parent.width - 13px - 30px);
                                        height: 16px;
                                        text: arow.detail;
                                        color: AppTheme.player-text-soft;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    if arow.current : Path {
                                        x: parent.width - 22px;
                                        y: 14px;
                                        width: 11px;
                                        height: 10px;
                                        viewbox-width: 11;
                                        viewbox-height: 10;
                                        commands: "M 1 5.2 L 4.2 8.4 L 10 1.6";
                                        fill: #00000000;
                                        stroke: AppTheme.accent;
                                        stroke-width: 1.6px;
                                        stroke-line-cap: round;
                                    }
                                    if arow.locked : Path {
                                        x: parent.width - 24px;
                                        y: 13px;
                                        width: 12px;
                                        height: 12px;
                                        viewbox-width: 14;
                                        viewbox-height: 14;
                                        commands: "M 3.2 6.2 L 3.2 4.6 C 3.2 1.5, 10.8 1.5, 10.8 4.6 L 10.8 6.2 M 1.6 6.2 L 12.4 6.2 L 12.4 13.2 L 1.6 13.2 Z";
                                        fill: #00000000;
                                        stroke: AppTheme.player-text-dim;
                                        stroke-width: 1.4px;
                                        stroke-line-cap: round;
                                        stroke-line-join: round;
                                    }
                                    a_row := PanelHit {
                                        clicked => { root.audio_quality_pick(arow.id); }
                                        dismiss => { root.close-right(); }
                                    }
                                }

                                // No data yet: one quiet, disabled 自动 row instead
                                // of an empty popup, so the menu never opens onto a
                                // blank plate.
                                if root.quality_menu_rows.length == 0 : Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: 100%;
                                    height: 44px;
                                    border-radius: 6px;
                                    background: #00000000;

                                    Text {
                                        x: 14px;
                                        y: 4px;
                                        width: max(0px, parent.width - 28px);
                                        height: 20px;
                                        text: "自动";
                                        color: AppTheme.player-text-dim;
                                        font-size: 13.5px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        x: 14px;
                                        y: 22px;
                                        width: max(0px, parent.width - 28px);
                                        height: 17px;
                                        text: "正在获取可用画质";
                                        color: AppTheme.player-text-dim;
                                        font-size: 11.5px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ===================== 右下角 resize grip =====================
    // A designed affordance for the app-driven resize corner: an 18px square
    // (see `ResizeZone` edge 8 in ResizeFrame, which sits above this drawing
    // and maps that square to a bottom-right resize with the nwse-resize
    // cursor). Three short diagonal rounded strokes, "///" style. Plain
    // Rectangles/Paths take no pointer events, so the drawing itself never
    // blocks the canvas drag or the chrome. Declared after the panels so it
    // stays visible over a right strip; it brightens while the pointer is on
    // the picture (`chrome_shown`) and dims when it leaves.
    Rectangle {
        x: root.width - 18px;
        y: root.height - 18px;
        width: 18px;
        height: 18px;
        background: #00000000;

        Path {
            x: 0;
            y: 0;
            width: 18px;
            height: 18px;
            viewbox-width: 18;
            viewbox-height: 18;
            commands: "M 2 14 L 14 2 M 6 16 L 16 6 M 10 18 L 18 10";
            fill: #00000000;
            stroke: AppTheme.player-text-dim;
            stroke-width: 1.6px;
            stroke-line-cap: round;
            opacity: root.chrome_shown ? 0.85 : 0.32;
            animate opacity { duration: 160ms; easing: ease-out; }
        }
    }

    // ===================== KEY HANDLER =====================
    // Match a key event against a candidate-key index (0..=14), see 设置.
    function player_key_hit(kind: int, ev: KeyEvent) -> bool {
        if (kind == 0) { return ev.text == "m" || ev.text == "M"; }
        if (kind == 1) { return ev.text == "n" || ev.text == "N"; }
        if (kind == 2) { return ev.text == "b" || ev.text == "B"; }
        if (kind == 3) { return ev.text == Key.Space; }
        if (kind == 4) { return ev.text == Key.LeftArrow; }
        if (kind == 5) { return ev.text == Key.RightArrow; }
        if (kind == 6) { return ev.text == Key.UpArrow; }
        if (kind == 7) { return ev.text == Key.DownArrow; }
        if (kind == 8) { return ev.text == "f" || ev.text == "F"; }
        if (kind == 9) { return ev.text == "d" || ev.text == "D"; }
        if (kind == 10) { return ev.text == "q" || ev.text == "Q"; }
        if (kind == 11) { return ev.text == "s" || ev.text == "S"; }
        if (kind == 12) { return ev.text == Key.Escape; }
        if (kind == 13) { return ev.text == "p" || ev.text == "P"; }
        if (kind == 14) { return ev.text == Key.Return; }
        return false;
    }

    key_handler := FocusScope {
        key-pressed(event) => {
            if (root.dragging) {
                return EventResult.accept;
            }
            // The 画质 menu takes Esc before fullscreen: close the popup, do not
            // leave fullscreen on the same key.
            if (root.quality_expanded && event.text == Key.Escape) {
                root.quality_expanded = false;
                return EventResult.accept;
            }
            // Then the pill popovers (only one is ever up).
            if ((pill.vol_open || pill.dm_open) && event.text == Key.Escape) {
                pill.vol_open = false;
                pill.dm_open = false;
                return EventResult.accept;
            }
            // The zoom scrubber takes Esc first: close it, don't leave
            // fullscreen on the same key.
            if (root.scrub_level != 0 && event.text == Key.Escape) {
                root.scrub-close();
                return EventResult.accept;
            }
            if (root.key_map.length > 0 && root.player_key_hit(root.key_map[0], event)) {
                // Play returns the toolbar to level 0, like clicking the picture.
                root.scrub-close();
                root.toggle_pause();
                EventResult.accept
            } else if (root.key_map.length > 1 && root.player_key_hit(root.key_map[1], event)) {
                root.seek(max(0, root.position_ms - 5000));
                EventResult.accept
            } else if (root.key_map.length > 2 && root.player_key_hit(root.key_map[2], event)) {
                root.seek(min(root.duration_ms, root.position_ms + 5000));
                EventResult.accept
            } else if (root.key_map.length > 3 && root.player_key_hit(root.key_map[3], event)) {
                root.volume_changed(min(100, root.volume + 5));
                EventResult.accept
            } else if (root.key_map.length > 4 && root.player_key_hit(root.key_map[4], event)) {
                root.volume_changed(max(0, root.volume - 5));
                EventResult.accept
            } else if (root.key_map.length > 5 && root.player_key_hit(root.key_map[5], event)) {
                root.toggle_mute();
                EventResult.accept
            } else if (root.key_map.length > 6 && root.player_key_hit(root.key_map[6], event)) {
                root.toggle_fullscreen();
                EventResult.accept
            } else if (root.key_map.length > 7 && root.player_key_hit(root.key_map[7], event)) {
                if (root.fullscreen) {
                    root.toggle_fullscreen();
                }
                EventResult.accept
            } else if (root.key_map.length > 8 && root.player_key_hit(root.key_map[8], event)) {
                root.danmaku_on = !root.danmaku_on;
                root.danmaku_text = root.danmaku_on ? "弹幕开" : "弹幕关";
                EventResult.accept
            } else if (root.key_map.length > 9 && root.player_key_hit(root.key_map[9], event)) {
                root.toggle_like();
                EventResult.accept
            } else if (root.key_map.length > 10 && root.player_key_hit(root.key_map[10], event)) {
                root.take_screenshot();
                EventResult.accept
            } else if (event.text == Key.Escape && root.fullscreen) {
                root.toggle_fullscreen();
                EventResult.accept
            } else {
                EventResult.reject
            }
        }
    }

    // App-driven resize rim (see ResizeFrame). Declared after the key handler,
    // i.e. last, so its 8px bands are the topmost pointer target exactly in the
    // outer rim; the picture drag, chrome buttons and panels keep every pixel
    // from 8px in (14px at the corners, 18px in the grip square).
    ResizeFrame {
        resize-start(edge) => { root.resize_start(edge); }
        resize-move => { root.resize_move(); }
        resize-end => { root.resize_end(); }
    }
}

// ---------------------------------------------------------------------------
// Skeleton sweeps: the placeholder highlight for a cover that is still being
// fetched (phase B of a list load). The band position comes from the shared
// `skeleton-phase`; the 90ms animation interpolates between the low-frequency
// phase updates written from Rust, so the sweep reads as continuous motion
// while costing nothing once every cover has settled.
// ---------------------------------------------------------------------------
component SkeletonBand inherits Rectangle {
    width: 100%;
    height: 100%;
    clip: true;
    // A scrolling list turns the per-band sweep animation OFF (0ms): the band
    // still follows the shared phase, but nothing animates per card while the
    // feed moves.
    in property <bool> quiet: false;
    property <length> band-width: max(72px, self.width * 0.5);

    Rectangle {
        width: parent.band-width;
        height: parent.height;
        background: @linear-gradient(90deg, #00000000 0%, AppTheme.shimmer 50%, #00000000 100%);
        x: AppTheme.skeleton_phase * (parent.width + self.width) - self.width;
        animate x { duration: root.quiet ? 0ms : 90ms; easing: linear; }
    }
}

// ---------------------------------------------------------------------------
// Video cards. Every video list (home feed, region/rank,
// favourites, history, watch later, search, UP space) renders this one card
// primitive so the cover ratio, badge, hover treatment and type scale stay
// identical across views.
// ---------------------------------------------------------------------------
component VideoCardView inherits Rectangle {
    in property <length> card-width: 220px;
    in property <image> thumb;
    in property <string> title;
    in property <string> owner;
    in property <string> meta;
    in property <string> badge;
    in property <bool> show-owner: false;
    // The owner name is a link to the UP page (feed / UP page cards). The UP
    // page's own cards set it false: re-opening the page you are on is a no-op
    // the user cannot see, so the name stays plain text there.
    in property <bool> owner-link: true;
    // Card meta data for the redesign: the exact play count drives the rarity
    // dot, `pub_ts` (Unix seconds, 0 = unknown) drives the freshness chip, and
    // `now-ts` is the window's clock (0 = no clock, chips hidden).
    in property <int> view-count: 0;
    in property <int> pub-ts: 0;
    in property <int> now-ts: 0;
    in property <bool> people: false;
    in property <bool> show-remove: false;
    in property <string> remove-label: "删除";
    // The queue mark in the cover's top-right corner. Only the surfaces that
    // can hand an absolute index back to Rust turn it on (home feed and the
    // section grids); search results, favourites, history and 稍后 keep it off.
    in property <bool> show-queue: true;
    // The item is in the playlist: the mark stays visible and shows a check.
    // In-out so the card itself can set it the moment its own mark is used;
    // a host may bind it to real queue state instead.
    in-out property <bool> queued: false;
    // QA: publish this card's queue-mark rect (first card of a replay).
    in property <bool> probe: false;
    callback probe_rect(length, length, length, length);

    // The card surface is one translucent tint (`card`) over the window's
    // generated backdrop: no per-card image, no forwarding. The tint keeps the
    // cover and text readable over the gradient, exactly as it did over the
    // blurred desktop before.
    //
    // `quiet` gates motion: while the feed scrolls the hover washes and the
    // skeleton sweep stop animating, so a moving list runs no per-card
    // animation at all.
    in property <bool> quiet: false;
    // Refresh feedback, driven by ONE window clock (see AppWindow): a card
    // fades 0.55 -> 1 and lifts 6px into place, staggered 18ms per slot, only
    // for the first 12 slots of the visible page. `refresh_ms` is that clock.
    in property <bool> refresh_run: false;
    in property <int> refresh_ms: 0;
    in property <int> refresh_slot: 999;

    callback activate();
    callback play();
    callback owner-activate();
    callback remove-clicked();
    // Card pointer semantics: 0 = left (replace), 1 = right (new window),
    // 2 = ctrl+left (enqueue). Slint 1.18 pointer events carry
    // `modifiers`, so the Control state comes from the press itself rather
    // than a window-level key tracker.
    callback card_press(int);
    // The queue mark reports its click with the card's own index. Left click is
    // `queue`, right click `queue-only`: the wiring agent can map the second to
    // an "append without starting" path, or ignore it and use the first.
    callback queue();
    callback queue-only();

    property <length> cover-h: card-width * 0.5625;
    property <length> avatar-size: min(76px, card-width - 32px);
    // One hover truth for the card surface, the queue mark and the remove
    // button: whichever hit area owns the pointer, the card stays lifted and
    // the mark stays revealed (no flicker while moving onto the mark). While
    // the feed scrolls (`quiet`) hover is suppressed outright: rows move under
    // a stationary pointer, so any hover-driven wash would animate per frame.
    property <bool> card-hover: (card_area.has-hover || queue_hit.has-hover) && !root.quiet;

    // ---- meta line: title 18 / gap 6 / meta 20 / bottom 8 = 60px body ----
    // The title is exactly one line and ellipsizes; there is no full-title
    // hover surface any more. That frees 12px of every card, so grids use
    // `cover-h + 60px`.
    property <length> title-y: cover-h + 8px;
    property <length> meta-y: cover-h + 32px;

    // Freshness buckets, upper bound of each: <1h, <5h, <12h, <1d, <1w,
    // <1mo, <1q, <1y, older. Exponential, so the near-today steps are minutes
    // apart in feel and the far ones clamp into one quiet grey.
    pure function fresh_level(ts: int, now: int) -> int {
        if (ts <= 0 || now <= 0) { return -1; }
        let age = now - ts;
        if (age < 3600) { return 0; }
        if (age < 18000) { return 1; }
        if (age < 43200) { return 2; }
        if (age < 86400) { return 3; }
        if (age < 604800) { return 4; }
        if (age < 2592000) { return 5; }
        if (age < 7776000) { return 6; }
        if (age < 31536000) { return 7; }
        return 8;
    }
    pure function rarity_level(count: int) -> int {
        if (count < 1000) { return 0; }
        if (count < 10000) { return 1; }
        if (count < 100000) { return 2; }
        if (count < 1000000) { return 3; }
        if (count < 10000000) { return 4; }
        return 5;
    }

    property <int> fresh: fresh_level(pub-ts, now-ts);
    property <bool> show-fresh: fresh >= 0;
    property <bool> show-dot: view-count > 0;
    property <int> dot-level: rarity_level(view-count);
    property <[string]> fresh-labels: [
        "1小时内", "5小时前", "12小时前", "1天前", "1周前",
        "1个月前", "1季度前", "1年前", "更早"
    ];
    property <string> fresh-text: fresh >= 0 ? fresh-labels[fresh] : "";
    // The chip hugs its label: 11px text + 3px a side, radius 6, one 16px row.
    property <length> chip-w: fresh_label.preferred-width + 6px;
    property <length> chip-x: card-width - 9px - (show-fresh ? chip-w : 0px);
    property <length> dot-x: chip-x - (show-fresh ? 6px : 0px) - (show-dot ? 12px : 0px);
    // The owner name yields to the right-hand marks, then elides.
    property <length> name-max-w: max(0px, dot-x - 9px - ((show-dot || show-fresh) ? 8px : 0px));
    property <bool> name-shown: show-owner && owner != "";
    property <bool> dot-hover: dot_hit.has-hover && !root.quiet;
    // Hover on the UP name: a wash under the name. Suppressed while scrolling
    // for the same reason as `card-hover`.
    property <bool> owner-hover: owner_hit.has-hover && !root.quiet;

    // Refresh settle: delay = slot * 18ms (12 slots max), then a 160ms
    // ease-out fade/lift driven by the window clock. No timer here.
    property <bool> refresh_active: root.refresh_run && root.refresh_slot < 12;
    property <float> refresh_p: clamp((root.refresh_ms * 1.0 - root.refresh_slot * 18.0) / 160.0, 0, 1);
    property <float> refresh_ease: 1 - (1 - root.refresh_p) * (1 - root.refresh_p);
    property <length> refresh_lift: root.refresh_active ? (1 - root.refresh_ease) * 6px : 0px;

    width: card-width;
    height: cover-h + 60px;
    // Refresh settle (see the inputs above): a paint offset inside the fixed
    // slot, so the grid never re-lays out and the scroll position never moves.
    y: root.refresh_lift;
    opacity: root.refresh_active ? 0.55 + 0.45 * root.refresh_ease : 1;
    // The card surface is one translucent tint over the window's backdrop: the
    // root stays transparent so the gradient shows through the card the way the
    // blurred desktop used to, and the tint keeps the cover and text readable.
    // No root clip: the dot's tooltip is allowed to rise over the title line;
    // the cover and tint clip themselves.
    background: #00000000;
    border-radius: 10px;

    // Card surface below the cover/body: the ONE GlassPanel (diffused backdrop
    // + card tint + hairline), hover lifts the tint.
    GlassPanel {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        radius: 10px;
        tint: root.card-hover ? AppTheme.glass-tint-hover : AppTheme.glass-tint;
    }

    // ---- cover ----
    if !root.people : Rectangle {
        x: 1px;
        y: 1px;
        width: root.card-width - 2px;
        height: root.cover-h - 1px;
        background: AppTheme.thumb;
        border-radius: 9px;
        clip: true;

        Image {
            source: root.thumb;
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: root.thumb.width > 0 ? 1.0 : 0.0;
            animate opacity { duration: 220ms; easing: ease-out; }
        }

        if root.thumb.width <= 0 && AppTheme.skeletons_on : SkeletonBand {
            quiet: root.quiet;
        }
    }

    // A user search hit has a square avatar, not a 16:9 cover: centre it on a
    // soft panel so the grid still reads as one card system.
    if root.people : Rectangle {
        x: 1px;
        y: 1px;
        width: root.card-width - 2px;
        height: root.cover-h - 1px;
        background: AppTheme.card-alt;
        border-radius: 9px;

        Rectangle {
            width: root.avatar-size;
            height: root.avatar-size;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: self.width / 2;
            background: AppTheme.thumb;
            clip: true;

            Image {
                source: root.thumb;
                width: 100%;
                height: 100%;
                image-fit: cover;
                opacity: root.thumb.width > 0 ? 1.0 : 0.0;
                animate opacity { duration: 220ms; easing: ease-out; }
            }

            if root.thumb.width <= 0 && AppTheme.skeletons_on : SkeletonBand {
                quiet: root.quiet;
            }
        }
    }

    if !root.people : Rectangle {
        x: 1px;
        y: root.cover-h - 44px;
        width: root.card-width - 2px;
        height: 43px;
        background: @linear-gradient(0deg, #00000070 0%, #00000000 100%);
    }

    if root.badge != "" && !root.people : Rectangle {
        x: root.card-width - self.width - 7px;
        y: root.cover-h - 25px;
        width: badge_label.preferred-width + 12px;
        height: 18px;
        border-radius: 4px;
        background: #000000a6;

        badge_label := Text {
            text: root.badge;
            color: #ffffff;
            font-size: 10px;
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    card_area := TouchArea {
        width: 100%;
        height: 100%;
        // 0 left (replace) / 1 right (new window) / 2 ctrl+left (enqueue).
        pointer-event(event) => {
            if (event.kind != PointerEventKind.down) {
                return EventResult.reject;
            }
            // The queue mark's 28x28 + 10px inset corner is its own territory:
            // even if a paint/layout race ever put this area on top there, a
            // press there must never reach the open path.
            if (root.show-queue && !root.people && !root.show-remove
                && self.mouse-x >= root.card-width - 48px && self.mouse-y <= 48px) {
                return EventResult.accept;
            }
            if (event.button == PointerEventButton.right) {
                root.card_press(1);
                return EventResult.accept;
            }
            if (event.button == PointerEventButton.left) {
                root.card_press(event.modifiers.control ? 2 : 0);
                return EventResult.accept;
            }
            EventResult.reject
        }
    }

    // ---- queue mark: minimal 16px glyph, 10px in from the cover corner ----
    // No filled badge any more: a thin list mark (three rules) with a plus
    // over it, 1.4px stroke, on a 28% dark scrim so it stays legible on a
    // white/bright cover. The 28x28 hit area is centred on the glyph.
    // Declared after `card_area`, so it owns the press and the card does not
    // also open. Visible while the card is hovered OR the item is already
    // queued (then it shows a check). Right click reports `queue-only`.
    queue_btn := Rectangle {
        x: root.card-width - 38px;
        y: 10px;
        width: 28px;
        height: 28px;
        border-radius: 14px;
        // 28% black scrim: enough contrast for a 1.4px white stroke on a
        // bright cover, not a plate of its own.
        background: #00000047;
        visible: root.show-queue && !root.people && !root.show-remove;
        opacity: root.queued ? 1.0 : (root.card-hover ? 1.0 : 0.0);
        animate opacity { duration: 120ms; easing: ease-out; }

        // The three-rule list mark + a plus, drawn as one 16px stroked path.
        // A wider dark stroke underneath is the glyph's own edge: the 28%
        // scrim over a white cover is mid-grey, so the white strokes need a
        // contrast line there (no badge, just the mark).
        if !root.queued : Path {
            x: 6px;
            y: 6px;
            width: 16px;
            height: 16px;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 1.4 3.4 L 8.6 3.4 M 1.4 8 L 8.6 8 M 1.4 12.6 L 6.2 12.6 M 12 7.4 L 12 14.6 M 8.4 11 L 15.6 11";
            fill: #00000000;
            stroke: #000000a6;
            stroke-width: 3px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
        if !root.queued : Path {
            x: 6px;
            y: 6px;
            width: 16px;
            height: 16px;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 1.4 3.4 L 8.6 3.4 M 1.4 8 L 8.6 8 M 1.4 12.6 L 6.2 12.6 M 12 7.4 L 12 14.6 M 8.4 11 L 15.6 11";
            fill: #00000000;
            stroke: AppTheme.video-overlay-fg;
            stroke-width: 1.4px;
            stroke-line-cap: round;
            stroke-line-join: round;
            // The 28% scrim over a white cover is only mid-grey; the shadow
            // gives the thin white strokes an edge there without turning the
            // mark back into a badge.
        }

        // Queued: one 16px check in the same weight (same halo).
        if root.queued : Path {
            x: 6px;
            y: 6px;
            width: 16px;
            height: 16px;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 2.4 8.4 L 6.4 12.4 L 13.6 3.6";
            fill: #00000000;
            stroke: #000000a6;
            stroke-width: 3px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
        if root.queued : Path {
            x: 6px;
            y: 6px;
            width: 16px;
            height: 16px;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 2.4 8.4 L 6.4 12.4 L 13.6 3.6";
            fill: #00000000;
            stroke: AppTheme.video-overlay-fg;
            stroke-width: 1.4px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }

        queue_hit := TouchArea {
            accessible-role: button;
            accessible-label: root.queued ? "已在播放列表" : "加入播放列表";
            mouse-cursor: pointer;
            // Consume BOTH the press and the release here. `clicked` alone is
            // not enough: this mark sits inside the card's own hit area, and
            // the row/card handler used to also see the release and open the
            // video. Down/release are accepted (right button reports the
            // quieter queue-only on down; left queues on release).
            pointer-event(event) => {
                if (event.button == PointerEventButton.right) {
                    if (event.kind == PointerEventKind.down) {
                        root.queue-only();
                    }
                    return EventResult.accept;
                }
                if (event.button != PointerEventButton.left) {
                    return EventResult.reject;
                }
                if (event.kind == PointerEventKind.up) {
                    root.queued = true;
                    root.queue();
                }
                EventResult.accept
            }
        }
    }

    // QA: the queue mark's window rect, published while `probe` is armed.
    if root.probe : Rectangle {
        x: root.card-width - 38px;
        y: 10px;
        width: 0px;
        height: 0px;
        background: #00000000;
        property <length> ax: self.absolute-position.x;
        property <length> ay: self.absolute-position.y;

        Timer {
            interval: 80ms;
            running: root.probe;
            triggered => { root.probe_rect(ax, ay, 28px, 28px); }
        }
    }

    // ---- body: exactly one title line + a fixed 20px meta line ----
    Text {
        x: 9px;
        y: root.title-y;
        width: root.card-width - 18px;
        height: 18px;
        text: root.title;
        color: AppTheme.text;
        font-size: 13px;
        font-weight: 600;
        wrap: no-wrap;
        overflow: elide;
        vertical-alignment: center;
        horizontal-alignment: left;
    }

    // Owner name. No underline: hover lifts the type to `text` and lays a soft
    // accent tint behind it. Declared after `card_area`, so its own click never
    // also opens the card. The band hugs the name and yields to the marks.
    Rectangle {
        x: 6px;
        y: root.meta-y;
        width: min(owner_label.preferred-width + 6px, root.name-max-w + 6px);
        height: 20px;
        border-radius: 4px;
        visible: root.name-shown;
        background: root.name-shown && root.owner-link && root.owner-hover
            ? AppTheme.accent-soft
            : #00000000;
        animate background { duration: 120ms; easing: ease-out; }

        owner_label := Text {
            x: 3px;
            y: 0;
            width: parent.width - 6px;
            height: 20px;
            text: root.owner;
            color: root.owner-link && root.owner-hover ? AppTheme.text : AppTheme.text-soft;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            animate color { duration: 120ms; easing: ease-out; }
        }

        owner_hit := TouchArea {
            visible: root.owner-link;
            accessible-role: button;
            accessible-label: root.owner;
            mouse-cursor: pointer;
            clicked => { root.owner-activate(); }
        }
    }

    // No owner to show (search / favourites / history / 稍后 rows carry only a
    // pre-formatted meta string): keep that string on the left rather than
    // inventing a UP name the data does not have.
    Text {
        x: 9px;
        y: root.meta-y;
        width: root.name-shown ? 0px : root.name-max-w;
        height: 20px;
        text: root.meta;
        color: AppTheme.text-soft;
        font-size: 12px;
        visible: !root.name-shown;
        vertical-alignment: center;
        overflow: elide;
    }

    // Rarity bulb: the play count as one small lit lamp, grey -> gold. Three
    // concentric layers (12 / 9 / 6px) in the level colour make it glow instead
    // of reading as a flat dot; the hover lifts the two soft layers slightly.
    // The exact number is the bulb's tooltip; its 16px hit swallows the click
    // so it never opens the card.
    dot_hit := TouchArea {
        x: root.dot-x - 2px;
        y: root.meta-y;
        width: 16px;
        height: 20px;
        visible: root.show-dot;
        clicked => { }
    }

    // Outer glow: 12px at ~18% alpha (brightens to ~26% on card hover).
    Rectangle {
        x: root.dot-x;
        y: root.meta-y + 4px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        visible: root.show-dot;
        background: AppTheme.rarity-ramp[root.dot-level].transparentize(root.card-hover ? 0.74 : 0.82);
        animate background { duration: 120ms; easing: ease-out; }
    }

    // Mid glow: 9px at ~35% alpha.
    Rectangle {
        x: root.dot-x + 1.5px;
        y: root.meta-y + 5.5px;
        width: 9px;
        height: 9px;
        border-radius: 4.5px;
        visible: root.show-dot;
        background: AppTheme.rarity-ramp[root.dot-level].transparentize(root.card-hover ? 0.52 : 0.65);
        animate background { duration: 120ms; easing: ease-out; }
    }

    // Core: 6px, solid.
    Rectangle {
        x: root.dot-x + 3px;
        y: root.meta-y + 7px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        visible: root.show-dot;
        background: AppTheme.rarity-ramp[root.dot-level];
    }

    // Freshness chip: 11px label, 3px a side, radius 6. It fades in on paint so
    // a streaming model never snaps a column of chips into place.
    Rectangle {
        x: root.chip-x;
        y: root.meta-y + 2px;
        width: root.chip-w;
        height: 16px;
        border-radius: 6px;
        visible: root.show-fresh;
        background: AppTheme.fresh-ramp[max(0, root.fresh)].transparentize(0.84);

        fresh_label := Text {
            text: root.fresh-text;
            color: AppTheme.fresh-ramp[max(0, root.fresh)];
            font-size: 11px;
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Dot tooltip: the exact count, left of the mark on the meta line, so it
    // never hides the title above it. Clipped to the card's own width.
    if root.dot-hover && root.show-dot : Rectangle {
        x: clamp(root.dot-x - self.width - 6px, 4px, root.card-width - self.width - 4px);
        y: root.meta-y + 1px;
        width: dot_tip_label.preferred-width + 12px;
        height: 18px;
        border-radius: 6px;
        background: AppTheme.bar-fill;
        border-width: 1px;
        border-color: AppTheme.border-popup;
        drop-shadow-color: #0000002e;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 3px;

        dot_tip_label := Text {
            text: root.view-count >= 10000
                ? ((root.view-count / 10000.0).to-fixed(1) + "万")
                : (root.view-count * 1.0).to-fixed(0);
            color: AppTheme.text;
            font-size: 10.5px;
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Hover shows only the tint lift above; the whole card opens the player on
    // click (see `card_area`), so there is no separate play-button overlay.
    // The `play` callback stays declared - Rust and the feed grid wire it.

    if root.show-remove : Rectangle {
        x: root.card-width - 59px;
        y: 7px;
        width: 51px;
        height: 22px;
        border-radius: 5px;
        background: AppTheme.danger-bg;
        border-width: 1px;
        border-color: AppTheme.danger-border;

        Text {
            text: root.remove-label;
            color: AppTheme.danger;
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        remove_area := TouchArea {
            clicked => { root.remove-clicked(); }
        }
    }
}

// ---------------------------------------------------------------------------
// 收藏推荐 masonry.
//
// The card is the home card's surface and type scale. Every slot is the SAME
// height: a 16:9 cover plus the 60px body (one title line + meta). Uniformity
// is deliberate - the placeholders and the loaded cards are one layout, so the
// grid never reflows when a page or a cover lands. The `aspect` field is still
// published by Rust for diagnostics, but geometry no longer follows it.
// ---------------------------------------------------------------------------
component MasonryCardView inherits Rectangle {
    in property <length> card-width: 220px;
    in property <image> thumb;
    in property <string> title;
    in property <string> owner;
    in property <string> duration;

    callback activate();

    // Refresh settle (see VideoCardView / AppWindow): stagger by COLUMN, so the
    // three columns ripple left to right. 18ms per column, 160ms ease-out.
    in property <bool> refresh_run: false;
    in property <int> refresh_ms: 0;
    in property <int> refresh_col: 0;

    // ONE cover ratio for every slot: 16:9. The masonry used to keep each
    // publisher's own h/w, which made a card's height depend on when its image
    // decoded; the grid reflowed on cover arrival and a skeleton could never
    // match. A fixed ratio makes every slot exactly card-w * 0.5625 + 60px,
    // the same formula the skeleton and the real card use (see the f143 pass).
    property <length> cover-h: card-width * 0.5625;
    property <bool> card-hover: card_area.has-hover;
    property <float> refresh_p: clamp((refresh_ms * 1.0 - refresh_col * 18.0) / 160.0, 0, 1);
    property <float> refresh_ease: 1 - (1 - refresh_p) * (1 - refresh_p);

    width: card-width;
    height: cover-h + 60px;
    // Paint offset only: the slot keeps its height, so the grid never reflows.
    y: refresh_run ? (1 - refresh_ease) * 6px : 0px;
    opacity: refresh_run ? 0.55 + 0.45 * refresh_ease : 1;
    background: #00000000;
    border-radius: 10px;
    clip: true;

    GlassPanel {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        radius: 10px;
        tint: root.card-hover ? AppTheme.glass-tint-hover : AppTheme.glass-tint;
    }

    // ---- cover ----
    Rectangle {
        x: 1px;
        y: 1px;
        width: root.card-width - 2px;
        height: root.cover-h - 1px;
        background: AppTheme.thumb;
        border-radius: 9px;
        clip: true;

        Image {
            source: root.thumb;
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: root.thumb.width > 0 ? 1.0 : 0.0;
            animate opacity { duration: 220ms; easing: ease-out; }
        }

        if root.thumb.width <= 0 && AppTheme.skeletons_on : SkeletonBand { }
    }

    // Duration badge, the same bottom-right pill as the 16:9 card.
    if root.duration != "" : Rectangle {
        x: root.card-width - self.width - 7px;
        y: root.cover-h - 25px;
        width: dur_label.preferred-width + 12px;
        height: 18px;
        border-radius: 4px;
        background: AppTheme.video-overlay-bg;

        dur_label := Text {
            text: root.duration;
            color: AppTheme.video-overlay-fg;
            font-size: 10px;
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    card_area := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.activate(); }
    }

    // One line, ellipsized - the same contract as VideoCardView. No second
    // line, no hover surface: a card never grows text on pointer-over.
    Text {
        x: 9px;
        y: root.cover-h + 8px;
        width: root.card-width - 18px;
        height: 18px;
        text: root.title;
        color: AppTheme.text;
        font-size: 13px;
        font-weight: 600;
        wrap: no-wrap;
        overflow: elide;
        vertical-alignment: center;
        horizontal-alignment: left;
    }

    Text {
        x: 9px;
        y: root.cover-h + 32px;
        width: root.card-width - 18px;
        height: 16px;
        text: root.owner;
        color: AppTheme.accent;
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Skeleton fill for the masonry's loading shape. It is the REAL card layout
// with its ink removed: the same width, the same 16:9 cover and the same 60px
// body, so a slot's rect is identical before and after the page lands (f143
// diffs the two captures). The cover keeps the shared shimmer sweep.
component MasonrySkeletonBlock inherits Rectangle {
    in property <length> card-width: 220px;

    property <length> cover-h: root.card-width * 0.5625;

    width: root.card-width;
    height: root.cover-h + 60px;
    border-radius: 10px;
    background: AppTheme.card;
    clip: true;

    // cover: 1px inset, 9px radius - MasonryCardView's exact cover rect
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: root.cover-h - 1px;
        border-radius: 9px;
        background: AppTheme.thumb;
        clip: true;

        if AppTheme.skeletons_on : SkeletonBand { }
    }

    // title line: the real card puts an 18px text line at cover + 8px
    Rectangle {
        x: 9px;
        y: root.cover-h + 10px;
        width: (parent.width - 18px) * 0.62;
        height: 11px;
        border-radius: 3px;
        background: AppTheme.thumb;
    }

    // meta line: the real card puts a 16px line at cover + 32px
    Rectangle {
        x: 9px;
        y: root.cover-h + 34px;
        width: (parent.width - 18px) * 0.36;
        height: 9px;
        border-radius: 3px;
        background: AppTheme.thumb;
    }
}

// 收藏推荐 masonry, virtualised.
//
// The column rule is untouched: item i (0-based, absolute) always lives in
// column `i % cols`, so a card's column - and its order inside that column -
// is fixed by the published list. The scroll offset plays no part and an
// appended card can never move an existing one. At `cols == 2` the third column
// is hidden (and is empty by construction, because the split uses `i % cols`).
//
// What changed is only how many cards exist at once. The old build stacked
// every card of the folder in three VerticalLayouts, so all of them were
// created even far off screen.
//
// Three columns each with their own ListView sharing one `content-y` were
// rejected: every column has its own content height, so each list clamps the
// shared offset at a different range and the columns drift apart at the bottom.
// The bands below are one list instead.
//
// The masonry's band list: one ListView of BANDS.
//
// Band b holds the next `cols` cards (absolute indices b*cols + c), one per
// column at its old x, and is exactly one uniform slot tall. Placement is a
// pure function of the published list, so the column rule (`i % cols`) and
// every card's position are fixed by the list itself - the scroll offset plays
// no part and an appended card can never move an existing one. Because every
// card is 16:9 + 60px (see MasonryCardView), the band is also exactly what the
// skeleton paints, so the load cannot reflow the page.
//
// The reset lives in FavMasonry, which swaps this component for a fresh one:
// a new ListView starts with no row anchor, which is the only reset that
// cannot be undone by the next virtualised layout pass.
component MasonryBands inherits ListView {
    in property <[MasonryCard]> items;
    in property <int> cols: 3;
    // A card's slot width and the block's left edge, from FavMasonry.
    in property <length> card-w: 220px;
    in property <length> x0: 0px;
    in property <length> gap: 12px;
    // No cards yet means the folder is still loading: the skeleton shape is
    // three bands (nine blocks at 3 columns, six at 2), as before.
    in property <bool> loading: false;
    // Refresh feedback clock (see AppWindow): stagger by column.
    in property <bool> refresh_run: false;
    in property <int> refresh_ms: 0;

    callback open(string);
    // QA: publish the vertical offset (see FavMasonry).
    callback offset_changed(length);
    changed content-y => { root.offset_changed(self.content-y); }

    property <int> band-count: loading ? 3 : (items.length + cols - 1) / cols;

    // ONE slot for every card and every placeholder: a 16:9 cover + the 60px
    // body + this column's 12px tail. Keep in step with MasonryCardView and
    // MasonrySkeletonBlock (both are card-w * 0.5625 + 60px tall).
    property <length> slot-h: root.card-w * 0.5625 + 60px + root.gap;

    width: 100%;
    height: 100%;
    // Wheel only: no scrollbar, and the drag is reserved for the window.
    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
    mouse-drag-pan-enabled: false;

    for b in band-count : Rectangle {
            property <int> base: b * root.cols;
            // Every band is exactly one uniform slot tall, whether it holds
            // real cards or placeholders. A partial last band keeps the same
            // height instead of inventing a shorter row.
            property <length> band-h: root.slot-h;

            width: 100%;
            // The last band also reserves the page bar clearance, the same
            // trailing inset the paged grids carry.
            height: band-h + (b == band-count - 1 ? AppTheme.bar-clearance : 0px);
            background: #00000000;

            // ---- column 0 ----
            if !root.loading && base < root.items.length : MasonryCardView {
                x: root.x0;
                y: 0;
                card-width: root.card-w;
                thumb: root.items[base].cover;
                title: root.items[base].title;
                owner: root.items[base].owner;
                duration: root.items[base].duration;
                refresh_run: root.refresh_run;
                refresh_ms: root.refresh_ms;
                refresh_col: 0;
                activate => { root.open(root.items[base].bvid); }
            }

            // ---- column 1 ----
            if !root.loading && root.cols > 1 && base + 1 < root.items.length : MasonryCardView {
                x: root.x0 + root.card-w + root.gap;
                y: 0;
                card-width: root.card-w;
                thumb: root.items[base + 1].cover;
                title: root.items[base + 1].title;
                owner: root.items[base + 1].owner;
                duration: root.items[base + 1].duration;
                refresh_run: root.refresh_run;
                refresh_ms: root.refresh_ms;
                refresh_col: 1;
                activate => { root.open(root.items[base + 1].bvid); }
            }

            // ---- column 2 (3-column mode only) ----
            if !root.loading && root.cols > 2 && base + 2 < root.items.length : MasonryCardView {
                x: root.x0 + (root.card-w + root.gap) * 2;
                y: 0;
                card-width: root.card-w;
                thumb: root.items[base + 2].cover;
                title: root.items[base + 2].title;
                owner: root.items[base + 2].owner;
                duration: root.items[base + 2].duration;
                refresh_run: root.refresh_run;
                refresh_ms: root.refresh_ms;
                refresh_col: 2;
                activate => { root.open(root.items[base + 2].bvid); }
            }

            // ---- skeleton masonry while the folder is loading ----
            // Card-shaped blocks at the SAME rect as the real cards: same
            // width, same 16:9 cover, same 60px body. Nine at 3 columns, six
            // at 2. The shimmer is the shared SkeletonBand inside the cover.
            if root.loading : MasonrySkeletonBlock {
                x: root.x0;
                y: 0;
                card-width: root.card-w;
            }
            if root.loading && root.cols > 1 : MasonrySkeletonBlock {
                x: root.x0 + root.card-w + root.gap;
                y: 0;
                card-width: root.card-w;
            }
            if root.loading && root.cols > 2 : MasonrySkeletonBlock {
                x: root.x0 + (root.card-w + root.gap) * 2;
                y: 0;
                card-width: root.card-w;
            }
    }
}

// 收藏推荐 masonry: the band list inside a shell that owns the reset.
//
// The column block is centred in the page (x0) and the page bar's 84px
// clearance is on the last band. A refresh or folder switch replaces the list
// with a freshly instantiated one (see the block at the bottom): writing
// `content-y` back into a virtualised list whose rows sit on a deep anchor was
// measured to leave the old rows painted at the top - a fresh list cannot.
component FavMasonry inherits Rectangle {
    in property <[MasonryCard]> items;
    in property <int> cols: 3;
    // Width the columns are sized from (the page's content width).
    in property <length> available-width: 400px;
    // Width of the masonry itself; the column block is centred inside it.
    in property <length> viewport-width: 400px;
    in property <length> gap: 12px;
    // Refresh feedback clock (see AppWindow): stagger by column.
    in property <bool> refresh_run: false;
    in property <int> refresh_ms: 0;
    // Scroll reset: the refresh / folder-switch epoch (see below) and the card
    // count of the published model.
    in property <int> reset: 0;
    in property <int> item-count: 0;

    callback open(string);

    // QA: the live band list's vertical offset.
    out property <length> scroll-y: 0px;
    // QA: publish this masonry's window y (its top is the content top of the
    // two folder-scoped 收藏 tabs), so the replay can prove a tab switch does
    // not move the content.
    in property <bool> probe: false;
    callback probe_rect(length, length, length, length);

    property <length> card-w: max(120px, (available-width - gap * (cols - 1)) / cols);
    property <length> row-w: card-w * cols + gap * (cols - 1);
    property <length> x0: (viewport-width - row-w) / 2;
    property <bool> loading: items.length == 0;
    // Which of the two band lists is live; a reset flips it.
    property <bool> alt: false;

    background: #00000000;

    if !root.alt : MasonryBands {
        width: 100%;
        height: 100%;
        items: root.items;
        cols: root.cols;
        card-w: root.card-w;
        x0: root.x0;
        gap: root.gap;
        loading: root.loading;
        refresh_run: root.refresh_run;
        refresh_ms: root.refresh_ms;
        offset_changed(y) => { root.scroll-y = y; }
        open(bvid) => { root.open(bvid); }
    }

    if root.alt : MasonryBands {
        width: 100%;
        height: 100%;
        items: root.items;
        cols: root.cols;
        card-w: root.card-w;
        x0: root.x0;
        gap: root.gap;
        loading: root.loading;
        refresh_run: root.refresh_run;
        refresh_ms: root.refresh_ms;
        offset_changed(y) => { root.scroll-y = y; }
        open(bvid) => { root.open(bvid); }
    }

    // 2px accent sweep, once per refresh, left -> right in 320ms. It sits at the
    // masonry's top, which a reset holds at the first band. Plain Rectangle:
    // pointer-transparent, so it never blocks input.
    property <float> sweep_p: clamp(refresh_ms * 1.0 / 320.0, 0, 1);
    property <float> sweep_fade: sweep_p < 0.82
        ? 1.0
        : clamp((1.0 - sweep_p) / 0.18, 0, 1);

    Rectangle {
        x: -self.width + (root.width + self.width) * root.sweep_p;
        y: 0;
        width: max(24px, root.width * 0.3);
        height: 2px;
        border-radius: 1px;
        background: AppTheme.accent;
        opacity: refresh_run ? 0.9 * root.sweep_fade : 0;
    }

    // Zero-size sentinel: its absolute position IS the masonry's top-left. The
    // timer keeps republishing because layout settles asynchronously. `x`/`y`
    // are explicit: an unpositioned child of a Rectangle is centred, not
    // pinned to the corner.
    if root.probe : Rectangle {
        x: 0;
        y: 0;
        width: 0px;
        height: 0px;
        background: #00000000;
        property <length> ay: self.absolute-position.y;

        Timer {
            interval: 80ms;
            running: root.probe;
            triggered => { root.probe_rect(0px, ay, root.width, root.height); }
        }
    }

    // ---- reset: a FRESH list, so the first band is on screen ----
    // A virtualised ListView keeps its row anchor in layout state that a
    // `content-y` write cannot reliably clear: measured on this list, writing 0
    // (with the 1px pass-forcing kicks FeedScroller uses) left the list at
    // `content-y: 0` while the rows from the deep anchor were still the ones
    // painted. Swapping in a newly instantiated list has no anchor at all, so
    // the reset is exact and needs no timers, no kicks and no watchdog.
    // `reset` is the refresh / folder-switch epoch and `item-count` catches a
    // list that lands after that epoch already fired.
    function reset-generation() {
        root.alt = !root.alt;
    }

    changed reset => { root.reset-generation(); }
    changed item-count => { root.reset-generation(); }
}

// One folder chip of the 收藏推荐 tab strip. The strip itself (WheelStrip) owns
// the wheel, so the chip only has to be clickable.
component FavTabChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 30px;
    width: max(58px, label_text.preferred-width + 28px);
    border-radius: 15px;
    background: root.active
        ? AppTheme.accent
        : (chip_hit.has-hover ? AppTheme.pill-hover : AppTheme.pill-bg);
    animate background { duration: 120ms; easing: ease-out; }

    label_text := Text {
        text: root.label;
        color: root.active ? AppTheme.accent-fg : AppTheme.pill-fg;
        font-size: 12px;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    chip_hit := TouchArea {
        accessible-role: button;
        accessible-label: root.label;
        clicked => { root.clicked(); }
    }
}

// One reusable horizontal chip strip. The wheel scrolls it when the pointer is
// ANYWHERE inside the strip's rectangle - its padding, the gaps between chips,
// the empty tail after the last chip - and the event is consumed, so nothing
// behind the strip (the page, a list) scrolls at the same time.
//
// Why not a ScrollView: a Flickable turns a wheel delta into a pan only along
// the axis that OVERFLOWS, so a horizontal-only strip rejects a plain vertical
// wheel and the page scrolls instead. Why not an overlay on top: a TouchArea's
// `pointer-event` cannot reject a press (Slint ignores its result), so an
// overlay would eat every chip click - the exact bug this component replaces.
// The wheel surface therefore sits UNDER the chips and covers the viewport:
// a chip takes the press, but a wheel over a chip is rejected by the chip and
// falls through to this surface. Padding and gaps reach it directly.
component WheelStrip inherits Rectangle {
    // Padding that is part of the strip's hit rectangle but holds no chip - the
    // left/right air and the fade edges live here.
    in property <length> inset: 6px;
    in property <length> chip-gap: 6px;
    // Live horizontal offset (0 = at the start, negative = scrolled right).
    // `in-out` so a page can own it: a strip that is destroyed and rebuilt (the
    // 收藏 page hides it on 历史 / 稍后) comes back at the same offset, and two
    // callers can share one offset through a root property.
    in-out property <length> offset: 0px;
    out property <length> max-offset: max(0px, strip_content.preferred-width - root.width);
    // A shorter chip row (a folder was deleted, the window grew) clamps the
    // offset the page handed back, so the strip can never sit past its end.
    changed max-offset => {
        root.offset = max(-root.max-offset, min(0px, root.offset));
    }
    // QA: while true, publish this strip's window rect so the env-driven replay
    // can aim a wheel at the left padding without any OS-level input.
    in property <bool> probe: false;
    callback probe_rect(length, length, length, length);

    background: #00000000;
    clip: true;

    // The wheel surface: UNDER the chips, over the whole viewport. Its own
    // presses land only on padding / gaps, where there is nothing else to click.
    strip_wheel := TouchArea {
        width: 100%;
        height: 100%;
        accessible-role: none;

        scroll-event(event) => {
            let delta = event.delta-y != 0 ? event.delta-y : event.delta-x;
            if (delta != 0) {
                root.scroll_by(delta);
                return EventResult.accept;
            }
            EventResult.reject
        }
    }

    // The chips, moved by `offset`. A layout's own width must be its preferred
    // width here, otherwise it would be clamped to the viewport and never
    // overflow.
    strip_content := HorizontalLayout {
        x: root.offset;
        width: self.preferred-width;
        height: 100%;
        padding-left: root.inset;
        padding-right: root.inset;
        spacing: root.chip-gap;
        @children
    }

    function scroll_by(delta: length) {
        root.offset = max(-root.max-offset, min(0px, root.offset + delta));
    }

    // Zero-size sentinel: its absolute position IS the strip's top-left. The
    // timer keeps republishing because layout settles asynchronously.
    if root.probe : Rectangle {
        x: 0;
        y: 0;
        width: 0px;
        height: 0px;
        background: #00000000;
        property <length> ax: self.absolute-position.x;
        property <length> ay: self.absolute-position.y;

        Timer {
            interval: 80ms;
            running: root.probe;
            triggered => { root.probe_rect(ax, ay, root.width, root.height); }
        }
    }
}

// The one centred segmented switcher used by 收藏 (four library tabs) and 消息
// (four message sections). One flat track, the active tab filled with the
// accent; the track itself is centred in the content column.
component TabSwitch inherits Rectangle {
    in property <[string]> labels;
    in property <int> index: 0;
    callback pick(int);

    // QA: the laid-out track origin (window coordinates) and each of the first
    // two item widths. Read by the f136 measurement pass; a static binding, so
    // normal use pays nothing.
    out property <length> track_x: tab_row.absolute-position.x;
    out property <length> track_y: tab_row.absolute-position.y;
    out property <length> tab0_w: 64px;
    out property <length> tab1_w: 64px;

    height: 32px;
    background: #00000000;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        alignment: center;

        Rectangle {
            height: 32px;
            width: tab_row.preferred-width;
            border-radius: 16px;
            background: AppTheme.card;

            tab_row := HorizontalLayout {
                padding: 3px;
                spacing: 2px;

                for label[index] in root.labels : Rectangle {
                    width: max(64px, tab_text.preferred-width + 30px);
                    height: 26px;
                    border-radius: 13px;
                    background: root.index == index
                        ? AppTheme.accent
                        : (tab_hit.has-hover ? AppTheme.pill-hover : #00000000);
                    animate background { duration: 120ms; easing: ease-out; }

                    init => {
                        if (index == 0) { root.tab0_w = self.width; }
                        if (index == 1) { root.tab1_w = self.width; }
                    }
                    changed width => {
                        if (index == 0) { root.tab0_w = self.width; }
                        if (index == 1) { root.tab1_w = self.width; }
                    }

                    tab_text := Text {
                        width: 100%;
                        height: 100%;
                        text: label;
                        color: root.index == index ? AppTheme.accent-fg : AppTheme.text-soft;
                        font-size: 12px;
                        font-weight: root.index == index ? 600 : 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    tab_hit := TouchArea {
                        accessible-role: button;
                        accessible-label: label;
                        clicked => { root.pick(index); }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// 养鱼 · components
// ---------------------------------------------------------------------------

// The fish itself: five hand-drawn SVG stages, no bitmap. `body_w` is the
// BODY's own width (44 -> 96 px); the viewbox is 62 units wide across the body,
// so the element is a little wider than `body_w` by design (tail included).
component FishAvatar inherits Rectangle {
    in property <int> stage: 0;
    in property <bool> running: false;
    in property <color> ink: AppTheme.accent;

    property <length> body_w: 44px + root.stage * 13px;
    property <color> eye_ink: AppTheme.dark ? #0b0b0b : #ffffff;

    width: root.body_w * 1.61;
    height: root.body_w * 1.13;
    background: #00000000;

    // tail
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 70;
        commands: "M 32 35 L 6 17 C 11 27, 11 43, 6 53 Z";
        fill: root.ink.transparentize(0.45);
        stroke: root.ink;
        stroke-width: 1.2px;
        stroke-line-join: round;
    }
    // body
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 70;
        commands: "M 30 35 C 30 12, 76 8, 92 35 C 76 62, 30 58, 30 35 Z";
        fill: root.ink.transparentize(0.22);
        stroke: root.ink;
        stroke-width: 1.5px;
    }
    // dorsal fin
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 70;
        commands: "M 54 15 C 60 5, 72 5, 79 14";
        fill: #00000000;
        stroke: root.ink;
        stroke-width: 1.2px;
        stroke-line-cap: round;
    }
    // gill
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 70;
        commands: "M 63 23 C 57 30, 57 40, 63 47";
        fill: #00000000;
        stroke: root.ink;
        stroke-width: 1.1px;
        stroke-line-cap: round;
    }
    // eye
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 70;
        commands: "M 81 28 A 4 4 0 1 1 80.9 28 Z";
        fill: root.eye_ink;
        stroke: #00000000;
    }
}

// One 食谱 card: 172x96, radius 12. The active card carries a 1px accent border
// and a check mark; hovering any card lifts the border to accent at 60 %.
component FishRecipeCard inherits Rectangle {
    in property <RecipeRow> item;
    in property <bool> active: false;
    callback pick(string);

    width: 172px;
    height: 96px;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.active
        ? AppTheme.accent
        : (hit.has-hover ? AppTheme.accent.transparentize(0.4) : AppTheme.bar-border);
    background: root.active
        ? AppTheme.accent.transparentize(0.9)
        : (hit.has-hover ? AppTheme.card-alt : AppTheme.card);
    animate border-color { duration: 120ms; easing: ease-out; }
    animate background { duration: 120ms; easing: ease-out; }

    Text {
        x: 12px;
        y: 12px;
        width: 132px;
        height: 18px;
        text: root.item.name;
        color: AppTheme.text;
        font-size: 12.5px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 12px;
        y: 34px;
        width: 148px;
        height: 30px;
        text: root.item.tagline;
        color: AppTheme.text-soft;
        font-size: 10.5px;
        wrap: word-wrap;
        max-lines: 2;
        overflow: elide;
        vertical-alignment: top;
    }
    if root.active : Path {
        x: 148px;
        y: 11px;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 1 6 L 4.4 9.4 L 11 1.8";
        fill: #00000000;
        stroke: AppTheme.accent;
        stroke-width: 1.6px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    hit := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.item.name;
        clicked => { root.pick(root.item.id); }
    }
}

// The 推荐流 card: the verdict is the hero, the cover is context.
//
// Fixed 222px slot, independent of the column width:
//   18px padding | 4px verdict rail | 96x54 thumbnail on the title row
//   verdict 20/800, score 28/700, title 14/600 (2 lines)
//   one-line 13/1.55 text-body (2 lines)
//   reasons 12 text-soft (1 line each), footer 10.5 text-faint
// The old 16:9 hero cover is gone. A small right-aligned thumbnail is enough
// to recognise the video; a missing cover becomes a tinted block with the UP's
// first glyph, never an empty hole.
component FishCard inherits Rectangle {
    in property <FishRow> item;
    in property <length> cw: 548px;
    callback open(string);

    property <length> pad: 18px;
    property <length> rail_w: 4px;
    property <length> thumb_w: 96px;
    property <length> thumb_h: 54px;
    property <length> title_row_h: 54px;
    property <length> body_gap: 14px;
    property <length> line_h: 48px;
    property <length> reasons_y: root.pad + root.title_row_h + root.body_gap + root.line_h + 12px;
    property <length> footer_y: root.reasons_y + 34px + 10px;

    property <bool> good: root.item.verdict == "看";
    property <bool> skip: root.item.verdict == "不看";
    property <color> amber_ink: AppTheme.dark ? #f0b45c : #a35c10;
    // Rail and verdict word share one ink: accent for 看, amber for 也许,
    // neutral for 不看. The score stays in the body ink so the number reads
    // first and the colour belongs to the decision.
    property <color> rail_ink: root.good
        ? AppTheme.accent
        : (root.skip ? AppTheme.text-faint : root.amber_ink);
    property <bool> has_cover: root.item.cover.width > 0;

    pure function footer() -> string {
        let time = root.item.time_text == "" ? "" : root.item.time_text + " 起看 · ";
        let tags = root.item.tag_line == "" ? "" : root.item.tag_line + " · ";
        let up = root.item.up_name == "" ? "UP主未知" : root.item.up_name;
        return time + tags + up + " · " + root.item.age + " · 去B站看 →";
    }

    width: root.cw;
    // Keep in step with fish_page.card_h (the feed row height).
    height: 222px;
    background: #00000000;

    plate := GlassPanel {
        x: 0;
        y: hit.has-hover ? -2px : 0px;
        width: 100%;
        height: 100%;
        radius: 14px;
        shadow: hit.has-hover;
        shadow-blur: 18px;
        shadow-color: #00000033;
        animate y { duration: 120ms; easing: ease-out; }

        // ---- 4px verdict rail, full height, clipped by the 14px radius ----
        Rectangle {
            x: 0;
            y: 0;
            width: root.rail_w;
            height: 100%;
            background: root.rail_ink;
        }

        // ---- title row: verdict - score - title - thumbnail ----
        Text {
            x: root.pad;
            y: root.pad;
            width: 44px;
            height: root.title_row_h;
            text: root.item.verdict;
            color: root.rail_ink;
            font-size: 20px;
            font-weight: 800;
            vertical-alignment: center;
            overflow: elide;
        }
        // The 56px column is fixed so a decimal score never shifts the title;
        // that is the layout equivalent of tabular figures (Slint does not
        // expose font-variant-numeric).
        Text {
            x: root.pad + 44px;
            y: root.pad;
            width: 56px;
            height: root.title_row_h;
            text: root.item.score_text;
            color: AppTheme.text;
            font-size: 28px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: left;
            overflow: elide;
        }
        Text {
            x: root.pad + 100px;
            y: root.pad;
            width: max(0px, root.cw - (root.pad + 100px) - root.pad - root.thumb_w - 12px);
            height: root.title_row_h;
            text: root.item.title;
            color: AppTheme.text;
            font-size: 14px;
            font-weight: 600;
            wrap: word-wrap;
            max-lines: 2;
            overflow: elide;
            vertical-alignment: center;
        }

        // ---- 96x54 thumbnail: context, right-aligned on the title row ----
        Rectangle {
            x: root.cw - root.pad - root.thumb_w;
            y: root.pad;
            width: root.thumb_w;
            height: root.thumb_h;
            border-radius: 8px;
            clip: true;
            background: AppTheme.thumb;

            if root.has_cover : Image {
                width: 100%;
                height: 100%;
                source: root.item.cover;
                image-fit: cover;
            }
            // Missing cover: a flat tinted block with the UP's first glyph.
            if !root.has_cover : Text {
                width: 100%;
                height: 100%;
                text: root.item.up_glyph == "" ? "·" : root.item.up_glyph;
                color: AppTheme.text-soft;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // ---- one-line conclusion: 13 / 1.55, two lines ----
        Text {
            x: root.pad;
            y: root.pad + root.title_row_h + root.body_gap;
            width: root.cw - root.pad * 2;
            height: root.line_h;
            text: root.item.one_line;
            color: AppTheme.text-body;
            font-size: 13px;
            line-height-factor: 1.55;
            wrap: word-wrap;
            max-lines: 2;
            overflow: elide;
            vertical-alignment: top;
        }

        // ---- up to two reasons: 12, one line each ----
        Text {
            x: root.pad;
            y: root.reasons_y;
            width: root.cw - root.pad * 2;
            height: 17px;
            visible: root.item.reason1 != "";
            text: "· " + root.item.reason1;
            color: AppTheme.text-soft;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            x: root.pad;
            y: root.reasons_y + 17px;
            width: root.cw - root.pad * 2;
            height: 17px;
            visible: root.item.reason2 != "";
            text: "· " + root.item.reason2;
            color: AppTheme.text-soft;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        // ---- footer: time - tags - UP - age - 去B站看 ----
        Text {
            x: root.pad;
            y: root.footer_y;
            width: root.cw - root.pad * 2;
            height: 14px;
            text: root.footer();
            color: AppTheme.text-faint;
            font-size: 10.5px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    hit := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.item.title;
        clicked => { root.open(root.item.bvid); }
    }
}

// The feed toolbar's 最值得看 / 最新 / 评分 segmented control: one flat track,
// the active pill filled with the accent. 30px tall, three equal 64px pills.
component FishSeg inherits Rectangle {
    in property <[string]> labels;
    in property <int> index: 0;
    callback pick(int);

    width: 3px + root.labels.length * 64px + (root.labels.length - 1) * 2px + 3px;
    height: 30px;
    background: #00000000;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 15px;
        background: AppTheme.card;

        HorizontalLayout {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: 24px;
            spacing: 2px;

            for label[i] in root.labels : Rectangle {
                width: 64px;
                height: 24px;
                border-radius: 12px;
                background: root.index == i
                    ? AppTheme.accent
                    : (hit.has-hover ? AppTheme.pill-hover : #00000000);
                animate background { duration: 120ms; easing: ease-out; }

                Text {
                    width: 100%;
                    height: 100%;
                    text: label;
                    color: root.index == i ? AppTheme.accent-fg : AppTheme.text-soft;
                    font-size: 11.5px;
                    font-weight: root.index == i ? 600 : 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
                hit := TouchArea {
                    accessible-role: button;
                    accessible-label: label;
                    clicked => { root.pick(i); }
                }
            }
        }
    }
}

// 36x20 switch. The knob slides 120ms; the track is the only coloured part.
component FishSwitch inherits Rectangle {
    in property <bool> on: false;
    callback toggled();

    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? AppTheme.accent : AppTheme.pill-bg;
    animate background { duration: 120ms; easing: ease-out; }

    Rectangle {
        x: root.on ? 18px : 2px;
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.on ? AppTheme.accent-fg : AppTheme.text-faint;
        animate x { duration: 120ms; easing: ease-out; }
        animate background { duration: 120ms; easing: ease-out; }
    }
    hit := TouchArea {
        mouse-cursor: pointer;
        accessible-role: switch;
        accessible-checked: root.on;
        clicked => { root.toggled(); }
    }
}

// A 48px configuration row's label block. Controls are placed by the caller at
// absolute x, so every row shares one baseline and one 48px height.
component FishRowLabel inherits Rectangle {
    in property <string> label: "";
    in property <string> sub: "";

    height: 48px;
    background: #00000000;

    Text {
        x: 0;
        y: root.sub == "" ? 15px : 8px;
        width: 100%;
        height: 16px;
        text: root.label;
        color: AppTheme.text;
        font-size: 12.5px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.sub != "" : Text {
        x: 0;
        y: 26px;
        width: 100%;
        height: 14px;
        text: root.sub;
        color: AppTheme.text-faint;
        font-size: 10px;
        vertical-alignment: center;
        overflow: elide;
    }
}


// Row-virtualised grid for the shared [CardRow] lists (分区 排行
// and the UP page). The contract and the card geometry are the old paged grid's
// - one page of `list_page_size` cards starting at the absolute index
// `page-offset`, `cols` columns, 12px gutters - but the grid is now a ListView
// of ROWS: a row is one `cols`-wide line of cards, so only the rows around the
// viewport are instantiated and recycled as the wheel moves. The model is still
// the Rust-owned page window, so appending only extends it: the ListView keeps
// its `content-y` and the list never jumps to the top.
component CardGrid inherits Rectangle {
    in property <[CardRow]> items;
    callback activate(int);
    // Card pointer semantics (see VideoCardView): 0 left / 1 right /
    // 2 ctrl+left, with the card's absolute index.
    callback card_open(int, int);
    // Queue mark on each section card (see VideoCardView).
    callback queue(int);
    callback queue_only(int);

    in property <int> cols: 2;
    in property <int> page-offset: 0;
    in property <int> page-size: 24;
    in property <length> available-width: 400px;
    property <length> gap: 12px;
    property <length> card-w: max(120px, (available-width - gap * (cols - 1)) / cols);
    property <length> card-h: card-w * 0.5625 + 60px;
    // Cards in the page window and the rows they occupy (see FeedGrid).
    property <int> shown-count: max(0, min(page-size, items.length - page-offset));
    property <int> row-count: (shown-count + cols - 1) / cols;
    // QA: the list's vertical offset, so the strip-wheel replay can prove the
    // page below did not move.
    out property <length> scroll-y: vlist.content-y;

    background: #00000000;

    vlist := ListView {
        width: 100%;
        height: 100%;
        // Wheel only: no scrollbar, and the drag is reserved for the window.
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        mouse-drag-pan-enabled: false;

        for r in row-count : Rectangle {
            width: 100%;
            // Every row owns its 12px tail; the last one also reserves the
            // page bar's 84px clearance so the final row scrolls clear of it.
            height: root.card-h + root.gap + (r == row-count - 1 ? AppTheme.bar-clearance : 0px);
            background: #00000000;

            for c in cols : Rectangle {
                x: c * (root.card-w + root.gap);
                y: 0;
                width: root.card-w;
                height: root.card-h;
                background: #00000000;
                property <int> idx: root.page-offset + r * cols + c;

                if idx < items.length && (idx - root.page-offset) < root.page-size : VideoCardView {
                    width: parent.width;
                    height: parent.height;
                    card-width: root.card-w;
                    thumb: items[idx].thumb;
                    title: items[idx].title;
                    meta: items[idx].meta;
                    badge: items[idx].badge;
                    activate => { root.activate(idx); }
                    card_press(mode) => { root.card_open(idx, mode); }
                    queue => { root.queue(idx); }
                    queue-only => { root.queue_only(idx); }
                }
            }
        }
    }
}

// Row-virtualised home feed.
//
// The old build repeated every card of the page inside one Flickable, so all
// of them were created, laid out and painted on every frame even when far
// off-screen. This is a ListView of ROWS instead: a row is the current number
// of columns (one HorizontalLayout's worth, positioned by arithmetic), and the
// ListView only instantiates the rows around the viewport, recycling them as
// the wheel moves. The visual result is unchanged: same card width/height,
// same 12px gap, same centred block, same 72px scroll clearance under the
// floating page bar.
//
// The data contract did not change: `items` is still the Rust-owned feed model
// and `page-offset` / `page-size` are still the client page window. The row
// count is derived from that window, so appending items only extends the
// model; the ListView keeps its `content-y`, and nothing jumps to the top.
component FeedGrid inherits ListView {
    in property <[FeedRow]> items;
    // False while the list is scrolling: cards paint the flat tint instead of
    // the per-card backdrop slice and run no per-card animation (see
    // FeedScroller).
    in property <bool> quiet: false;
    // Refresh settle clock, forwarded to every card (see VideoCardView).
    in property <bool> refresh_run: false;
    in property <int> refresh_ms: 0;
    callback activate(int);
    // Card pointer semantics (see VideoCardView): 0 left / 1 right /
    // 2 ctrl+left, with the card's absolute index.
    callback card_open(int, int);
    callback play(int);
    callback owner(int);
    // Queue mark on each home-feed card (see VideoCardView).
    callback queue(int);
    callback queue_only(int);
    // QA: which feed index should publish its queue-mark rect.
    in property <int> qa_probe_card: -1;
    callback card_probe(length, length, length, length);
    // A REAL user scroll (wheel / drag / kinetic), forwarded from the
    // Flickable's `flicked`; our own `content-y` writes never raise it.
    callback user_scrolled();

    // The inherited ScrollView callback is aliased to the Flickable's
    // `flicked`; handling it here is what lets the refresh pin yield to input.
    scrolled => { root.user_scrolled(); }

    in property <int> cols: 2;
    in property <int> page-offset: 0;
    in property <int> page-size: 24;
    in property <length> available-width: 400px;
    // Window clock for the freshness chips (0 = hide them).
    in property <int> now_ts: 0;
    // The scroll reset lives in FeedScroller (the wrapper): a ListView may only
    // have one `for` child, so neither a reset handler nor a Timer can live
    // here. This component only reports a real user scroll upward.
    property <length> gap: 12px;
    property <length> card-w: max(120px, (available-width - gap * (cols - 1)) / cols);
    property <length> card-h: card-w * 0.5625 + 60px;
    // Cards in the current page window and the rows they occupy.
    property <int> shown-count: max(0, min(page-size, items.length - page-offset));
    property <int> row-count: (shown-count + cols - 1) / cols;
    property <length> row-w: card-w * cols + gap * (cols - 1);
    // No scrollbar (wheel only; mouse drag is reserved for the window move),
    // see the feed comment in AppWindow.
    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
    mouse-drag-pan-enabled: false;

    for r in row-count : Rectangle {
        width: 100%;
        // Every row carries its own 12px tail; the last one also reserves the
        // bar-clearance px the floating page bar needs to sit over the list.
        height: card-h + gap + (r == row-count - 1 ? AppTheme.bar-clearance : 0px);
        background: #00000000;

        for c in cols : Rectangle {
            x: (parent.width - root.row-w) / 2 + c * (root.card-w + root.gap);
            y: 0;
            width: root.card-w;
            height: root.card-h;
            background: #00000000;
            property <int> idx: root.page-offset + r * root.cols + c;

            if idx < items.length && (idx - root.page-offset) < root.page-size : VideoCardView {
                width: parent.width;
                height: parent.height;
                card-width: root.card-w;
                quiet: root.quiet;
                refresh_run: root.refresh_run;
                refresh_ms: root.refresh_ms;
                refresh_slot: idx - root.page-offset;
                show-owner: true;
                thumb: root.items[idx].thumb;
                title: root.items[idx].title;
                owner: root.items[idx].owner;
                meta: root.items[idx].meta;
                badge: root.items[idx].badge;
                view-count: root.items[idx].view_count;
                pub-ts: root.items[idx].pub_ts;
                now-ts: root.now_ts;
                activate => { root.activate(idx); }
                card_press(mode) => { root.card_open(idx, mode); }
                play => { root.play(idx); }
                owner-activate => { root.owner(idx); }
                queue => { root.queue(idx); }
                queue-only => { root.queue_only(idx); }
                queued: root.items[idx].queued;
                probe: idx == root.qa_probe_card;
                probe_rect(x, y, w, h) => { root.card_probe(x, y, w, h); }
            }
        }
    }
}

// FeedGrid inside a thin shell. A ListView may only have a single `for` as
// children, so the refresh scroll-to-top cannot live inside it: this wrapper
// owns the reset, the scroll gate and the refresh settle. Everything else is a
// straight forward.
//
// The reset has to survive Slint's own layout pass: the ListView's virtualised
// layout re-anchors `content-y` to the row it last laid out whenever the model
// or its geometry changes, and that pass runs AFTER a `changed` handler. A
// single write of 0 - or a fixed countdown started before the model lands - can
// therefore be overwritten and the list settles a few rows down. See the reset
// block below for the order that cannot be undone.
component FeedScroller inherits Rectangle {
    in property <[FeedRow]> items;
    in property <int> cols: 2;
    in property <int> page-offset: 0;
    in property <int> page-size: 24;
    in property <length> available-width: 400px;
    // Window clock for the freshness chips (0 = hide them).
    in property <int> now_ts: 0;
    // Bumped on every refresh start (see AppWindow's `feed_scroll_reset`).
    in property <int> scroll_reset: 0;
    // Refresh feedback clock, owned by AppWindow (one timer for the window).
    in property <bool> refresh_run: false;
    in property <int> refresh_ms: 0;

    callback activate(int);
    callback card_open(int, int);
    callback play(int);
    callback owner(int);
    callback queue(int);
    callback queue_only(int);
    in property <int> qa_probe_card: -1;
    callback card_probe(length, length, length, length);
    // QA: the hover gate (a scrolling/refreshing list suppresses card hover,
    // including the queue mark's plus state).
    out property <bool> quiet_now: root.scroll_busy || root.refresh_run;

    background: #00000000;

    feed_grid := FeedGrid {
        width: 100%;
        height: 100%;
        quiet: root.scroll_busy || root.refresh_run;
        refresh_run: root.refresh_run;
        refresh_ms: root.refresh_ms;
        items: root.items;
        cols: root.cols;
        available-width: root.available-width;
        page-offset: root.page-offset;
        page-size: root.page-size;
        now_ts: root.now_ts;
        activate(idx) => { root.activate(idx); }
        card_open(idx, mode) => { root.card_open(idx, mode); }
        play(idx) => { root.play(idx); }
        owner(idx) => { root.owner(idx); }
        queue(idx) => { root.queue(idx); }
        queue_only(idx) => { root.queue_only(idx); }
        qa_probe_card: root.qa_probe_card;
        card_probe(x, y, w, h) => { root.card_probe(x, y, w, h); }
        // A real wheel/drag is the user taking the scroll back: drop the pin
        // and the pending next-frame write immediately (see `stop-pin`).
        user_scrolled => { root.stop-pin(); }
    }

    // ---- scroll gate: flat tint while the feed moves (120 fps home) ----
    // While `content-y` changes the rows paint only their flat tint (hover and
    // the skeleton sweep pause) and the 3-tick (120ms) countdown restores the
    // hover treatment after the scroll stops.
    //
    // `changed` only takes a plain identifier, so the list offset is aliased
    // into this component's scope first. The timer runs only during a scroll
    // (plus the 120ms tail): an idle feed has no timer and no animation, and
    // nothing here is per card.
    property <length> scroll_y <=> feed_grid.content-y;
    property <bool> scroll_busy: false;
    property <int> scroll_ticks: 0;

    changed scroll_y => {
        root.scroll_busy = true;
        root.scroll_ticks = 3;
    }

    Timer {
        interval: 40ms;
        running: root.scroll_busy;
        triggered => {
            root.scroll_ticks -= 1;
            if (root.scroll_ticks <= 0) {
                root.scroll_busy = false;
            }
        }
    }

    // ---- refresh reset: the FIRST row, exactly ----
    // The ListView does not treat `content-y` as a plain offset: its virtualised
    // layout pass RE-ANCHORS the list to the row it had at `state.offset` every
    // time the model or geometry changes (i-slint-core's
    // `update_visible_instances`, which ends by writing its own `content-y`).
    // That pass runs AFTER a `changed` handler, so a single write of 0 is
    // overwritten in the same event, and a fixed countdown can expire before a
    // slow republish re-anchors the list.
    //
    // The reset therefore runs in an order that cannot be undone:
    //   1. every reset source writes 0 IMMEDIATELY (refresh counter, the model
    //      being replaced, the model length changing);
    //   2. a 0/16ms one-shot writes 0 again on the NEXT frame, i.e. after the
    //      re-anchor pass that the first write triggered;
    //   3. the 16ms watchdog KICKS the offset (-1px for one frame, 0 on the
    //      next, twice): a ListView pass can end with the rows laid out from a
    //      deeper anchor while `content-y` already reads 0, and a write of 0
    //      onto 0 is no property change at all, so nothing would ever re-run
    //      the pass and the wrong rows would stay on screen. The 1px delta is a
    //      real change (the rows never move more than a pixel for one frame),
    //      so the pass runs again and ends at exactly 0;
    //   4. after the kicks the watchdog keeps the top for as long as the list
    //      drifts: it re-writes 0 whenever `content-y` is not at the top and
    //      only stops after 60 consecutive ticks at exactly 0 (~960ms of
    //      stability, the hold the old blind pin used), with a 180-tick (~2.9s)
    //      ceiling. Every reset source restarts it, so a model that lands late
    //      is held too.
    // A real user scroll cancels it instantly: `scrolled` (the Flickable's
    // `flicked`) only fires for wheel/drag/animation, never for our own writes,
    // so scrolling right after a refresh is never fought. Our own writes never
    // raise it, so the pin cannot cancel itself.
    property <bool> pinning: false;
    // Consecutive watchdog ticks that found the list already at the top.
    property <int> pin_settle: 0;
    // 1px kick frames left (see step 3).
    property <int> pin_kicks: 0;
    // Hard ceiling, so a pathological re-anchor loop cannot hold the top for
    // ever. Every reset source (including a late model) arms a fresh one.
    property <int> pin_budget: 0;
    property <bool> top_again: false;
    // `changed` needs a plain identifier: watch the model length through an
    // alias, exactly like `scroll_y` above.
    property <int> item_count: root.items.length;

    function pin-top() {
        feed_grid.content-y = 0px;
    }

    function reset-top() {
        root.pin-top();
        root.top_again = true;
        root.pin_settle = 0;
        root.pin_kicks = 2;
        root.pin_budget = 180;
        root.pinning = true;
    }

    function stop-pin() {
        root.pinning = false;
        root.top_again = false;
        root.pin_settle = 0;
        root.pin_kicks = 0;
        root.pin_budget = 0;
    }

    // The refresh button / list_refreshing edge.
    changed scroll_reset => { root.reset-top(); }
    // The model being REPLACED is the event that makes the ListView re-anchor,
    // even when the new page has exactly the same number of rows - which is the
    // normal refresh case, and the one a length watch alone cannot see.
    changed items => { root.reset-top(); }
    // A length change inside the same model object (append / trim) re-anchors
    // too.
    changed item_count => { root.reset-top(); }

    // (2) next-frame correction for the re-anchor pass the instant write caused.
    // It yields to a real scroll exactly like the watchdog does.
    Timer {
        interval: 16ms;
        running: root.top_again;
        triggered => {
            root.top_again = false;
            root.pin-top();
        }
    }

    // (3) the kick + (4) the pin. A drift means Slint moved the list after our
    // write (a re-anchor, or a late content-height change): take the top back
    // and start the stability count again. At the top, the two kick frames
    // force a fresh ListView pass (see step 3 above), then the list has to stay
    // at 0 for 60 ticks (~960ms); no write is issued while it is already there.
    Timer {
        interval: 16ms;
        running: root.pinning;
        triggered => {
            if (root.scroll_y < 0px) {
                root.pin-top();
                root.pin_settle = 0;
            } else if (root.pin_kicks > 0) {
                root.pin_kicks -= 1;
                feed_grid.content-y = -1px;
                root.pin_settle = 0;
            } else {
                root.pin_settle += 1;
                if (root.pin_settle >= 60) {
                    root.pinning = false;
                }
            }
            root.pin_budget -= 1;
            if (root.pin_budget <= 0) {
                root.pin-top();
                root.pinning = false;
            }
        }
    }

    // ---- refresh feedback: 2px accent band, left -> right, once ----
    // Clock from AppWindow (`refresh_ms`), 320ms travel, fading over the last
    // 18%. Pointer-transparent: no TouchArea, so input is never blocked.
    property <float> sweep_p: clamp(root.refresh_ms * 1.0 / 320.0, 0, 1);
    property <float> sweep_fade: root.sweep_p < 0.82
        ? 1.0
        : clamp((1.0 - root.sweep_p) / 0.18, 0, 1);

    Rectangle {
        x: -self.width + (root.width + self.width) * root.sweep_p;
        y: 0;
        width: max(24px, root.width * 0.3);
        height: 2px;
        border-radius: 1px;
        background: AppTheme.accent;
        opacity: root.refresh_run ? 0.9 * root.sweep_fade : 0;
    }
}

// Row-virtualised search results (see CardGrid / FeedGrid for the pattern).
component SearchGrid inherits Rectangle {
    in property <[SearchRow]> items;
    in property <bool> people: false;
    callback activate(int);
    // Card pointer semantics (see VideoCardView): 0 left / 1 right /
    // 2 ctrl+left, with the card's absolute index.
    callback card_open(int, int);
    // Declared even where the mark is hidden (`show-queue: false`), so the
    // grid keeps one shape and a later wiring change only flips the flag.
    callback queue(int);
    callback queue_only(int);

    in property <int> cols: 2;
    in property <int> page-offset: 0;
    in property <int> page-size: 24;
    in property <length> available-width: 400px;
    property <length> gap: 12px;
    property <length> card-w: max(120px, (available-width - gap * (cols - 1)) / cols);
    property <length> card-h: card-w * 0.5625 + 60px;
    property <int> shown-count: max(0, min(page-size, items.length - page-offset));
    property <int> row-count: (shown-count + cols - 1) / cols;

    // QA: the list's vertical offset (see CardGrid).
    out property <length> scroll-y: vlist.content-y;

    background: #00000000;

    vlist := ListView {
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        mouse-drag-pan-enabled: false;

        for r in row-count : Rectangle {
            width: 100%;
            height: root.card-h + root.gap + (r == row-count - 1 ? AppTheme.bar-clearance : 0px);
            background: #00000000;

            for c in cols : Rectangle {
                x: c * (root.card-w + root.gap);
                y: 0;
                width: root.card-w;
                height: root.card-h;
                background: #00000000;
                property <int> idx: root.page-offset + r * cols + c;

                if idx < items.length && (idx - root.page-offset) < root.page-size : VideoCardView {
                    width: parent.width;
                    height: parent.height;
                    card-width: root.card-w;
                    show-queue: false;
                    people: root.people;
                    thumb: items[idx].thumb;
                    title: items[idx].title;
                    meta: items[idx].meta;
                    badge: items[idx].badge;
                    activate => { root.activate(idx); }
                    card_press(mode) => { root.card_open(idx, mode); }
                }
            }
        }
    }
}

