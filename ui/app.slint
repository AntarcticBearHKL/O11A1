// Bilibili QR login UI.
// Driver properties are written from Rust via `slint::invoke_from_event_loop`.

import { ScrollView, LineEdit, ListView } from "std-widgets.slint";

// Bundled UI font, SIL Open Font License 1.1 (safe to embed and redistribute).
// Slint embeds these at compile time and registers them, so the app does not
// depend on the font being installed system-wide.
//
// The interface face is the OFL `Chill Round Gothic` pair shipped in
// `assets/fonts/` (Regular + Bold), embedded here at compile time so Slint
// registers the family itself; every Window below names that family in
// `default-font-family` and nothing sets a family per Text. The Noto Sans SC
// imports stay as the bundled fallback faces for glyphs the round face does
// not cover.
import "../assets/fonts/ChillRoundGothic_Regular.otf";
import "../assets/fonts/ChillRoundGothic_Bold.otf";
import "fonts/NotoSansSC-Regular.otf";
import "fonts/NotoSansSC-Bold.otf";

// ---------------------------------------------------------------------------
// Frameless resize rim (main / player / mini windows).
//
// Every window answers WM_NCHITTEST with HTCLIENT for its whole area
// (win::border_hit_test), because the OS modal resize loop owns the thread's
// message pump: the video pacer and every Slint timer freeze from press to
// release. These are the app-owned replacement: 8px hot zones on the four
// edges, 14px squares on the corners and an 18px bottom-right grip.
//
// A zone is only as deep as the rim, and ResizeFrame is declared AFTER the
// content in each window, so it wins exactly in the outer 8px and every card,
// pill and button keeps its press from 8px in. Pressing a zone calls the
// window's `resize_start(edge)`, moving calls `resize_move()` and the release
// calls `resize_end()`; Rust places the window on its 8ms frame timer.
//
// Edge codes are shared with `win::WindowResize`:
// 1 left, 2 right, 3 top, 4 bottom, 5 top-left, 6 top-right, 7 bottom-left,
// 8 bottom-right.
// ---------------------------------------------------------------------------
component ResizeZone inherits TouchArea {
    in property <int> edge: 0;
    // Slint 1.18 supports the CSS resize cursors (ColResize/RowResize and the
    // eight directional ones); the window manager may show its own shape while
    // a press is captured, which is why this is only a hover affordance.
    in property <MouseCursor> cursor-shape: MouseCursor.default;

    callback start(int);
    callback zone-moved();
    callback zone-done();

    mouse-cursor: root.cursor-shape;

    pointer-event(event) => {
        if (event.kind == PointerEventKind.down) {
            if (event.button != PointerEventButton.left) {
                return EventResult.reject;
            }
            root.start(root.edge);
            EventResult.accept
        } else if (event.kind == PointerEventKind.move) {
            root.zone-moved();
            EventResult.accept
        } else {
            root.zone-done();
            EventResult.accept
        }
    }
}

component ResizeFrame inherits Rectangle {
    callback resize-start(int);
    callback resize-move();
    callback resize-end();

    x: 0;
    y: 0;
    width: 100%;
    height: 100%;
    background: #00000000;

    // ---- edges (between the 14px corners) ----
    ResizeZone {
        x: 0;
        y: 14px;
        width: 8px;
        height: max(0px, parent.height - 28px);
        edge: 1;
        cursor-shape: MouseCursor.ew-resize;
        start(edge) => { root.resize-start(edge); }
        zone-moved => { root.resize-move(); }
        zone-done => { root.resize-end(); }
    }
    ResizeZone {
        x: parent.width - 8px;
        y: 14px;
        width: 8px;
        height: max(0px, parent.height - 28px);
        edge: 2;
        cursor-shape: MouseCursor.ew-resize;
        start(edge) => { root.resize-start(edge); }
        zone-moved => { root.resize-move(); }
        zone-done => { root.resize-end(); }
    }
    ResizeZone {
        x: 14px;
        y: 0;
        width: max(0px, parent.width - 28px);
        height: 8px;
        edge: 3;
        cursor-shape: MouseCursor.ns-resize;
        start(edge) => { root.resize-start(edge); }
        zone-moved => { root.resize-move(); }
        zone-done => { root.resize-end(); }
    }
    ResizeZone {
        x: 14px;
        y: parent.height - 8px;
        width: max(0px, parent.width - 28px);
        height: 8px;
        edge: 4;
        cursor-shape: MouseCursor.ns-resize;
        start(edge) => { root.resize-start(edge); }
        zone-moved => { root.resize-move(); }
        zone-done => { root.resize-end(); }
    }

    // ---- corners (14px) ----
    ResizeZone {
        x: 0;
        y: 0;
        width: 14px;
        height: 14px;
        edge: 5;
        cursor-shape: MouseCursor.nwse-resize;
        start(edge) => { root.resize-start(edge); }
        zone-moved => { root.resize-move(); }
        zone-done => { root.resize-end(); }
    }
    ResizeZone {
        x: parent.width - 14px;
        y: 0;
        width: 14px;
        height: 14px;
        edge: 6;
        cursor-shape: MouseCursor.nesw-resize;
        start(edge) => { root.resize-start(edge); }
        zone-moved => { root.resize-move(); }
        zone-done => { root.resize-end(); }
    }
    ResizeZone {
        x: 0;
        y: parent.height - 14px;
        width: 14px;
        height: 14px;
        edge: 7;
        cursor-shape: MouseCursor.nesw-resize;
        start(edge) => { root.resize-start(edge); }
        zone-moved => { root.resize-move(); }
        zone-done => { root.resize-end(); }
    }
    // The designed grip is 18px; declared last so it wins over the right and
    // bottom edge strips inside its square.
    ResizeZone {
        x: parent.width - 18px;
        y: parent.height - 18px;
        width: 18px;
        height: 18px;
        edge: 8;
        cursor-shape: MouseCursor.nwse-resize;
        start(edge) => { root.resize-start(edge); }
        zone-moved => { root.resize-move(); }
        zone-done => { root.resize-end(); }
    }
}
 
// ---------------------------------------------------------------------------
// AppTheme: the app's own theme. The UI is byte-identical to the original
// when `dark` is false; `dark` is written from Rust (the Windows light/dark
// setting, or the 主题 setting in the app).
// ---------------------------------------------------------------------------
export global AppTheme {
    in-out property <bool> dark: false;

    // ---- frosted surfaces (persisted by main.rs, edited in the 设置 panel) ----
    // 0 = matte, 100 = maximally see-through. Drives the window tint's alpha.
    in-out property <float> glass-transparency: 45;

    // ---- virtual wallpaper -------------------------------------------------
    // One seamless 1024x1024 tile (`src/backdrop.rs`) is painted 5x4 times under
    // the client area, anchored to the window's SCREEN position: `wall-x` /
    // `wall-y` are `-(screen position mod tile)`, in logical px. Two
    // consequences, both by design:
    //   * moving the window reveals a different part of one virtual wallpaper
    //     (parallax), instead of the image following the window;
    //   * a move by exactly `wallpaper-tile` reproduces the same pixels, because
    //     the tile is seamless in both directions.
    // A strict 2x2 grid covers only a client area of one tile; 5x4 covers a
    // 4096x3072 logical client (4K at 100 % DPI) at every offset. Rust publishes
    // the tile edge once (`backdrop::tile_px`) and the origin on every move.
    in-out property <length> wall-x: 0px;
    in-out property <length> wall-y: 0px;
    in-out property <length> wallpaper-tile: 1024px;
    // 背景模糊 slider (image px, 0..=160); the wallpaper's own diffusion.
    in-out property <int> backdrop-blur: 60;
    // The tile's base tone: fills any sliver the tiling does not reach (a window
    // wider than the 5x4 grid) so it reads as more wallpaper, never as desktop.
    out property <color> wall-base: dark ? #07070b : #fafafc;

    // Surfaces. `card` / `card-hover` are slightly translucent (81% / 85%
    // alpha): the window glass underneath stays faintly visible through every
    // video card, the way the top bar and page pill read. The tint is opaque
    // enough that text and covers keep their contrast.
    out property <color> bg: dark ? #121212 : #f5f5f7;
    out property <color> card: dark ? #1e1e1ecf : #ffffffd9;
    out property <color> card-alt: dark ? #242424 : #f6f7f9;
    out property <color> card-hover: dark ? #2a2a2acf : #e7e7ecd9;
    out property <color> thumb: dark ? #2a2a2a : #e0e0e3;
    out property <color> divider: dark ? #2c2c2c : #e0e0e3;
    out property <color> divider-alt: dark ? #2c2c2c : #d8d8dc;
    out property <color> track: dark ? #3a3a3a : #d0d0d5;

    // The window surface is translucent: the generated diffuse backdrop that
    // Rust (`backdrop.rs`) pushes into the root window shows through it. The
    // root window paints this tint exactly ONCE - every full-width container
    // above it stays transparent (the layering rule from the working reference
    // implementation, asset-library-desktop/ui/theme.slint). The alpha is the
    // 背景透明度 slider's complement: the default 45 leaves 0.55 alpha over the
    // backdrop, which is the exact alpha (0x8C) this window shipped with before
    // the slider existed.
    out property <color> window-bg: (dark ? #121212 : #f5f5f7).transparentize(glass-transparency / 100);
    // Windows close-button red (used only as the close button's hover fill).
    out property <color> win-close: #e81123;

    // Floating top-bar glass. The bar is a small panel (a card), not a window
    // layer, so it is allowed its own fill: dark uses the #1e1e1e surface
    // family at 72% - a clear step above the 55% window glass - with a 1px
    // #ffffff14-family hairline that gives the edge definition a translucent
    // fill alone cannot. Light mirrors it (white fill, dark hairline).
    // The bar is a SURFACE, not a film: >= 92 % alpha so card art and
    // titles can never read through it.
    out property <color> bar-fill: dark ? #1e1e1ef7 : #fffffff7;
    out property <color> bar-border: dark ? #ffffff14 : #00000014;
    // Hover wash for the bar's own controls (hairline button, win buttons).
    out property <color> bar-hover: dark ? #ffffff14 : #00000010;
    // The search field's wash: one step ABOVE the bar card (a light film in
    // dark mode, a dark film in light mode) so the field reads as a designed
    // inset on the glass instead of a foreign widget surface. Its 1px edge is
    // the same `bar-border` hairline as the card; focus lifts it to the accent.
    out property <color> bar-field: dark ? #ffffff0f : #0000000a;
    // The nav strip's bottom rule: 1px, inside the content gutters, not a
    // surface - it is what makes the grouped tabs read as one designed strip.
    out property <color> nav-track: dark ? #ffffff17 : #00000017;

    // Progressive cover loading: written from Rust. While a list is still
    // streaming its covers `skeletons-on` is true and `skeleton-phase` sweeps
    // 0..1 to drive the placeholder highlight; both stop when nothing is
    // pending, so an idle window repaints nothing.
    in-out property <bool> skeletons_on: false;
    in-out property <float> skeleton_phase: 0.0;
    out property <color> shimmer: dark ? #ffffff10 : #ffffffa8;

    // Text
    out property <color> text: dark ? #e8e8e8 : #1a1a1a;
    out property <color> text-dim: dark ? #9a9a9a : #5f5f66;
    out property <color> text-faint: dark ? #808080 : #6b6b72;
    out property <color> text-soft: dark ? #a8a8a8 : #555555;
    out property <color> text-body: dark ? #c8c8c8 : #333333;

    // Accent
    out property <color> accent: dark ? #3ea6ff : #005FB8;
    out property <color> accent-hover: dark ? #63b3ff : #0a6fd0;
    out property <color> accent-fg: dark ? #0b0b0b : #ffffff;
    out property <color> accent-soft: dark ? #16324d : #e8f1fc;

    // 大会员 badge (theme-invariant 会员 pink)
    out property <color> vip-badge-bg: #fb7299;
    out property <color> vip-badge-fg: #ffffff;
    out property <color> vip-text: dark ? #ff9dbb : #d64f7c;

    // Controls
    out property <color> pill-bg: dark ? #2c2c2c : #e0e0e3;
    out property <color> pill-hover: dark ? #3a3a3a : #d2d2d7;
    out property <color> pill-fg: dark ? #e8e8e8 : #1a1a1a;
    out property <color> pill-off-bg: dark ? #2a2a2a : #d8d8dc;
    out property <color> pill-off-fg: dark ? #7a7a7a : #6b6b72;
    out property <color> border: dark ? #3a3a3a : #d0d0d3;
    out property <color> border-popup: dark ? #3a3a3a : #cfd3da;
    out property <color> btn-hover: dark ? #3a3a3a : #d0d0d3;
    out property <color> row-hover: dark ? #26303c : #e9eff7;
    out property <color> suggest-hover: dark ? #222c36 : #eef2f8;

    // 热搜 chips
    out property <color> hot-bg: dark ? #3a2c1a : #fdeedd;
    out property <color> hot-hover: dark ? #4a3a22 : #fbd9b8;
    out property <color> hot-fg: dark ? #e8a45c : #b0651a;

    // ---- card meta: play-count rarity + publish freshness ----
    // The play count is a rank mark, not a number: six 8px dots, grey -> blue ->
    // teal -> purple -> orange -> gold as `view_count` crosses 1k / 1万 / 10万 /
    // 100万 / 1000万. Theme-aware so the dot keeps its contrast on both card
    // tints; the exact count lives in the dot's hover tooltip.
    out property <[color]> rarity-ramp: dark ? [
        #8a8a90, #5da8ff, #2fc4b2, #b08cff, #ff9f43, #f5c542
    ] : [
        #9a9aa0, #2f6fd0, #0e9488, #7c4dcc, #d97706, #b8860b
    ];

    // Freshness ramp, index 0 = <1h ... index 8 = >1y. Vivid green at "today",
    // stepping through sage/olive into neutral grey; the last four steps are
    // compressed so a year-old card reads quiet without a hue jump. The chip
    // paints this colour as its text over the same colour at 16% alpha, so one
    // ramp drives both layers. The light variant is darker because the chip's
    // pale tint sits on a white card, the dark one keeps the #3ED598-class mint.
    out property <[color]> fresh-ramp: dark ? [
        #3ED598, #4FC98E, #64BB84, #79AB7B, #8A9A78,
        #939086, #94918E, #9A9896, #A4A2A0
    ] : [
        #0C7A55, #147550, #226C52, #336252, #445C50,
        #535B53, #5F5F5C, #6C6C69, #7E7D7A
    ];

    // Danger
    out property <color> danger: dark ? #ff6b6b : #b02020;
    out property <color> danger-bg: dark ? #3a2020 : #f5d9d9;
    out property <color> danger-hover: dark ? #4a2a2a : #efb6b6;
    out property <color> danger-border: dark ? #5a3232 : #e6b0b0;

    // Scrim behind popups
    out property <color> overlay: dark ? #00000088 : #00000055;

    // Player / mini-window chrome. A video player stays dark in both schemes;
    // these values are theme-invariant so 浅色 is pixel-identical to the
    // original build.
    out property <color> player-bg: #101014;
    // The player window's own tint, the same model as the main window's
    // `window-bg`: a translucent fill over the compositor's transparent window,
    // with the generated backdrop (Rust pushes it into `backdrop`)
    // underneath. ~65% alpha, so the gradient stays faintly visible through the
    // chrome bands. The video band paints an opaque black over it and is
    // unaffected; the mini window's letterbox keeps the same tint.
    out property <color> player-glass: #101014a6;
    // The two chrome bands are translucent too (80%): they sit on the glass
    // tint, not on an opaque surface, so the backdrop reads through the
    // 36px title bar and the 48px control bar. The 二级 panels are one step
    // denser (90%) because they carry text over a moving picture.
    out property <color> player-bar: #1b1b22cc;
    out property <color> player-btn: #2a2a33;
    out property <color> player-btn-hover: #3a3a44;
    out property <color> player-menu: #26262ee6;
    out property <color> player-menu-hover: #34343e;
    out property <color> player-menu-border: #3a3a44cc;
    out property <color> player-track: #3a3a44;
    // Scrubber progress fill: a calm green, distinct from the accent blue so
    // "played" reads at a glance without turning the strip into a warning. The
    // player chrome is dark in both schemes, so this token is theme-invariant.
    out property <color> player-progress: #35a06b;
    out property <color> player-text: #e0e0e6;
    out property <color> player-text-bright: #f0f0f2;
    out property <color> player-time: #e6e6ea;
    out property <color> player-text-soft: #cdcdd4;
    out property <color> player-text-dim: #9a9aa2;
    out property <color> player-text-status: #d0d0d6;
    out property <color> player-danger-soft: #d0a0a0;
    out property <color> player-danger-text: #f0b0b0;
    out property <color> player-danger-bg: #3a2a2a;
    out property <color> player-danger-bg-hover: #5a2f2f;
    out property <color> player-muted-bg: #7a3a3a;
    out property <color> player-muted-fill: #6a6a72;
    out property <color> player-on: #2f6f3f;
    out property <color> player-gold: #b0651a;
    out property <color> player-fg-strong: #ffffff;
    out property <color> player-knob: #ffffff;
    // Drop shadow under the floating chrome (pill, popovers, toasts). One token,
    // so every floating surface casts the same shadow instead of each element
    // inventing an alpha.
    out property <color> player-shadow: #00000073;
    // Selected row inside the player's 二级 panel. Also theme-invariant: the
    // panel keeps the dark `player-menu` surface in both schemes, so the light
    // theme's `accent-soft` (#e8f1fc) would wash the row out to near-white.
    out property <color> player-selected: #2f4a68;

    // On-video treatments (overlay buttons, status text, danmaku shadow).
    out property <color> video-bg: #000000;
    out property <color> video-overlay-bg: #00000099;
    out property <color> video-overlay-hover: #3a3a44ee;
    out property <color> video-overlay-fg: #ffffff;
    out property <color> video-status-shadow: #000000;
    out property <color> video-status-fg: #f0f0f2;
    out property <color> video-warn: #ffd0d0;
    out property <color> danmaku-shadow: #000000;

    // Scroll clearance for every list that scrolls under the floating home
    // bar: bar height (56px pill) + 28px (the 20px bottom inset + an 8px
    // breathing gap) = 84px. Applied as a trailing inset on the scroll
    // content (last-row tail or padding-bottom), never as a mask, so the last
    // card can be scrolled fully clear of the bar and its title/meta read.
    out property <length> bar-clearance: 84px;

    // Responsive card-grid column counts. The video grid targets 2 columns at    // the 480px minimum window (440px content) and 5 columns at 1400px+, with
    // a hard floor of one column for very narrow embeds.
    public pure function grid_columns(width: length) -> int {
        if (width >= 1260px) { return 5; }
        if (width >= 980px) { return 4; }
        if (width >= 720px) { return 3; }
        if (width >= 400px) { return 2; }
        return 1;
    }

    // Notification / private-message cards carry more text and no 16:9 cover,
    // so they use wider cards and a lower column ceiling.
    public pure function notice_columns(width: length) -> int {
        if (width >= 1200px) { return 4; }
        if (width >= 900px) { return 3; }
        if (width >= 620px) { return 2; }
        return 1;
    }

    // ---- frosted panels (GlassPanel) --------------------------------------
    // The pre-blurred backdrop (`src/backdrop.rs::blurred`), shared by every
    // GlassPanel in this window. Rust writes it once per theme, before the
    // first paint; every panel paints this SAME image (a cheap ref-counted
    // clone), never a per-panel copy. An empty image is the pre-Rust state;
    // the tint below still carries the panel, so nothing flashes.
    in-out property <image> glass-blur;
    // The panel tint: `card` at ~61 % (dark) / ~64 % (light) alpha. Low enough
    // that the diffused gradient reads through, high enough that body text
    // keeps >= 7:1 against the darkest/lightest panel area (see the f133
    // report). Panels over the feed use the hover pair as well.
    out property <color> glass-tint: dark ? #1e1e1e9b : #ffffffa3;
    out property <color> glass-tint-hover: dark ? #2a2a2a9b : #e7e7eca3;
    // The player chrome is dark in both themes; its panels use these instead.
    // Lower alpha than the old flat plates so the wallpaper's own colour and
    // grain read through every player overlay (the same job `glass-tint` does
    // in the main window). 54 % / 60 % keeps body ink above 7:1 on the
    // darkest wallpaper area while the plate still reads as a surface.
    // The strip and the popovers share one surface value: on a large panel the
    // lighter `#26262e` base keeps the wallpaper's colour range readable
    // instead of crushing it into a near-uniform slate.
    out property <color> player-panel-tint: #26262e9c;
    out property <color> player-menu-tint: #26262e9c;
}


// ---------------------------------------------------------------------------
// GlassPanel: the ONE frosted surface every panel-like element uses.
//
// Paint order, back to front:
//   1. the shared PRE-BLURRED backdrop (`AppTheme.glass-blur`), `cover`;
//   2. a translucent `card` tint, so text contrast holds;
//   3. the 1px `bar-border` hairline on the same radius;
//   4. the shadow the surface already had (`shadow:` + its three knobs).
//
// Everything above is a static image plus alpha: no capture, no render target,
// no timer, nothing per frame. Because the window behind a panel is itself the
// generated gradient, the blurred copy is what "the panel blurs what is behind
// it" looks like - the blur was computed once, in Rust, at startup.
//
// Children declared on an instance are painted above the three layers, so this
// is a drop-in replacement for a `Rectangle` with `background: AppTheme.card`
// (and it keeps the same `clip` + radius contract).
// ---------------------------------------------------------------------------
component GlassPanel inherits Rectangle {
    // The surface's corner radius (0 = square, e.g. a full-height side strip).
    in property <length> radius: 18px;
    // Paint the WHOLE wallpaper into this surface (`fill`) instead of the
    // centred `cover` crop. A 64px popover covers only a 64px patch of the
    // 1024px tile, which reads as one flat tone; `fill` keeps the same colour
    // range the main window's large panels show, so the player chrome is made
    // of the same wallpaper, not of a separate grey card. Off by default, so
    // every existing panel keeps its exact look.
    in property <bool> fill-image: false;
    // The translucent tint above the blurred image.
    in property <color> tint: AppTheme.glass-tint;
    // The 1px edge. `edge-width: 0px` drops it where a surface had none.
    in property <color> edge: AppTheme.bar-border;
    in property <length> edge-width: 1px;
    // The panel's existing floating shadow, if it had one.
    in property <bool> shadow: false;
    in property <color> shadow-color: #0000002e;
    in property <length> shadow-blur: 16px;
    in property <length> shadow-y: 4px;

    background: #00000000;
    border-radius: root.radius;
    clip: true;
    drop-shadow-color: root.shadow ? root.shadow-color : #00000000;
    drop-shadow-blur: root.shadow ? root.shadow-blur : 0px;
    drop-shadow-offset-y: root.shadow ? root.shadow-y : 0px;

    // 1. the diffused gradient (the shared image, not a copy)
    Image {
        width: 100%;
        height: 100%;
        source: AppTheme.glass-blur;
        image-fit: root.fill-image ? fill : cover;
    }

    // 2. the contrast tint (hover/selection changes ease; static pays nothing)
    Rectangle {
        width: 100%;
        height: 100%;
        background: root.tint;
        animate background { duration: 150ms; easing: ease-out; }
    }

    // 3. the hairline
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        border-width: root.edge-width;
        border-color: root.edge;
        background: #00000000;
    }
}


// ---------------------------------------------------------------------------
// WallpaperLayer: the virtual wallpaper under one window's client area.
//
// Paint order: a flat base tone (only visible if a window is larger than the
// grid), then the same seamless tile repeated on a 5x4 lattice. Every tile
// carries the SAME `source` image (one texture, cheap clones). The lattice is
// offset by `AppTheme.wall-x/y`, which Rust sets to `-(window screen position
// mod tile)`: the wallpaper is pinned to the MONITOR, so dragging the window
// over it is what makes the background move. `clip` keeps the lattice inside
// the window.
//
// Static by construction: no timer, no per-frame work. A move changes two
// lengths; a blur change swaps one image.
// ---------------------------------------------------------------------------
component WallpaperLayer inherits Rectangle {
    in property <image> source;

    background: AppTheme.wall-base;
    clip: true;

    // Rows: 4 x 1024 = 4096 tall, minus one tile of offset = 3072 logical.
    for row in [0, 1, 2, 3] : Rectangle {
        y: AppTheme.wall-y + row * AppTheme.wallpaper-tile;
        width: 100%;
        height: AppTheme.wallpaper-tile;
        background: #00000000;

        // Columns: 5 x 1024 = 5120 wide, minus one tile of offset = 4096.
        for col in [0, 1, 2, 3, 4] : Image {
            x: AppTheme.wall-x + col * AppTheme.wallpaper-tile;
            width: AppTheme.wallpaper-tile;
            height: AppTheme.wallpaper-tile;
            source: root.source;
            // `fill`: the tile is authored at exactly `wallpaper-tile` logical
            // px, so no resampling and no crop.
            image-fit: fill;
        }
    }
}


export struct FeedRow {
    thumb: image,
    // The queue identity of this row: the model-born `queued` flag below is
    // recomputed from it whenever the playlist changes, so a card that has
    // been scrolled out and recycled still comes back with its check.
    bvid: string,
    queued: bool,
    title: string,
    owner: string,
    owner_mid: string,
    meta: string,
    badge: string,
    // Publish time as a Unix timestamp in seconds (0 = unknown) and the exact
    // play count, for the card redesign. `meta` keeps the formatted text.
    pub_ts: int,
    view_count: int,
}

export struct SearchRow {
    thumb: image,
    title: string,
    meta: string,
    sub: string,
    badge: string,
}

// One row of the home bar's 播放列表 panel. `current` marks the row the player
// is on; `playing` only matters for that row and switches its index between the
// animated equalizer and the pause mark.
export struct PlaylistRow {
    title: string,
    owner: string,
    duration: string,
    cover: image,
    current: bool,
    playing: bool,
}

export struct PartRow {
    title: string,
    duration: string,
    selected: bool,
}

export struct RelatedRow {
    title: string,
    meta: string,
}

export struct DanmakuItem {
    x: length,
    y: length,
    w: length,
    text: string,
    color: color,
    size: length,
    bold: bool,
    mid_hash: string,
    // Bilibili's own comment id. Stable across ticks, so the player tick diffs
    // rows by it (update / insert / remove) instead of resetting the model -
    // a `VecModel::set_vec` reset destroys and re-creates every danmaku node.
    dmid: string,
}

export struct DanmakuRow {
    time_text: string,
    text: string,
    time_ms: float,
    dmid: string,
    thumbed: bool,
}

// One toast in the player's stack. `kind` is 0 info, 1 success, 2 error; the
// icon and the progress hairline take their tint from it.
export struct ToastItem {
    text: string,
    kind: int,
}

export struct QualityEntry {
    qn: int,
    label: string,
    vip: bool,
}

// One row of the player's 画质 menu, published by `src/main.rs`.
//
// The player's own `quality_rows` model stays declared (Rust still writes it)
// but is no longer drawn: it only contains streams this account may play, so a
// non-VIP account never sees 4K/1080P60 at all. `quality_menu_rows` is the
// merged list: every stream row from the player catalogue plus one row per
// tier the video advertises but the account cannot play.
//
// `QualityRow` cannot gain the `locked` field: `src/player.rs` constructs it in
// `quality_rows()` and its tests, so widening it would not compile. The merged
// row type therefore lives here as `QualityMenuRow`, and `locked` on it is a
// real flag (never inferred from the badge), so a playable VIP stream carrying
// a `会员` badge can not be mistaken for a tier this account may not play.
//   label   "1080P60"                     - what the tier is called
//   detail  "1920x1080 · 60fps · HEVC · 4.2 Mbps" for a stream,
//           "3840x2160 · 30fps" for a locked tier
//   badge   "" | "HDR" | "杜比" | "8K" | "会员" | "大会员"
//   current true for the stream that is playing now (check mark + selected)
//   locked  true for a 大会员-only tier: dimmed, no hover wash, no pick
//   qn      the tier id, so a locked click can be logged as `quality locked qn=`
// `quality_pick(index)` reports the row index into this model.
export struct QualityRow {
    label: string,
    detail: string,
    badge: string,
    current: bool,
}

export struct QualityMenuRow {
    label: string,
    detail: string,
    badge: string,
    current: bool,
    locked: bool,
    qn: int,
}

// One row of the 音质 section in the 画质 popup. `id` is the DASH audio id
// (0 = 自动（最高）); `detail` carries the REAL measured bandwidth.
export struct AudioQualityRow {
    id: int,
    label: string,
    detail: string,
    current: bool,
    locked: bool,
}

// One 养鱼 verdict row (view_mode 20). The 推荐流 card needs the score, the
// verdict, two reasons and up to four tags without joining them in Rust, so the
// row carries them flat: Slint cannot split a string, and `reason1/2` are also
// what gives the two bullets their own 1-line ellipsis.
export struct FishRow {
    bvid: string,
    title: string,
    up_name: string,
    cover: image,
    score: float,
    score_text: string,
    verdict: string,
    one_line: string,
    reason1: string,
    reason2: string,
    tag1: string,
    tag2: string,
    tag3: string,
    tag4: string,
    // "3 小时前", published by Rust from `at`, so the card never runs a clock.
    age: string,
    // The verdict clock ("12:00 起看"), the footer's "#tag #tag" string and
    // the UP's first glyph for the no-cover block. All formatted in Rust: the
    // card itself never slices strings or reads a clock.
    time_text: string,
    tag_line: string,
    up_glyph: string,
}

// One 食谱 card in the 鱼缸 tab's preset grid. `active` is the backend's exact
// match (`fish::active_preset`): an edited instruction matches nothing.
export struct RecipeRow {
    id: string,
    name: string,
    tagline: string,
    active: bool,
}

export struct AudioEntry {
    index: int,
    label: string,
    vip: bool,
}

// 性能: one prefetch connection, formatted by Rust. `range` reads
// `12.0–16.0 MB` (the byte window this worker claims), `bytes` its running
// total, `busy` whether it is fetching right now (green dot) or waiting.
export struct NetWorker {
    host: string,
    range: string,
    bytes: string,
    busy: bool,
}

export struct FolderItemRow {
