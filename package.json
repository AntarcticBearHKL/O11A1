{
  "name": "o11a1-electron",
  "version": "0.1.4",
  "private": true,
  "description": "O11A1 Electron UI + Rust video engine",
  "author": "O11A1",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env O11A1_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "package": "electron-builder --win --x64"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.o11a1.electron",
    "productName": "O11A1",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/o11a1.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
